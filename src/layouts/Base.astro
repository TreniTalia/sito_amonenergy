---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Analytics from '../components/Analytics.astro';
import { contatti } from '../data/contatti.ts';
// Preload the exact woff2 the `@font-face` unicode-range picks for Italian
// text (the "latin" subset, U+0000-00FF, covers à/è/é/ì/ò/ù): starts the font
// fetch before the parser reaches global.css's @font-face rule, instead of
// only after CSS is parsed.
import archivoLatinWoff from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import interLatinWoff from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page (Service, ...). Organization/LocalBusiness/WebSite/BreadcrumbList sono sempre iniettati. */
  structuredData?: Record<string, unknown>[];
  ogImage?: string;
  /** False for pages with no dark hero at the top (e.g. Contatti), so the header starts solid. */
  headerTransparent?: boolean;
  /** Lingua della pagina. Oggi solo 'it' è servita; l'inglese arriva con il mirror /en/ di una task successiva, che la calcolerà dal path. */
  lang?: 'it' | 'en';
}

const {
  title,
  description,
  structuredData = [],
  ogImage = '/og-image.jpg',
  headerTransparent = true,
  lang = 'it',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Town-center coordinates for Castelluccio dei Sauri (FG) — public geodata, not
// street-level verified. Confirm precision before relying on it for local-search ranking.
const organization = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness', 'ElectricalUtility'],
  name: contatti.ragioneSociale,
  url: Astro.site?.toString(),
  telephone: contatti.telefono,
  email: contatti.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Via Roma 105',
    postalCode: '71025',
    addressLocality: 'Castelluccio dei Sauri',
    addressRegion: 'FG',
    addressCountry: 'IT',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 41.30579,
    longitude: 15.48281,
  },
  areaServed: 'Centro-Sud Italia',
  sameAs: [contatti.linkedin],
  logo: {
    '@type': 'ImageObject',
    url: new URL('/favicon.png', Astro.site).toString(),
  },
  // 2020 è la data di costituzione della persona giuridica. Il 2000 è
  // l'origine dell'esperienza professionale e si racconta solo in prosa:
  // metterlo qui sarebbe un dato falso e verificabile in visura camerale.
  foundingDate: '2020',
  numberOfEmployees: { '@type': 'QuantitativeValue', value: 20 },
};

// Il sito come entità a sé, distinta dall'azienda: è il blocco che lega
// dominio e lingua, e serve ai motori per capire che /en/ è lo stesso sito.
const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Amon Energy',
  url: Astro.site?.toString(),
  inLanguage: lang === 'en' ? 'en-GB' : 'it-IT',
  publisher: { '@type': 'Organization', name: contatti.ragioneSociale },
};

// Briciole calcolate dal path, così nessuna pagina può dimenticarsele: prima
// erano passate a mano da ogni pagina e la home non le aveva affatto.
const segmenti = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    ...segmenti.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: s.replace(/-/g, ' '),
      item: new URL(`/${segmenti.slice(0, i + 1).join('/')}/`, Astro.site).toString(),
    })),
  ],
};

const jsonLdBlocks = [organization, webSite, breadcrumb, ...structuredData];
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={archivoLatinWoff} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatinWoff} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | Amon Energy</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Amon Energy`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — Amon Energy`} />
    <meta property="og:locale" content="it_IT" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Amon Energy`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
      ))
    }
  </head>
  <body>
    <!-- Filtro di rifrazione condiviso da tutti i pulsanti "vetro" del sito
         (.ds-btn-on-dark / .ds-btn-ghost / .ds-btn-secondary / .ds-btn-signal,
         vedi global.css). `feImage` legge una mappa vera, statica, servita da
         `public/img/glass/lens-map.png` — non generata a runtime via canvas:
         un data URI generato via `canvas.toDataURL()` e assegnato dopo il
         primo paint dell'elemento con `backdrop-filter` risulta INVISIBILE
         in Chrome (verificato: stesso filtro, stessa mappa concettuale, zero
         effetto). Un URL statico presente fin dal primo render funziona
         (verificato con un test isolato prima di adottarlo qui). La mappa
         codifica uno spostamento a lente — bordi che spingono verso
         l'esterno, centro quasi piatto — più un filo di rumore ovunque:
         una mappa con grandi zone piatte uniformi è il sospetto principale
         dietro al fallimento del tentativo precedente. -->
    <svg width="0" height="0" style="position: absolute;" aria-hidden="true" focusable="false">
      <filter id="liquid-glass-btn" x="-25%" y="-25%" width="150%" height="150%" color-interpolation-filters="sRGB">
        <feImage href="/img/glass/lens-map.png" x="0" y="0" width="100%" height="100%" preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale="16" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <!-- Stessa mappa, scala più larga: la navbar è molto più grande di un
           pulsante, uno spostamento pensato per un bottone vi si perderebbe. -->
      <filter id="liquid-glass-nav" x="-25%" y="-25%" width="150%" height="150%" color-interpolation-filters="sRGB">
        <feImage href="/img/glass/lens-map.png" x="0" y="0" width="100%" height="100%" preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale="55" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <!-- Scala intermedia: i pannelli (.ds-panel — monitor RCS, box sistemi)
           sono più grandi di un bottone ma più piccoli della navbar. -->
      <filter id="liquid-glass-panel" x="-25%" y="-25%" width="150%" height="150%" color-interpolation-filters="sRGB">
        <feImage href="/img/glass/lens-map.png" x="0" y="0" width="100%" height="100%" preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale="30" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <!-- Pill dell'indicatore di pagina attiva nella navbar: stessa mappa,
           scala più piccola di un bottone perché la pill è sottile. -->
      <filter id="liquid-glass-navpill" x="-25%" y="-25%" width="150%" height="150%" color-interpolation-filters="sRGB">
        <feImage href="/img/glass/lens-map.png" x="0" y="0" width="100%" height="100%" preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale="10" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <a href="#main" class="skip-link">Vai al contenuto</a>
    <Header transparent={headerTransparent} />
    <main id="main" class:list={[{ 'pt-28 lg:pt-32': !headerTransparent }]}>
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <Analytics />

    <script>
      // Scroll reveal — progressive enhancement. Content is visible by default
      // (CSS only hides it when motion is allowed AND js is present); the observer
      // just adds the entrance. Staggered per-container via --reveal-delay.
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

      // Il congedo (`animation-timeline: view()`, in global.css) si risolve
      // sempre contro il *più vicino* antenato scorrevole, e qualunque
      // `overflow: hidden` lo è. Dentro una sezione così la timeline misura uno
      // scroll che non avviene mai: il progress si inchioda a metà e l'elemento
      // resta sfocato per sempre — è quello che succedeva alla fascia RCS/CCI
      // della pagina servizi. Finora la cura era una regola `animation: none`
      // scritta a mano in ogni sezione che tagliava (hero, ControlPillar,
      // CtaBand), e bastava dimenticarne una. Qui l'antenato si cerca una volta
      // sola, a freddo, e chi non ha il documento come contenitore di scroll
      // rinuncia al congedo e tiene il solo ingresso.
      const hasClippingAncestor = (el: HTMLElement) => {
        for (let p = el.parentElement; p && p !== document.body; p = p.parentElement) {
          const { overflowX, overflowY } = getComputedStyle(p);
          if (overflowX !== 'visible' || overflowY !== 'visible') return true;
        }
        return false;
      };
      if (!prefersReduced) {
        els.forEach((el) => {
          if (hasClippingAncestor(el)) el.classList.add('reveal-no-depart');
        });
      }
      const reveal = (el: Element) => el.classList.add('is-visible');
      const revealAll = () => els.forEach(reveal);

      if (prefersReduced || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                reveal(entry.target);
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
        );

        // Anything already in (or near) the viewport is revealed synchronously,
        // so above-the-fold content is never gated on an IntersectionObserver
        // callback that can lag under main-thread load. The rest animate on
        // scroll as usual.
        const vh = window.innerHeight || document.documentElement.clientHeight;
        els.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < vh * 0.96 && r.bottom > 0) {
            reveal(el);
          } else {
            io.observe(el);
          }
        });

        // Belt-and-braces: if anything somehow stays hidden, force it shortly
        // after load so no section ever ships blank.
        window.addEventListener('load', () => window.setTimeout(revealAll, 800), {
          once: true,
        });
      }
    </script>
  </body>
</html>
