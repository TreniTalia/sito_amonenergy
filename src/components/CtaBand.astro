---
import { Image } from 'astro:assets';
// A failed MT joint in an open trench — the literal subject of the default
// headline. Proof over adjectives: this is the thing the phone call is about.
import ctaImg from '../assets/img/photos/guasto-cavo-mt.png';
import { contatti } from '../data/contatti.ts';

interface Props {
  headline?: string;
}

const { headline = 'Un guasto non aspetta. Nemmeno noi.' } = Astro.props;
---

<section class="relative isolate overflow-hidden text-paper cta-band">
  <Image
    src={ctaImg}
    alt="Giunto di un cavo di media tensione bruciato e scoperto in uno scavo, con i conduttori in rame esposti"
    class="cta-bg-img absolute left-0 w-full object-cover"
    data-parallax
    widths={[768, 1100, 1376, 1900]}
    sizes="100vw"
    loading="lazy"
  />
  <!-- 72%, not 85%: the old sunset shot had highlights that punched through a
       heavier scrim, this one is mid-dark and got erased by it. Measured on the
       composited band, the worst pixel behind the headline is 6.2:1 and behind
       the sub-copy 6.8:1 — both clear AA with margin. -->
  <div class="absolute inset-0 bg-navy-950/72"></div>

  <!-- The band is far wider than the photo's 16:9, so object-cover has to crop
       its height. Giving the band real height is what pulls the framing back
       out; without it the cable fills the frame at ~2x. -->
  <div
    class="wrap relative z-10 flex flex-col items-center justify-center gap-8 py-24 text-center lg:min-h-[44rem] lg:py-32"
  >
    <p class="text-display max-w-[18ch]" data-reveal>{headline}</p>
    <p class="max-w-[46ch] text-lg text-paper/80" data-reveal style="--reveal-delay:100ms">
      Parla direttamente con chi mette le mani sugli impianti. Niente form, niente attese: una
      telefonata e siamo operativi.
    </p>
    <div class="flex w-full flex-col gap-3.5 sm:w-auto sm:flex-row sm:gap-5" data-reveal style="--reveal-delay:200ms">
      <a href={contatti.telefonoHref} class="ds-btn-on-dark justify-center">
        Chiamaci: {contatti.telefono}
      </a>
      <a
        href={`mailto:${contatti.email}?subject=Richiesta%20informazioni`}
        class="ds-btn-ghost justify-center"
      >
        Scrivici via email
      </a>
    </div>
  </div>
</section>

<style>
  /* La foto statica prima non lasciava vedere la rifrazione vera dei pulsanti
     (backdrop-filter su uno sfondo fermo non "respira" mai) — stessa
     parallasse di ControlPillar: più margine verticale del necessario, così
     il traslare in scroll non scopre mai un bordo vuoto. */
  .cta-bg-img {
    top: -18%;
    height: 136%;
    max-width: none;
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-bg-img {
      transform: translate3d(0, 0, 0) !important;
    }
  }
</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.querySelector<HTMLElement>('.cta-band');
  const layer = section?.querySelector<HTMLElement>('[data-parallax]');

  if (section && layer && !prefersReduced) {
    let inView = false;
    let ticking = false;
    const depth = 0.3;

    const apply = () => {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      const progress = (vh - rect.top) / (vh + rect.height);
      const offset = (progress - 0.5) * rect.height * depth;
      layer.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
    };

    const onScroll = () => {
      if (!inView || ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    };

    const io = new IntersectionObserver(
      (entries) => {
        inView = entries[0]?.isIntersecting ?? false;
        if (inView) onScroll();
      },
      { rootMargin: '20% 0px' },
    );
    io.observe(section);
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
