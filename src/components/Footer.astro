---
import { contatti } from '../data/contatti.ts';
import { gemella } from '../i18n/routes.ts';
import { t } from '../i18n/ui.ts';
import Logo from './Logo.astro';
import PackIcon from './PackIcon.astro';

const { lingua } = gemella(Astro.url.pathname);
const ui = t(lingua);

const quickLinks =
  lingua === 'en'
    ? [
        { href: '/en/company/', label: ui.nav.azienda },
        { href: '/en/services/', label: ui.nav.servizi },
        { href: '/en/projects/', label: ui.nav.lavori },
        { href: '/en/contacts/', label: ui.nav.contatti },
      ]
    : [
        { href: '/azienda/', label: ui.nav.azienda },
        { href: '/servizi/', label: ui.nav.servizi },
        { href: '/lavori/', label: ui.nav.lavori },
        { href: '/contatti/', label: ui.nav.contatti },
      ];

const privacyHref = lingua === 'en' ? '/en/privacy-policy/' : '/privacy-policy/';

const year = new Date().getFullYear();
---

<footer class="bg-navy-950 text-paper">
  <div class="wrap-wide py-16 lg:py-24 grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <Logo size={32} />
      <p class="text-small measure mt-4 text-paper/85">{ui.footer.claim}</p>
      <a
        href={contatti.linkedin}
        class="text-small inline-flex items-center gap-2.5 mt-6 text-paper/90 hover:text-signal-400 transition-colors"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="grid h-9 w-9 place-items-center rounded-[var(--radius-sm)] border border-white/20 bg-white/10">
          <PackIcon name="linkedin" class="text-base" />
        </span>
        LinkedIn
      </a>
    </div>

    <div>
      <p class="ds-eyebrow-label" style="color: var(--color-paper); opacity: 0.75;">{ui.footer.naviga}</p>
      <ul class="text-small mt-4 flex flex-col gap-3">
        {quickLinks.map((s) => (
          <li><a href={s.href} class="text-paper/90 hover:text-signal-400 transition-colors">{s.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="ds-eyebrow-label" style="color: var(--color-paper); opacity: 0.75;">{ui.footer.contatti}</p>
      <ul class="text-small mt-4 flex flex-col gap-3 text-paper/90">
        <!-- Il NAP resta in italiano: solo ", Italy" in coda per il lettore
             internazionale, mai una traduzione dell'indirizzo. -->
        <li>{contatti.indirizzo}{lingua === 'en' && ', Italy'}</li>
        <li><a href={contatti.telefonoHref} class="hover:text-signal-400 transition-colors">{contatti.telefono}</a></li>
        <li><a href={`mailto:${contatti.email}`} class="hover:text-signal-400 transition-colors">{contatti.email}</a></li>
        <li><a href={`mailto:${contatti.pec}`} class="hover:text-signal-400 transition-colors">{contatti.pec}</a></li>
        <li>{lingua === 'en' ? 'VAT no.' : 'P.IVA'} {contatti.piva}</li>
        <li>{lingua === 'en' ? 'E-invoicing code' : 'Codice FE'} {contatti.codiceFE}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-navy-700">
    <div class="text-small wrap-wide pt-6 pb-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-paper/75">
      <p>© {year} {contatti.ragioneSociale}</p>
      <!-- Su telefono le tre voci non stanno su una riga: a 360px "Preferenze
           cookie" e la partita IVA finivano una addosso all'altra. `flex-wrap`
           le lascia andare a capo per conto loro, senza un breakpoint che
           decida al posto del contenuto. -->
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2.5 text-center">
        <a href={privacyHref} class="hover:text-signal-400 transition-colors">{ui.footer.privacyPolicy}</a>
        <button type="button" id="footer-cookie-preferences" class="border-0 bg-transparent p-0 cursor-pointer hover:text-signal-400 transition-colors">{ui.footer.preferenzeCookie}</button>
        <span>{lingua === 'en' ? 'VAT no.' : 'P.IVA'} {contatti.piva}</span>
      </div>
    </div>
  </div>
</footer>

<script>
  // Riapre il banner cookie per cambiare scelta — il consenso deve essere
  // revocabile con la stessa facilità con cui è dato. CookieConsent.astro
  // ascolta questo evento a prescindere dalla scelta già salvata.
  document.getElementById('footer-cookie-preferences')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('amon-open-consent'));
  });
</script>
