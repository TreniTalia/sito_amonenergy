---
import { contatti } from '../data/contatti.ts';
import Logo from './Logo.astro';
import PackIcon from './PackIcon.astro';

const quickLinks = [
  { href: '/servizi/', label: 'Servizi' },
  { href: '/lavori/', label: 'Lavori' },
  { href: '/contatti/', label: 'Contatti' },
];

const year = new Date().getFullYear();
---

<footer class="bg-navy-950 text-paper">
  <div class="wrap-wide py-16 lg:py-24 grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <Logo size={32} />
      <p class="mt-4 text-paper/85 measure">Professionisti dell'energia.</p>
      <a
        href={contatti.linkedin}
        class="inline-flex items-center gap-2.5 mt-6 text-sm text-paper/90 hover:text-signal-400 transition-colors"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="grid h-9 w-9 place-items-center rounded-[var(--radius-sm)] border border-white/20 bg-white/10">
          <PackIcon name="linkedin" class="text-base" />
        </span>
        LinkedIn
      </a>
    </div>

    <div>
      <p class="ds-eyebrow-label" style="color: var(--color-paper); opacity: 0.75;">Naviga</p>
      <ul class="mt-4 flex flex-col gap-3">
        {quickLinks.map((s) => (
          <li><a href={s.href} class="text-paper/90 hover:text-signal-400 transition-colors">{s.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="ds-eyebrow-label" style="color: var(--color-paper); opacity: 0.75;">Contatti</p>
      <ul class="mt-4 flex flex-col gap-3 text-paper/90">
        <li>{contatti.indirizzo}</li>
        <li><a href={contatti.telefonoHref} class="hover:text-signal-400 transition-colors">{contatti.telefono}</a></li>
        <li><a href={`mailto:${contatti.email}`} class="hover:text-signal-400 transition-colors">{contatti.email}</a></li>
        <li><a href={`mailto:${contatti.pec}`} class="hover:text-signal-400 transition-colors">{contatti.pec}</a></li>
        <li>P.IVA {contatti.piva}</li>
        <li>Codice FE {contatti.codiceFE}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-navy-700">
    <div class="wrap-wide pt-6 pb-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-paper/75">
      <p>© {year} {contatti.ragioneSociale}</p>
      <div class="flex items-center gap-6">
        <a href="/privacy-policy/" class="hover:text-signal-400 transition-colors">Privacy Policy</a>
        <button type="button" id="footer-cookie-preferences" class="border-0 bg-transparent p-0 cursor-pointer hover:text-signal-400 transition-colors">Preferenze cookie</button>
        <span>P.IVA {contatti.piva}</span>
      </div>
    </div>
  </div>
</footer>

<script>
  // Riapre il banner cookie per cambiare scelta — il consenso deve essere
  // revocabile con la stessa facilità con cui è dato. CookieConsent.astro
  // ascolta questo evento a prescindere dalla scelta già salvata.
  document.getElementById('footer-cookie-preferences')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('amon-open-consent'));
  });
</script>
