---
import HeroTwin from './HeroTwin.astro';

interface Props {
  eyebrow: string;
  h1: string;
  sub: string;
  ctaPrimaria: string;
  ctaPrimariaHref: string;
  ctaSecondaria: string;
  ctaSecondariaHref: string;
}

const { eyebrow, h1, sub, ctaPrimaria, ctaPrimariaHref, ctaSecondaria, ctaSecondariaHref } = Astro.props;

const facts = ['Sistemi di monitoraggio', 'Automazioni', 'Reperibilità 24/7'];
---

<!-- Full-viewport by design: l'arco deve chiudere esattamente sulla piega, così
     lo stacco con la fascia bianca non entra mai nel primo schermo. `svh` e non
     `dvh`: con dvh l'altezza cambia mentre la barra del browser mobile si
     ritrae e l'arco slitterebbe durante lo scroll. -->
<section class="hero relative isolate flex min-h-svh flex-col justify-end overflow-hidden text-paper">
  <!-- Il fondale è solo il digital twin: il vecchio fermo-immagine del pattern
       di circuito è stato tolto del tutto. Finché era lì si affacciava in ogni
       momento in cui il canvas non stava dipingendo — il primo frame prima del
       fade-in, un contesto WebGL perso, `prefers-reduced-motion` — e vedere
       comparire un fondale diverso da quello della scena era peggio che non
       vedere nulla. Sotto ci sta il navy pieno della sezione, che è anche il
       colore con cui il canvas pulisce: nessuno stacco in nessun frame. -->
  <HeroTwin />

  <div class="hero-scrim absolute inset-0"></div>

  <!-- Su mobile il blocco è centrato nell'altezza libera dell'hero: con l'hero a
       tutta altezza, ancorarlo in basso lo faceva leggere come una didascalia
       appoggiata sul fondo. Da `sm` in su resta ancorato in basso, dove la
       colonna di testo lunga vuole stare. I padding di .hero-col sono franchi di
       sicurezza, non spaziatura di layout: entrano in gioco solo quando lo
       spazio libero finisce e il blocco smette di stare centrato. -->
  <div class="hero-depart relative z-10 flex flex-1 flex-col justify-center sm:flex-none sm:justify-end">
    <div class="hero-col wrap-wide">
      <div class="max-w-xl md:max-w-2xl lg:max-w-3xl xl:max-w-4xl 2xl:max-w-5xl">
        <div class="ds-eyebrow" data-reveal style="--reveal-delay:80ms">
          <span class="ds-live-dot" aria-hidden="true"></span>
          <span class="ds-eyebrow-label" style="color: var(--color-green-400)">{eyebrow}</span>
        </div>

        <h1 class="text-hero" data-reveal style="--reveal-delay:160ms">{h1}</h1>

        <p class="measure mt-6 text-lg text-paper/85 lg:text-xl" data-reveal style="--reveal-delay:260ms">
          {sub}
        </p>

        <div class="mt-9 flex flex-col gap-3.5 sm:flex-row sm:gap-5" data-reveal style="--reveal-delay:360ms">
          <a href={ctaPrimariaHref} class="ds-btn-on-dark justify-center">{ctaPrimaria}</a>
          <a href={ctaSecondariaHref} class="ds-btn-ghost justify-center">{ctaSecondaria}</a>
        </div>

        <!-- I punti non separano più le voci, le marcano: uno vivo per fatto,
             sfasato di 800ms dal precedente. È la scala ridotta del punto
             dell'occhiello — deve dire "acceso", non rifare l'occhiello. -->
        <ul class="mt-11 hidden flex-wrap items-center gap-x-7 gap-y-3 sm:flex" data-reveal style="--reveal-delay:460ms">
          {
            facts.map((f, i) => (
              <li class="flex items-center gap-2.5 text-[0.9375rem] font-semibold tracking-wide text-paper/90">
                <span class="ds-live-dot ds-live-dot--sm" aria-hidden="true" style={`--live-delay:${i * 800}ms`} />
                {f}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Il padding superiore dell'hero è due cose insieme, e prima ne teneva conto
     una sola: la spaziatura voluta a quel breakpoint, e il franco contro
     l'isola *fissa* dell'header, che non sta nel flusso e quindi non spinge
     nulla. Sotto `sm` il valore voluto era `pt-16`, 64px, contro un'isola da
     78px: appena la colonna di testo si allungava, l'occhiello finiva dietro al
     vetro. `max()` prende sempre il maggiore dei due, così nessuna larghezza può
     più passare sotto l'header — in landscape corto l'isola arriva a ~104px, a
     ridosso dei 128px di `sm`, e lì il vecchio numero fisso stava per cedere.
     Sotto `sm` il blocco è centrato fra header e fondo, quindi il valore voluto
     è zero: comanda il franco. Il franco inferiore vale 3.5rem invece dei 2.5
     di prima: sono il piede ottico del blocco su mobile. */
  .hero-col {
    --hero-pt: 0rem;
    --hero-pb: 3.5rem;
    padding-top: max(var(--hero-pt), calc(var(--header-h, 4.875rem) + 1.25rem));
    padding-bottom: var(--hero-pb);
  }
  @media (min-width: 640px) {
    .hero-col {
      --hero-pt: 8rem;
    }
  }
  @media (min-width: 1024px) {
    .hero-col {
      --hero-pt: 10rem;
      --hero-pb: 5rem;
    }
  }

  /* Il fondo pieno della sezione: è ciò che si vede prima che il canvas
     dipinga il primo frame, ed è lo stesso navy con cui il canvas pulisce. */
  .hero {
    background-color: var(--color-navy-950);
  }

  .hero-scrim {
    background:
      /* Il velo verticale era a 92% sul fondo: sufficiente per il testo, ma
         cancellava del tutto la piana di blocchi del digital twin, che vive
         proprio nella metà bassa. Ora scende a 74% e il contrasto per la
         colonna di testo lo recupera il velo orizzontale qui sotto, che è
         acceso solo dov'è il testo e lascia libera la metà destra. */
      linear-gradient(
        to top,
        color-mix(in srgb, var(--color-navy-950) 74%, transparent) 0%,
        color-mix(in srgb, var(--color-navy-950) 48%, transparent) 20%,
        color-mix(in srgb, var(--color-navy-950) 20%, transparent) 52%,
        color-mix(in srgb, var(--color-navy-950) 12%, transparent) 100%
      ),
      linear-gradient(
        to right,
        color-mix(in srgb, var(--color-navy-950) 84%, transparent) 0%,
        color-mix(in srgb, var(--color-navy-950) 40%, transparent) 45%,
        transparent 72%
      ),
      /* Flat veil that takes the whole photo down a notch. A uniform layer here
         rather than `filter: brightness()` on the image: a filter would promote
         the LCP element to its own layer, and this hero has already proved
         fragile about compositing. */
      linear-gradient(
        color-mix(in srgb, var(--color-navy-950) 12%, transparent) 0%,
        color-mix(in srgb, var(--color-navy-950) 12%, transparent) 100%
      );
  }

  /* Sotto i 768px la colonna di testo prende tutta la larghezza, e il velo
     orizzontale — che esiste per proteggere la colonna sinistra del desktop —
     finisce per scurire l'intera scena invece della sola zona del testo: i due
     veli sovrapposti arrivavano a coprire il fondale di circa tre quarti. Qui
     resta il solo velo verticale, un po' più pieno per reggere da solo il
     contrasto, e il digital twin torna a leggersi. */
  @media (max-width: 767px) {
    .hero-scrim {
      background: linear-gradient(
        to top,
        color-mix(in srgb, var(--color-navy-950) 78%, transparent) 0%,
        color-mix(in srgb, var(--color-navy-950) 62%, transparent) 30%,
        color-mix(in srgb, var(--color-navy-950) 44%, transparent) 62%,
        color-mix(in srgb, var(--color-navy-950) 18%, transparent) 100%
      );
    }
  }

  /* Congedo dell'hero. Non un parallasse decorativo: le due parti si separano
     a velocità diverse mentre l'hero esce, il testo più svelto del fondale, e
     da quella differenza nasce la profondità. È agganciato allo scroll della
     pagina e non a un timer, quindi segue il dito e torna indietro se si
     risale. `scroll(root)` invece di `view()` perché l'hero sta in cima: lo
     scorrimento della pagina *è* la sua uscita, e l'intervallo si scrive
     diretto in altezze di viewport.

     Il canvas si muove meno e non viene scalato: ingrandire un canvas WebGL
     lo ricampiona e si vede. Traslandolo resta scoperta una fascia in fondo
     all'hero, ma è dello stesso navy del fondo della sezione, quindi non si
     legge. Niente animazione sulla sua opacità: lì comanda già la transizione
     di `.is-ready`, e le due si pesterebbero. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero-depart {
        animation: hero-depart linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 82svh;
      }
      .hero :global(.hero-twin) {
        animation: hero-backdrop-depart linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 82svh;
      }
      /* I figli non si congedano per conto proprio: qui se ne occupa il blocco
         intero, e sommare le due dissolvenze le raddoppiava. */
      .hero-depart :global([data-reveal]) {
        animation: none;
      }
    }
  }

  @keyframes hero-depart {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: translateY(-11%);
    }
  }

  @keyframes hero-backdrop-depart {
    from {
      transform: none;
    }
    to {
      transform: translateY(-3.5%);
    }
  }

  /* Lo zoom lento che c'era sulla foto è caduto con la foto: il movimento ora
     lo dà il digital twin, e sommare le due cose renderebbe il fondale
     inquieto. */
</style>
