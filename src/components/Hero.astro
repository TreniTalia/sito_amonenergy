---
import { Picture } from 'astro:assets';
import heroPoster from '../assets/img/photos/hero-pattern-circuito.png';
import HeroTwin from './HeroTwin.astro';

interface Props {
  eyebrow: string;
  h1: string;
  sub: string;
  ctaPrimaria: string;
  ctaPrimariaHref: string;
  ctaSecondaria: string;
  ctaSecondariaHref: string;
}

const { eyebrow, h1, sub, ctaPrimaria, ctaPrimariaHref, ctaSecondaria, ctaSecondariaHref } = Astro.props;

const facts = ['Sistemi di monitoraggio', 'Automazioni', 'Reperibilità 24/7'];
---

<!-- Full-viewport by design: l'arco deve chiudere esattamente sulla piega, così
     lo stacco con la fascia bianca non entra mai nel primo schermo. `svh` e non
     `dvh`: con dvh l'altezza cambia mentre la barra del browser mobile si
     ritrae e l'arco slitterebbe durante lo scroll. -->
<section class="hero relative isolate flex min-h-svh flex-col justify-end overflow-hidden text-paper">
  <!-- Il fondale è il pattern di circuito, gradato sui colori del marchio: la
       traccia viva è portata sulla tinta di `signal-400` e il nero resta un
       nero-navy, così la fascia non introduce un blu estraneo alla rampa.
       Il primo strato è il fermo-immagine del video, non un ripiego: è lui che
       dipinge (ed è l'elemento LCP), il video gli si sovrappone quando parte.
       `display: contents` impedisce a <picture> di aggiungere un elemento flex
       fantasma alla colonna dell'hero. -->
  <Picture
    src={heroPoster}
    alt=""
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    quality={82}
    class="hero-media absolute inset-0 h-full w-full object-cover"
    pictureAttributes={{ class: 'contents' }}
    widths={[768, 1280, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Digital twin del campo eolico al posto del vecchio pattern-video di
       circuito: stesso ruolo (fondale animato sotto lo scrim), stessa cintura
       di sicurezza sotto i 768px e con `prefers-reduced-motion` — vedi
       HeroTwin.astro. -->
  <HeroTwin />

  <div class="hero-scrim absolute inset-0"></div>

  <!-- Su mobile il blocco è centrato nell'altezza libera dell'hero: con l'hero a
       tutta altezza, ancorarlo in basso lo faceva leggere come una didascalia
       appoggiata sul fondo. Da `sm` in su resta ancorato in basso, dove la
       colonna di testo lunga vuole stare. I padding di .hero-col sono franchi di
       sicurezza, non spaziatura di layout: entrano in gioco solo quando lo
       spazio libero finisce e il blocco smette di stare centrato. -->
  <div class="relative z-10 flex flex-1 flex-col justify-center sm:flex-none sm:justify-end">
    <div class="hero-col wrap-wide">
      <div class="max-w-xl md:max-w-2xl lg:max-w-3xl xl:max-w-4xl 2xl:max-w-5xl">
        <div class="ds-eyebrow" data-reveal style="--reveal-delay:80ms">
          <span class="ds-live-dot" aria-hidden="true"></span>
          <span class="ds-eyebrow-label" style="color: var(--color-green-400)">{eyebrow}</span>
        </div>

        <h1 class="text-hero" data-reveal style="--reveal-delay:160ms">{h1}</h1>

        <p class="measure mt-6 text-lg text-paper/85 lg:text-xl" data-reveal style="--reveal-delay:260ms">
          {sub}
        </p>

        <div class="mt-9 flex flex-col gap-3.5 sm:flex-row sm:gap-5" data-reveal style="--reveal-delay:360ms">
          <a href={ctaPrimariaHref} class="ds-btn-on-dark justify-center">{ctaPrimaria}</a>
          <a href={ctaSecondariaHref} class="ds-btn-ghost justify-center">{ctaSecondaria}</a>
        </div>

        <!-- I punti non separano più le voci, le marcano: uno vivo per fatto,
             sfasato di 800ms dal precedente. È la scala ridotta del punto
             dell'occhiello — deve dire "acceso", non rifare l'occhiello. -->
        <ul class="mt-11 hidden flex-wrap items-center gap-x-7 gap-y-3 sm:flex" data-reveal style="--reveal-delay:460ms">
          {
            facts.map((f, i) => (
              <li class="flex items-center gap-2.5 text-[0.9375rem] font-semibold tracking-wide text-paper/90">
                <span class="ds-live-dot ds-live-dot--sm" aria-hidden="true" style={`--live-delay:${i * 800}ms`} />
                {f}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Il padding superiore dell'hero è due cose insieme, e prima ne teneva conto
     una sola: la spaziatura voluta a quel breakpoint, e il franco contro
     l'isola *fissa* dell'header, che non sta nel flusso e quindi non spinge
     nulla. Sotto `sm` il valore voluto era `pt-16`, 64px, contro un'isola da
     78px: appena la colonna di testo si allungava, l'occhiello finiva dietro al
     vetro. `max()` prende sempre il maggiore dei due, così nessuna larghezza può
     più passare sotto l'header — in landscape corto l'isola arriva a ~104px, a
     ridosso dei 128px di `sm`, e lì il vecchio numero fisso stava per cedere.
     Sotto `sm` il blocco è centrato fra header e fondo, quindi il valore voluto
     è zero: comanda il franco. Il franco inferiore vale 3.5rem invece dei 2.5
     di prima: sono il piede ottico del blocco su mobile. */
  .hero-col {
    --hero-pt: 0rem;
    --hero-pb: 3.5rem;
    padding-top: max(var(--hero-pt), calc(var(--header-h, 4.875rem) + 1.25rem));
    padding-bottom: var(--hero-pb);
  }
  @media (min-width: 640px) {
    .hero-col {
      --hero-pt: 8rem;
    }
  }
  @media (min-width: 1024px) {
    .hero-col {
      --hero-pt: 10rem;
      --hero-pb: 5rem;
    }
  }

  .hero-scrim {
    background:
      linear-gradient(
        to top,
        color-mix(in srgb, var(--color-navy-950) 92%, transparent) 0%,
        color-mix(in srgb, var(--color-navy-950) 62%, transparent) 20%,
        color-mix(in srgb, var(--color-navy-950) 24%, transparent) 52%,
        color-mix(in srgb, var(--color-navy-950) 14%, transparent) 100%
      ),
      linear-gradient(
        to right,
        color-mix(in srgb, var(--color-navy-950) 74%, transparent) 0%,
        color-mix(in srgb, var(--color-navy-950) 30%, transparent) 45%,
        transparent 72%
      ),
      /* Flat veil that takes the whole photo down a notch. A uniform layer here
         rather than `filter: brightness()` on the image: a filter would promote
         the LCP element to its own layer, and this hero has already proved
         fragile about compositing. */
      linear-gradient(
        color-mix(in srgb, var(--color-navy-950) 12%, transparent) 0%,
        color-mix(in srgb, var(--color-navy-950) 12%, transparent) 100%
      );
  }

  /* Lo zoom lento che c'era sulla foto è caduto con la foto: il movimento ora
     lo dà il digital twin, e sommare le due cose renderebbe il fondale
     inquieto. */
</style>
