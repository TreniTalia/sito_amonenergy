---
/**
 * Mappa vettoriale del raggio d'azione: Centro-Sud Italia con la sede di
 * Castelluccio dei Sauri (FG). Stessa grafica della mappa in /contatti,
 * ma disegnata dalle coordinate reali — nessuna immagine, nessun iframe.
 */
type LL = [number, number];

const LAT_MID = 40.3;
const K = Math.cos((LAT_MID * Math.PI) / 180);
const KM_PER_DEG = 111.32;

// Proiezione equirettangolare centrata sulla latitudine media: isotropa,
// quindi i cerchi di raggio in km restano cerchi.
const project = ([lon, lat]: LL): [number, number] => [lon * K, -lat];

// Coste semplificate (lon, lat), senso orario.
// Il bordo superiore (lat 44.1) è un taglio, non una costa: viene sfumato.
const LAT_CUT = 44.1;

// Coordinate reali (Natural Earth 1:50m, confine IT), non più stimate a
// occhio: la vecchia lista aveva ~25-40 punti per forma e arrotondava via
// Gargano, golfo di Taranto e tacco del Salento in una sagoma "a fagiolo".
// Estratte da ITA.geojson (poligono principale, arco a sud del taglio) e
// semplificate con Douglas-Peucker (epsilon 0.018°) per restare leggere.
const peninsola: LL[] = [
  [12.396, 44.224], [12.691, 43.995], [12.907, 43.921], [13.295, 43.686], [13.564, 43.571],
  [13.805, 43.18], [14.01, 42.69], [14.183, 42.506], [14.541, 42.244], [14.866, 42.053],
  [15.169, 41.934], [15.405, 41.913], [15.964, 41.939], [16.165, 41.896], [16.189, 41.814],
  [16.151, 41.758], [15.914, 41.621], [15.9, 41.512], [16.013, 41.435], [16.552, 41.232],
  [17.103, 41.062], [17.474, 40.841], [17.955, 40.655], [18.036, 40.565], [18.328, 40.371],
  [18.461, 40.221], [18.486, 40.105], [18.344, 39.821], [18.219, 39.853], [18.078, 39.937],
  [17.865, 40.28], [17.396, 40.34], [17.258, 40.399], [17.215, 40.486], [17.18, 40.503],
  [17.031, 40.513], [16.928, 40.458], [16.67, 40.137], [16.53, 39.86], [16.522, 39.748],
  [16.598, 39.639], [16.824, 39.578], [16.999, 39.482], [17.115, 39.381], [17.123, 39.137],
  [17.175, 38.998], [17.099, 38.919], [16.951, 38.94], [16.755, 38.89], [16.617, 38.8],
  [16.559, 38.715], [16.574, 38.494], [16.546, 38.409], [16.282, 38.25], [16.057, 37.942],
  [15.725, 37.939], [15.646, 38.034], [15.643, 38.175], [15.7, 38.262], [15.822, 38.303],
  [15.905, 38.483], [15.879, 38.614], [15.972, 38.713], [16.197, 38.759], [16.21, 38.941],
  [16.107, 39.024], [16.024, 39.354], [15.854, 39.627], [15.693, 39.99], [15.585, 40.053],
  [15.295, 40.07], [14.951, 40.239], [14.929, 40.31], [14.986, 40.377], [14.948, 40.469],
  [14.84, 40.63], [14.766, 40.668], [14.34, 40.599], [14.461, 40.729], [14.309, 40.813],
  [14.102, 40.827], [14.076, 40.794], [14.044, 40.812], [14.048, 40.87], [13.86, 41.13],
  [13.733, 41.236], [13.67, 41.254], [13.555, 41.232], [13.247, 41.289], [13.089, 41.244],
  [12.849, 41.409], [12.631, 41.47], [12.075, 41.941], [11.807, 42.082], [11.637, 42.288],
  [11.498, 42.363], [11.296, 42.423], [11.141, 42.39], [11.103, 42.417], [11.185, 42.457],
  [11.168, 42.535], [10.938, 42.739], [10.803, 42.804], [10.708, 42.936], [10.515, 42.968],
  [10.521, 43.204], [10.448, 43.371], [10.321, 43.513], [10.246, 43.852], [10.188, 43.948],
  [10.048, 44.02], [9.731, 44.101],
];

const sicilia: LL[] = [
  [15.577, 38.22], [15.234, 37.785], [15.1, 37.459], [15.117, 37.335], [15.23, 37.244],
  [15.174, 37.209], [15.289, 37.097], [15.296, 37.055], [15.295, 37.013], [15.185, 36.935],
  [15.116, 36.839], [15.113, 36.688], [14.89, 36.724], [14.776, 36.71], [14.502, 36.799],
  [14.367, 36.973], [14.259, 37.046], [14.143, 37.104], [13.905, 37.101], [13.801, 37.136],
  [13.361, 37.349], [13.17, 37.479], [13.04, 37.507], [12.924, 37.571], [12.64, 37.594],
  [12.527, 37.67], [12.436, 37.82], [12.548, 38.053], [12.664, 38.108], [12.734, 38.183],
  [12.903, 38.035], [13.049, 38.084], [13.057, 38.131], [13.16, 38.19], [13.291, 38.191],
  [13.682, 38.001], [13.789, 37.981], [14.05, 38.041], [14.288, 38.017], [14.506, 38.046],
  [14.79, 38.167], [15.119, 38.153], [15.224, 38.211], [15.341, 38.217], [15.499, 38.291],
  [15.635, 38.268],
];

const sardegna: LL[] = [
  [9.632, 40.882], [9.682, 40.818], [9.805, 40.5], [9.643, 40.268], [9.707, 40.017],
  [9.617, 39.354], [9.562, 39.166], [9.486, 39.14], [9.264, 39.217], [9.149, 39.197],
  [9.056, 39.239], [9.023, 39.043], [8.967, 38.964], [8.881, 38.913], [8.649, 38.927],
  [8.418, 39.206], [8.399, 39.482], [8.447, 39.563], [8.451, 39.722], [8.471, 39.748],
  [8.541, 39.732], [8.548, 39.839], [8.496, 39.897], [8.408, 39.917], [8.409, 40.038],
  [8.471, 40.131], [8.471, 40.293], [8.409, 40.352], [8.353, 40.501], [8.19, 40.652],
  [8.181, 40.771], [8.224, 40.913], [8.363, 40.846], [8.572, 40.85], [8.821, 40.95],
  [8.998, 41.11], [9.107, 41.143], [9.163, 41.185], [9.182, 41.242], [9.228, 41.257],
  [9.283, 41.202], [9.455, 41.15], [9.539, 41.054], [9.615, 41.017], [9.554, 40.932],
];

const forme = [peninsola, sicilia, sardegna];

// --- viewBox ------------------------------------------------------------
// La geometria viene inscritta in una tela 4:3 (stesso rapporto della card),
// così nulla viene tagliato e non serve `slice`.
const RATIO = 4 / 3;
const PAD = 0.45; // gradi
const pts = forme.flat().map(project);
const gx0 = Math.min(...pts.map((p) => p[0])) - PAD * K;
const gx1 = Math.max(...pts.map((p) => p[0])) + PAD * K;
const gy0 = Math.min(...pts.map((p) => p[1])) - PAD;
const gy1 = Math.max(...pts.map((p) => p[1])) + PAD;

// Estende l'asse più corto fino a raggiungere il rapporto voluto.
const gw = gx1 - gx0;
const gh = gy1 - gy0;
const vw = Math.max(gw, gh * RATIO);
const vh = vw / RATIO;
const minX = gx0 - (vw - gw) / 2;
const minY = gy0 - (vh - gh) / 2;

const W = 1000;
const SCALE = W / vw;
const H = Math.round(vh * SCALE);

const xy = (p: LL): [number, number] => {
  const [px, py] = project(p);
  return [(px - minX) * SCALE, (py - minY) * SCALE];
};
const km = (v: number) => (v / KM_PER_DEG) * SCALE;
const n = (v: number) => Math.round(v * 10) / 10;

/** Catmull-Rom → Bézier. Tensione bassa: a 0.28 le coste si gonfiavano fra un
 * vertice e l'altro e il profilo leggeva come un disegno a mano invece che come
 * un rilievo. */
const TENSION = 0.16;
function smoothClosed(coords: LL[]): string {
  const p = coords.map(xy);
  const len = p.length;
  const at = (i: number) => p[((i % len) + len) % len];
  let d = `M${n(p[0][0])} ${n(p[0][1])}`;
  for (let i = 0; i < len; i++) {
    const p0 = at(i - 1);
    const p1 = at(i);
    const p2 = at(i + 1);
    const p3 = at(i + 2);
    const c1 = [p1[0] + (p2[0] - p0[0]) * TENSION, p1[1] + (p2[1] - p0[1]) * TENSION];
    const c2 = [p2[0] - (p3[0] - p1[0]) * TENSION, p2[1] - (p3[1] - p1[1]) * TENSION];
    d += `C${n(c1[0])} ${n(c1[1])},${n(c2[0])} ${n(c2[1])},${n(p2[0])} ${n(p2[1])}`;
  }
  return `${d}Z`;
}

// --- punti notevoli -----------------------------------------------------
const sede: LL = [15.505, 41.297];
const [sx, sy] = xy(sede);

const citta: { nome: string; ll: LL; dx?: number; dy?: number; anchor?: 'start' | 'end' }[] = [
  { nome: 'Roma', ll: [12.5, 41.9], dx: -10, dy: -8, anchor: 'end' },
  { nome: 'Napoli', ll: [14.27, 40.85], dx: -10, dy: 14, anchor: 'end' },
  { nome: 'Bari', ll: [16.87, 41.12], dx: 11, dy: 5 },
  { nome: 'Pescara', ll: [14.22, 42.47], dx: -10, dy: -8, anchor: 'end' },
  { nome: 'Taranto', ll: [17.23, 40.47], dx: 11, dy: 5 },
  { nome: 'Cosenza', ll: [16.25, 39.3], dx: 11, dy: 4 },
];

// Ogni quota corre sulla propria radiale, scelta per cadere su mare libero: a
// 150 e 300 km il settore di nord-est è vuoto, a 450 no — l'anello esce dal
// riquadro da quel lato, e l'etichetta finiva fuori tela. Quella scende a
// sud-ovest, nel Tirreno.
const anelli = [
  { km: 150, deg: -52 },
  { km: 300, deg: -52 },
  { km: 450, deg: 143 },
];

const radial = (kmDist: number, deg: number): [number, number] => [
  sx + Math.cos((deg * Math.PI) / 180) * km(kmDist),
  sy + Math.sin((deg * Math.PI) / 180) * km(kmDist),
];

// Sfumatura sul taglio settentrionale: il bordo dritto non deve leggersi come costa.
const yCut = xy([0, LAT_CUT])[1];
const yFade = yCut + km(190);

// Graticola
const lonLines: number[] = [];
for (let l = 8; l <= 19; l += 2) lonLines.push(l);
const latLines: number[] = [];
for (let l = 36; l <= 44; l += 2) latLines.push(l);

const uid = 'cvg';
---

<figure class="coverage-map">
  <div class="coverage-map__frame rounded-[var(--radius-card)] border border-navy-100 shadow-[var(--shadow-md)]">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label="Mappa del raggio d'azione di Amon Energy: la sede di Castelluccio dei Sauri (FG) copre l'intero Centro-Sud Italia"
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <linearGradient id={`${uid}-sea`} x1="0" y1="0" x2="0.35" y2="1">
          <stop offset="0" stop-color="#0c3151"></stop>
          <stop offset="1" stop-color="#081f36"></stop>
        </linearGradient>
        <!-- Terra appena più chiara del mare: a staccarla è il profilo di costa,
             non un salto di tono. Il gradiente di prima (#1c5680 → #123f61)
             faceva leggere la penisola come un oggetto lucido appoggiato sopra
             la carta invece che come la carta stessa. -->
        <linearGradient id={`${uid}-land`} x1="0.2" y1="0" x2="0.8" y2="1">
          <stop offset="0" stop-color="#15405f"></stop>
          <stop offset="1" stop-color="#0f3350"></stop>
        </linearGradient>
        <!-- Trama del mare a passo fisso, il fondo di una carta nautica. Prende
             il posto dell'alone radiale ciano, che era l'unica cosa nel riquadro
             a non venire da un dato. -->
        <pattern id={`${uid}-dots`} width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="1.1" cy="1.1" r="1.1" fill="#4f93c4" fill-opacity="0.16"></circle>
        </pattern>
        <filter id={`${uid}-shelf`} x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="6"></feGaussianBlur>
        </filter>
        <linearGradient id={`${uid}-fade`} gradientUnits="userSpaceOnUse" x1="0" y1={n(yCut)} x2="0" y2={n(yFade)}>
          <stop offset="0" stop-color="#000"></stop>
          <stop offset="1" stop-color="#fff"></stop>
        </linearGradient>
        <mask id={`${uid}-cut`}>
          <rect width={W} height={H} fill={`url(#${uid}-fade)`}></rect>
        </mask>
        <!-- L'area servita non è un bagliore appoggiato sopra il mare: è la
             stessa terra, schiarita dentro il raggio. Si legge "fin qui
             arriviamo" senza che nulla galleggi. -->
        <clipPath id={`${uid}-reach`}>
          <circle cx={n(sx)} cy={n(sy)} r={n(km(450))}></circle>
        </clipPath>
        <radialGradient id={`${uid}-reach-fill`} gradientUnits="userSpaceOnUse" cx={n(sx)} cy={n(sy)} r={n(km(450))}>
          <stop offset="0" stop-color="#8fe6b3" stop-opacity="0.14"></stop>
          <stop offset="0.62" stop-color="#8fe6b3" stop-opacity="0.07"></stop>
          <stop offset="1" stop-color="#8fe6b3" stop-opacity="0.02"></stop>
        </radialGradient>
      </defs>

      <rect width={W} height={H} fill={`url(#${uid}-sea)`}></rect>
      <rect width={W} height={H} fill={`url(#${uid}-dots)`}></rect>

      <!-- Graticola a 2°, sotto il pixel pieno: dà scala allo sguardo, non si fa
           guardare. -->
      <g stroke="#3f7fb0" stroke-width="0.8" opacity="0.22">
        {lonLines.map((l) => <line x1={n(xy([l, 0])[0])} y1="0" x2={n(xy([l, 0])[0])} y2={H} />)}
        {latLines.map((l) => <line x1="0" y1={n(xy([0, l])[1])} x2={W} y2={n(xy([0, l])[1])} />)}
      </g>

      <g mask={`url(#${uid}-cut)`}>
        <!-- Piattaforma continentale: la stessa sagoma, sfocata, sotto la costa.
             È così che una carta nautica stacca la terra dal mare; un contorno
             solo lasciava il profilo piatto. -->
        <g fill="none" stroke="#5aa3d4" stroke-width="9" opacity="0.2" filter={`url(#${uid}-shelf)`}>
          {forme.map((f) => <path d={smoothClosed(f)} />)}
        </g>
        <g fill={`url(#${uid}-land)`} stroke="#5e9cc6" stroke-width="1.1" stroke-linejoin="round">
          {forme.map((f) => <path d={smoothClosed(f)} />)}
        </g>
        <g clip-path={`url(#${uid}-reach)`} fill={`url(#${uid}-reach-fill)`} stroke="none">
          {forme.map((f) => <path d={smoothClosed(f)} />)}
        </g>
      </g>

      <!-- Anelli di raggio: linea piena e sottile al posto del tratteggio verde
           spesso. Le quote stanno su una sola radiale a nord-est, ognuna con la
           sua tacca: incolonnate sopra il perno com'erano prima leggevano come
           tre bolle sospese. -->
      <g fill="none" stroke="#4fd07f" stroke-opacity="0.34" stroke-width="1">
        {anelli.map((a) => <circle class="ring" cx={n(sx)} cy={n(sy)} r={n(km(a.km))} />)}
      </g>
      <g stroke="#4fd07f" stroke-opacity="0.34" stroke-width="1">
        {
          anelli.map((a) => {
            const [tx, ty] = radial(a.km + 16, a.deg);
            const [ix, iy] = radial(a.km - 16, a.deg);
            return <line x1={n(ix)} y1={n(iy)} x2={n(tx)} y2={n(ty)} />;
          })
        }
      </g>
      <g
        font-family="Inter Variable, Inter, sans-serif"
        font-size="13"
        font-weight="600"
        letter-spacing="0.08em"
        fill="#8fd9ab"
        text-anchor="middle"
        paint-order="stroke"
        stroke="#081f36"
        stroke-width="3.5"
        stroke-opacity="0.85"
      >
        {
          anelli.map((a) => {
            const [lx, ly] = radial(a.km + 46, a.deg);
            return <text x={n(lx)} y={n(ly + 4)}>{a.km} KM</text>;
          })
        }
      </g>

      <!-- Città: maiuscoletto spaziato e punto piccolo — etichette di carta, non
           segnaposti. Il filo scuro sotto il testo (`paint-order`) è ciò che le
           tiene leggibili sopra la costa senza doverle ingrandire. -->
      <g
        font-family="Inter Variable, Inter, sans-serif"
        font-size="13"
        font-weight="600"
        letter-spacing="0.09em"
        fill="#bcd6e8"
        paint-order="stroke"
        stroke="#081f36"
        stroke-width="3.5"
        stroke-opacity="0.8"
      >
        {
          citta.map((c) => {
            const [cx, cy] = xy(c.ll);
            return (
              <>
                <circle cx={n(cx)} cy={n(cy)} r="2.6" fill="#bcd6e8" fill-opacity="0.85" stroke="none" />
                <text
                  x={n(cx + (c.dx ?? 0))}
                  y={n(cy + (c.dy ?? 0))}
                  text-anchor={c.anchor ?? 'start'}
                >
                  {c.nome.toUpperCase()}
                </text>
              </>
            );
          })
        }
      </g>

      <!-- Sede: mira topografica, non la goccia delle app di mappe. Anello fine,
           quattro tacche cardinali, punto pieno al centro — il verde torna a
           essere il micro-accento che DESIGN.md prescrive. -->
      <g transform={`translate(${n(sx)} ${n(sy)})`}>
        <circle class="pulse" r={n(km(58))} fill="none" stroke="#4fd07f" stroke-opacity="0.5" stroke-width="1.2"></circle>
        <g fill="none" stroke="#4fd07f" stroke-width="1.6" stroke-linecap="round">
          <circle r="11"></circle>
          <line x1="0" y1="-21" x2="0" y2="-15"></line>
          <line x1="0" y1="15" x2="0" y2="21"></line>
          <line x1="-21" y1="0" x2="-15" y2="0"></line>
          <line x1="15" y1="0" x2="21" y2="0"></line>
        </g>
        <circle r="4.2" fill="#4fd07f"></circle>
      </g>

      <!-- Cornice interna con tacche d'angolo: chiude il riquadro come uno
           strumento, non come una figura ritagliata. -->
      <rect
        x="14"
        y="14"
        width={W - 28}
        height={H - 28}
        rx="6"
        fill="none"
        stroke="#6ba7d2"
        stroke-opacity="0.26"
        stroke-width="1"></rect>
      <g stroke="#8fd9ab" stroke-opacity="0.5" stroke-width="1.4" stroke-linecap="square">
        <line x1="14" y1="38" x2="14" y2="14"></line>
        <line x1="14" y1="14" x2="38" y2="14"></line>
        <line x1={W - 38} y1="14" x2={W - 14} y2="14"></line>
        <line x1={W - 14} y1="14" x2={W - 14} y2="38"></line>
        <line x1="14" y1={H - 38} x2="14" y2={H - 14}></line>
        <line x1="14" y1={H - 14} x2="38" y2={H - 14}></line>
        <line x1={W - 38} y1={H - 14} x2={W - 14} y2={H - 14}></line>
        <line x1={W - 14} y1={H - 14} x2={W - 14} y2={H - 38}></line>
      </g>
    </svg>

  </div>

  <!-- La targhetta sta sotto la carta, non sopra: in basso a sinistra, unico
       angolo di mare libero, la pill arrivava comunque sulla Sicilia e se la
       mangiava. Fuori dal riquadro non copre nulla e non deve scendere sotto i
       12px del pavimento tipografico. -->
  <figcaption class="coverage-map__caption">
    <span class="coverage-map__dot" aria-hidden="true"></span>
    <span>
      <strong>Castelluccio dei Sauri (FG)</strong>
      <span class="coverage-map__caption-sub">Sede unica · raggio d'azione 450 km</span>
    </span>
  </figcaption>
</figure>

<style>
  .coverage-map__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #0a2a44;
  }

  .coverage-map__caption {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.85rem;
    padding-left: 0.15rem;
    color: var(--color-ink, #0f1b24);
    font-size: var(--fs-small);
    line-height: 1.35;
  }

  .coverage-map__caption strong {
    display: block;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .coverage-map__caption-sub {
    display: block;
    color: color-mix(in srgb, var(--color-ink, #0f1b24) 62%, transparent);
    font-size: var(--fs-micro);
  }

  .coverage-map__dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    border-radius: 999px;
    background: #2fa85f;
    box-shadow: 0 0 0 4px rgb(79 208 127 / 0.22);
  }

  .coverage-map__frame svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: ring-breathe 6s var(--ease-signature, ease-in-out) infinite;
  }
  .ring:nth-child(2) {
    animation-delay: 0.6s;
  }
  .ring:nth-child(3) {
    animation-delay: 1.2s;
  }

  .pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: pin-pulse 3.2s ease-out infinite;
  }

  @keyframes ring-breathe {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.015);
    }
  }

  @keyframes pin-pulse {
    0% {
      opacity: 0.55;
      transform: scale(0.5);
    }
    70% {
      opacity: 0;
      transform: scale(1.6);
    }
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }

