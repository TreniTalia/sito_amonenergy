---
// Selettore di lingua: legge la pathname corrente e la gemella da
// `src/i18n/routes.ts`, l'unica fonte delle coppie di URL. Non si mostra su
// pagine senza gemella (`altra === null`) — oggi capita solo per rotte non
// ancora presenti in ROTTE, non dovrebbe succedere sulle 15 coppie note.
import { gemella } from '../i18n/routes.ts';

interface Props {
  /** Variante compatta per la pillola nella navbar desktop (vetro, stessa
   * ricetta del CTA telefonico); il pannello mobile usa lo stile di default. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const { lingua, altra } = gemella(Astro.url.pathname);
---

{
  altra && (
    <a
      href={altra}
      hreflang={lingua === 'it' ? 'en' : 'it'}
      rel="alternate"
      class:list={['lang-switch', compact && 'lang-switch--compact']}
      aria-label={lingua === 'it' ? 'Passa alla versione in inglese' : 'Switch to the Italian version'}
    >
      {lingua === 'it' ? 'EN' : 'IT'}
    </a>
  )
}

<style>
  /* Stessa ricetta vetro dei pulsanti dell'header (.ds-header-cta): una
     pillola chiara, leggibile sia sul navy trasparente in cima all'hero sia
     sulla navbar "frosted" a scroll avvenuto. */
  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    white-space: nowrap;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--fs-button);
    color: var(--color-navy-950);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.88));
    border-radius: var(--radius-pill);
    padding: 10px 16px;
    text-decoration: none;
    box-shadow: var(--shadow-sm), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    transition:
      transform 0.2s var(--ease-signature),
      box-shadow 0.3s var(--ease-signature);
  }
  .lang-switch:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md), var(--glow-signal);
  }

  /* Nel pannello mobile la pillola sta su vetro scuro: bordo chiaro,
     sfondo trasparente, come `.ds-btn-ghost` sullo stesso pannello. */
  .lang-switch--compact {
    padding: 8px 14px;
    font-size: var(--fs-small);
  }
</style>
