---
/**
 * Energy flow — the signature ornament: two diverging electrodes at the
 * edges of the band, with a spark gap between them. Rendered statically in
 * CSS as a cold gap, no motion, no WebGL.
 *
 * The animated (WebGL/ogl) version was removed: on iPhone the discharge
 * painted an opaque white rectangle across the band (see info_utili/issue.jpeg),
 * and the defect persisted after two targeted shader fixes.
 */
interface Props {
  tone?: 'signal' | 'navy';
  class?: string;
}

const { tone = 'signal', class: className = '' } = Astro.props;
---

<div class:list={['energy-flow', className]} data-tone={tone} aria-hidden="true">
  <span class="energy-rod energy-rod--l" />
  <span class="energy-gap" />
  <span class="energy-rod energy-rod--r" />
</div>

<style>
  .energy-flow {
    position: relative;
    width: 100%;
    height: 72px;
    line-height: 0;
  }
  .energy-rod,
  .energy-gap {
    position: absolute;
    display: block;
  }
  .energy-rod {
    bottom: 38%;
    width: 1px;
    height: 26%;
    background: linear-gradient(to top, var(--tone-rod), transparent);
  }
  .energy-rod--l {
    left: 36.5%;
    transform: skewX(-7deg);
    transform-origin: bottom;
  }
  .energy-rod--r {
    right: 36.5%;
    transform: skewX(7deg);
    transform-origin: bottom;
  }
  .energy-gap {
    inset: auto 0 38% 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--tone-rod) 14%,
      var(--tone-rod) 36.5%,
      transparent 37%,
      transparent 63%,
      var(--tone-rod) 63.5%,
      var(--tone-rod) 86%,
      transparent
    );
  }

  /* I due toni si distinguono per la *superficie* su cui poggia la fascia, non
     per un colore proprio: su fondo scuro il tratto deve essere più chiaro del
     fondo, su fondo chiaro più scuro. Prima erano entrambi navy in alpha —
     scelta giusta finché il tono `signal` copriva solo i divisori su chiaro, ma
     con l'arco animato rimosso è quel tono a chiudere gli hero navy, dove un
     navy su navy semplicemente non si vede. */

  /* `signal` — sugli hero navy. Tratto in bianco-carta, con un soffio di
     signal-400: è l'unico blu ammesso a questa scala (il verde romperebbe la
     Leaf Rarity Rule). */
  .energy-flow[data-tone='signal'] {
    --tone-rod: color-mix(
      in srgb,
      color-mix(in srgb, var(--color-paper) 82%, var(--color-signal-400)) 30%,
      transparent
    );
  }
  /* `navy` — sui divisori nelle sezioni chiare. */
  .energy-flow[data-tone='navy'] {
    --tone-rod: color-mix(in srgb, var(--color-navy-700) 45%, transparent);
  }
</style>
