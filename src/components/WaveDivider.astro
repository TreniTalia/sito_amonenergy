---
/**
 * Signal ribbon — the one signature ornament of the system, lifted from the
 * Amon Energy brochure: many thin parallel strands flowing as a single wave.
 * Tileable, so it drifts seamlessly. Static under prefers-reduced-motion.
 */
interface Props {
  tone?: 'signal' | 'navy' | 'green';
  animated?: boolean;
  class?: string;
}

const { tone = 'signal', animated = false, class: className = '' } = Astro.props;

const stroke =
  tone === 'signal'
    ? 'var(--color-signal-400)'
    : tone === 'green'
      ? 'var(--color-green-400)'
      : 'var(--color-navy-700)';

// One tile: 1200 wide, 2 full periods so it tiles seamlessly when duplicated.
const W = 1200;
const MID = 60;
const periods = 2;
const amp = 26;
const step = 6;
const points: number[][] = [];
for (let x = 0; x <= W; x += step) {
  const y = MID + Math.sin((x / W) * periods * Math.PI * 2) * amp;
  points.push([x, Math.round(y * 100) / 100]);
}
const basePath = 'M' + points.map((p) => `${p[0]},${p[1]}`).join(' L');

// Stack of strands, offset vertically with fading opacity — the "ribbon".
const strands = Array.from({ length: 11 }, (_, i) => {
  const t = i - 5; // -5..5
  return { dy: t * 3.4, opacity: Math.max(0.12, 1 - Math.abs(t) * 0.16) };
});
---

<div
  class:list={['wave-divider', { 'is-animated': animated }, className]}
  aria-hidden="true"
  style={`--wave-stroke:${stroke}`}
>
  <div class="wave-track">
    {
      [0, 1].map(() => (
        <svg viewBox={`0 0 ${W} 120`} preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          {strands.map((s) => (
            <path
              d={basePath}
              fill="none"
              stroke="var(--wave-stroke)"
              stroke-width="1"
              vector-effect="non-scaling-stroke"
              transform={`translate(0 ${s.dy})`}
              style={`opacity:${s.opacity}`}
            />
          ))}
        </svg>
      ))
    }
  </div>
</div>

<style>
  .wave-divider {
    overflow: hidden;
    width: 100%;
    height: 72px;
    line-height: 0;
  }
  .wave-track {
    display: flex;
    width: 200%;
    height: 100%;
  }
  .is-animated .wave-track {
    animation: wave-drift 26s linear infinite;
  }
  .wave-track svg {
    width: 50%;
    height: 100%;
    flex-shrink: 0;
  }
  @keyframes wave-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-animated .wave-track {
      animation: none;
    }
  }
</style>
