---
import { render, type CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import PageHero from './PageHero.astro';
import CtaBand from './CtaBand.astro';

interface Props {
  entry: CollectionEntry<'servizi'>;
  /** Full-bleed hero photo (landscape scene). */
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  /** Framed figure inside the body (e.g. a product/equipment cutout). */
  bodyImage?: ImageMetadata;
  bodyImageAlt?: string;
  /** True for cutout product shots on a light plate (object-contain). */
  bodyImageContain?: boolean;
}

const { entry, heroImage, heroImageAlt = '', bodyImage, bodyImageAlt = '', bodyImageContain = false } =
  Astro.props;
const { titolo, frase, punti } = entry.data;
const { Content } = await render(entry);
---

<PageHero eyebrow="Servizi" h1={titolo} sub={frase} image={heroImage} imageAlt={heroImageAlt} />

<section class="wrap-wide py-20 lg:py-28">
  <div class:list={['grid gap-12', { 'lg:grid-cols-[1fr_0.9fr] lg:items-center lg:gap-16': !!bodyImage }]}>
    <div class="measure text-lg leading-relaxed prose-intro text-ink/90" data-reveal>
      <Content />
    </div>
    {
      bodyImage && (
        <figure
          class:list={[
            'overflow-hidden rounded-[2px] border border-navy-100',
            bodyImageContain ? 'bg-navy-100/60 p-6' : '',
          ]}
          data-reveal
          style="--reveal-delay:120ms"
        >
          <Image
            src={bodyImage}
            alt={bodyImageAlt}
            class:list={['w-full', bodyImageContain ? 'object-contain' : 'object-cover']}
            widths={[500, 800, 1000]}
            sizes="(min-width: 1024px) 42vw, 100vw"
          />
        </figure>
      )
    }
  </div>

  {
    punti && punti.length > 0 && (
      <div class="mt-16 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:mt-20 lg:grid-cols-3 lg:gap-x-12">
        {punti.map((p, i) => (
          <div class="border-t border-navy-100 pt-6" data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <span class="tnum font-display text-sm font-semibold text-green-500">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-display text-xl font-bold tracking-tight text-ink">{p.titolo}</h3>
            <p class="mt-3 leading-relaxed text-ink/70">{p.testo}</p>
          </div>
        ))}
      </div>
    )
  }
</section>

<CtaBand />

<style>
  .prose-intro :global(p) {
    margin: 0;
  }
  .prose-intro :global(p + p) {
    margin-top: 1rem;
  }
</style>
