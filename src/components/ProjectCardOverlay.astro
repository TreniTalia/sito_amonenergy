---
// Pannello vetro liquido sopra la foto/placeholder di ogni slide di
// ProjectSlider — stesso identico recipe di `.ds-card-service--elevated`
// (global.css): rifrazione SVG reale (`#liquid-glass-panel`, Base.astro),
// frosted navy, sheen diagonale, ombre a strati.
//
// Il pannello è alto uguale su tutte le card: ogni riga ha uno spazio fisso
// (titolo 2 righe, chip potenza, descrizione 2 righe su computer e 3 su
// telefono, riga dati 1 e 2), riservato anche quando il testo è più corto o
// manca. Prima cresceva col testo, e una descrizione lunga copriva più foto.
// I `maxlength` del pannello /admin sono tarati per starci; il `line-clamp`
// è solo la rete di sicurezza, se un testo più lungo arrivasse lo stesso.
interface Props {
  indexLabel: string;
  titolo: string;
  potenza?: string;
  descrizione: string;
  meta?: string;
}

const { indexLabel, titolo, potenza, descrizione, meta } = Astro.props;
---

<div class="pco">
  <p class="pco-index" aria-hidden="true">
    <span class="pco-dash"></span>
    {indexLabel}
  </p>
  <h3 class="pco-titolo"><span class="pco-titolo-testo">{titolo}</span></h3>
  {potenza ? <span class="pco-potenza">{potenza}</span> : <span class="pco-potenza is-vuoto" aria-hidden="true">&nbsp;</span>}
  <p class="pco-desc">{descrizione}</p>
  <p class="pco-meta">{meta}</p>
</div>

<style>
  .pco {
    position: absolute;
    z-index: 2;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-card);
    padding: 1.1rem 1.25rem 1.2rem;
    /* Meno tinta, più blur: l'opacità piena leggeva come una card a fondo
       pieno, non come vetro — il trucco del vetro vero (vedi il pezzo di
       Master.dev linkato per questo sito) è che il contrasto lo tiene la
       sfocatura forte, non il colore sopra. Qui sotto la foto resta
       riconoscibile attraverso il pannello invece di sparire dietro navy
       piatto, ma il blur (26px) e la rifrazione SVG restano il vero lavoro
       di leggibilità. */
    background:
      radial-gradient(120% 180% at 14% -25%, rgba(255, 255, 255, 0.24), transparent 55%),
      var(--glass-sheen),
      color-mix(in srgb, var(--color-navy-950) 58%, transparent);
    backdrop-filter: blur(26px) saturate(220%);
    -webkit-backdrop-filter: blur(26px) saturate(220%);
    backdrop-filter: url(#liquid-glass-panel) blur(22px) saturate(220%);
    border: 1px solid rgba(255, 255, 255, 0.26);
    box-shadow:
      var(--shadow-md),
      inset 0 1.5px 0 rgba(255, 255, 255, 0.3),
      inset 0 -14px 22px -18px rgba(4, 16, 28, 0.5);
    color: var(--color-paper);
  }
  .pco::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(
      120deg,
      transparent 30%,
      rgba(255, 255, 255, 0.09) 45%,
      rgba(255, 255, 255, 0.14) 50%,
      rgba(255, 255, 255, 0.09) 55%,
      transparent 70%
    );
    mix-blend-mode: screen;
  }

  .pco-index {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-micro);
    line-height: var(--lh-label);
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-signal-400);
  }
  .pco-dash {
    display: inline-block;
    width: 20px;
    height: 2px;
    background: currentColor;
    border-radius: 999px;
  }

  /* Righe a numero fisso: `height` in `lh` riserva lo spazio anche per un
     testo più corto, `line-clamp` taglia coi puntini quello più lungo. */
  .pco-titolo-testo,
  .pco-desc,
  .pco-meta {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Il titolo di una riga (quasi sempre, su computer) scende in fondo al suo
     spazio: il vuoto resta sotto l'indice e titolo, chip e descrizione
     stanno insieme, invece di aprire un buco fra titolo e chip. */
  .pco-titolo {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-title);
    letter-spacing: -0.015em;
    line-height: var(--lh-title);
    height: 2lh;
  }
  .pco-titolo-testo {
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .pco-potenza {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-green-500) 78%, var(--color-navy-950) 22%);
    border: 1px solid color-mix(in srgb, var(--color-green-500) 55%, transparent);
    font-family: var(--font-display);
    font-size: var(--fs-micro);
    line-height: var(--lh-label);
    font-weight: 600;
  }
  /* Senza potenza il chip resta, invisibile: tiene la riga e quindi l'altezza
     del pannello uguale a quella delle altre card. */
  .pco-potenza.is-vuoto {
    visibility: hidden;
  }

  .pco-desc {
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: color-mix(in srgb, var(--color-paper) 82%, transparent);
    height: 2lh;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .pco-meta {
    /* `content-box`: l'altezza in righe non deve mangiarsi padding e bordo
       che separano la riga dati dalla descrizione. */
    box-sizing: content-box;
    margin-top: 0.55rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: var(--fs-micro);
    line-height: var(--lh-label);
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--color-paper) 60%, transparent);
    height: 1lh;
    -webkit-line-clamp: 1;
    line-clamp: 1;
  }

  /* Telefono: stesso breakpoint della card verticale di ProjectSlider. La
     colonna è larga circa metà, e le stesse frasi vanno a capo di più. */
  @media (max-width: 767px) {
    .pco-desc {
      height: 3lh;
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }
    .pco-meta {
      height: 2lh;
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }
  }
</style>
