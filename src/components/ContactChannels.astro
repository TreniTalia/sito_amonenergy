---
import { Icon } from 'astro-icon/components';
import { contatti } from '../data/contatti.ts';
import PackIcon from './PackIcon.astro';

interface Props {
  h1: string;
  sub: string;
  orari: string;
}

const { h1, sub, orari } = Astro.props;
---

<div>
  <h1 class="text-display" style="font-size: clamp(2rem, 4vw, 3rem); max-width: 16ch;">{h1}</h1>
  <p class="measure mt-5 text-lg text-ink/75" style="line-height: 1.65;">{sub}</p>

  <div class="mt-10 flex flex-col gap-4">
    <a href={contatti.telefonoHref} class="ds-btn-primary justify-center" style="padding: 19px 32px; font-size: 1.0625rem;">
      <PackIcon name="phone" class="shrink-0 text-base" />
      Chiamaci — {contatti.telefono}
    </a>
    <p class="text-sm text-ink/60" style="margin-top: -0.5rem;">{orari}</p>

    <a href={`mailto:${contatti.email}?subject=Richiesta%20informazioni`} class="ds-btn-secondary justify-center mt-2" style="padding: 19px 32px; font-size: 1.0625rem;">
      <Icon name="fa6-solid:envelope" class="shrink-0 text-base" />
      Scrivici — {contatti.email}
    </a>
  </div>

  <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-ink/70">
    <a href={`mailto:${contatti.pec}`} class="hover:text-navy-700 transition-colors">PEC: {contatti.pec}</a>
    <a href={contatti.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-navy-700 transition-colors">LinkedIn</a>
  </div>

  <p class="mt-6 text-xs text-ink/50">
    P.IVA {contatti.piva} · Codice FE {contatti.codiceFE}
  </p>
</div>
