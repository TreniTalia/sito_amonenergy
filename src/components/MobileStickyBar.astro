---
import { Icon } from 'astro-icon/components';
import { contatti } from '../data/contatti.ts';
---

<div
  class="md:hidden fixed bottom-0 left-0 right-0 z-30 px-4 pt-2"
  style="padding-bottom: calc(env(safe-area-inset-bottom) + 12px);"
>
  <div class="mobilebar flex items-center gap-2.5 rounded-full p-1.5">
    <a
      href={contatti.telefonoHref}
      class="flex flex-1 items-center justify-center gap-2 rounded-full py-2.5 text-[0.95rem] font-semibold text-paper"
      style="background: linear-gradient(180deg, var(--color-navy-700), var(--color-navy-950)); box-shadow: 0 6px 16px -6px rgba(4,16,28,0.6), inset 0 1px 0 rgba(255,255,255,0.16);"
    >
      <Icon name="fa6-solid:phone" class="text-[0.8rem]" />
      Chiama
    </a>
    <a
      href={`mailto:${contatti.email}?subject=Richiesta%20informazioni`}
      class="flex flex-1 items-center justify-center gap-2 rounded-full py-2.5 text-[0.95rem] font-semibold text-navy-950"
      style="background: linear-gradient(180deg, #ffffff, rgba(255,255,255,0.9)); box-shadow: 0 6px 16px -6px rgba(4,16,28,0.35), inset 0 1px 0 rgba(255,255,255,0.9);"
    >
      <Icon name="fa6-solid:envelope" class="text-[0.8rem]" />
      Email
    </a>
  </div>
</div>

<style>
  .mobilebar {
    background: var(--glass-sheen), color-mix(in srgb, var(--color-navy-950) 55%, transparent);
    backdrop-filter: blur(22px) saturate(170%);
    -webkit-backdrop-filter: blur(22px) saturate(170%);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 12px 34px -12px rgba(4, 16, 28, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }
</style>
