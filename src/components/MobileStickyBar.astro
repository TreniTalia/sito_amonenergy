---
import { contatti } from '../data/contatti.ts';
---

<div class="md:hidden fixed bottom-0 left-0 right-0 z-30 flex" style="height: calc(56px + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom);">
  <a
    href={contatti.telefonoHref}
    class="flex-1 flex items-center justify-center gap-2 bg-navy-900 text-paper font-semibold border-r border-navy-700"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.428 1.235l-.5.436A1 1 0 0 0 8.048 10c1.1 2.062 3.892 4.854 5.784 6.568"/></svg>
    Chiama
  </a>
  <a
    href={`mailto:${contatti.email}?subject=Richiesta%20informazioni`}
    class="flex-1 flex items-center justify-center gap-2 bg-navy-950 text-paper font-semibold"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
    Email
  </a>
</div>
