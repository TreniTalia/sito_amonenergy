---
// Sfondo del hero: campo eolico "digital twin" in Three.js, sostituto del
// vecchio pattern-video di circuito. Stessa palette del pattern che
// rimpiazza — navy-950 di fondo, la traccia viva su signal-400 — con
// green-400 riservato al mozzo del rotore, l'unico punto "vivo" della scena
// (Leaf Rarity Rule, DESIGN.md §"Do keep green-500/green-400 to micro-accents").
---

<canvas class="hero-twin absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

<style>
  .hero-twin {
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .hero-twin.is-ready {
    opacity: 1;
  }
  /* A differenza del vecchio video, gira anche sotto i 768px — è WebGL a
     punti, non un decoder video, e il budget di particelle si abbassa da
     script (isMobile) invece che sparire del tutto. Resta spento solo con
     prefers-reduced-motion. */
  @media (prefers-reduced-motion: reduce) {
    .hero-twin {
      display: none;
    }
  }
</style>

<script>
  import * as THREE from 'three';

  const canvas = document.querySelector<HTMLCanvasElement>('.hero-twin');
  if (canvas && getComputedStyle(canvas).display !== 'none') {
    mount(canvas);
  }

  function mount(canvas: HTMLCanvasElement) {
    // Rampa navy + signal-400 del sito (DESIGN.md), non il blu/ciano originale
    // dell'animazione "Amon Wind".
    const NAVY_BG = 0x0a2a44;
    const SIGNAL = 0x4fb3d9;
    const SIGNAL_DEEP = 0x1d5585;
    const GREEN = 0x4fd07f;
    const ICE = 0xe8eff5;

    let renderer: THREE.WebGLRenderer;
    let scene: THREE.Scene;
    let camera: THREE.PerspectiveCamera;
    let raf = 0;
    let started = false;

    const section = canvas.closest('section');
    const isMobile = matchMedia('(max-width: 767px)').matches;

    function radialTexture() {
      const c = document.createElement('canvas');
      c.width = c.height = 256;
      const x = c.getContext('2d')!;
      const g = x.createRadialGradient(128, 128, 0, 128, 128, 128);
      g.addColorStop(0, 'rgba(255,255,255,1)');
      g.addColorStop(0.08, 'rgba(255,255,255,.82)');
      g.addColorStop(0.28, 'rgba(255,255,255,.22)');
      g.addColorStop(1, 'rgba(255,255,255,0)');
      x.fillStyle = g;
      x.fillRect(0, 0, 256, 256);
      return new THREE.CanvasTexture(c);
    }

    function pointCloud(arr: number[], color: number, size = 0.026, opacity = 0.9, fog = true) {
      const g = new THREE.BufferGeometry();
      g.setAttribute('position', new THREE.Float32BufferAttribute(arr, 3));
      const m = new THREE.PointsMaterial({
        color,
        size,
        transparent: true,
        opacity,
        sizeAttenuation: true,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
        fog,
      });
      return new THREE.Points(g, m);
    }

    function init() {
      renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: !isMobile,
        alpha: false,
        powerPreference: 'high-performance',
      });
      renderer.setPixelRatio(Math.min(devicePixelRatio, isMobile ? 1.4 : 1.8));
      renderer.setClearColor(NAVY_BG, 1);
      renderer.outputColorSpace = THREE.SRGBColorSpace;

      scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(NAVY_BG, 0.05);

      camera = new THREE.PerspectiveCamera(41, 1, 0.1, 80);
      camera.position.set(2.4, 3.1, 12.2);
      camera.lookAt(2.1, 2.7, 0);

      const glowTex = radialTexture();

      const backGlow = new THREE.Sprite(
        new THREE.SpriteMaterial({
          map: glowTex,
          color: SIGNAL_DEEP,
          transparent: true,
          opacity: 0.18,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        }),
      );
      backGlow.scale.set(12, 9, 1);
      backGlow.position.set(2.2, 3.0, -3.5);
      scene.add(backGlow);

      const signalGlow = new THREE.Sprite(
        new THREE.SpriteMaterial({
          map: glowTex,
          color: SIGNAL,
          transparent: true,
          opacity: 0.08,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        }),
      );
      signalGlow.scale.set(6.5, 6.5, 1);
      signalGlow.position.set(2.1, 3.5, -1.2);
      scene.add(signalGlow);

      // Dust / particelle sospese
      const dustCount = isMobile ? 220 : 500;
      const dustPos = new Float32Array(dustCount * 3);
      const dustSeed = new Float32Array(dustCount);
      for (let i = 0; i < dustCount; i++) {
        dustPos[i * 3] = THREE.MathUtils.randFloatSpread(20) + 2;
        dustPos[i * 3 + 1] = THREE.MathUtils.randFloat(-0.4, 8.5);
        dustPos[i * 3 + 2] = THREE.MathUtils.randFloat(-8, 5);
        dustSeed[i] = Math.random();
      }
      const dustGeo = new THREE.BufferGeometry();
      dustGeo.setAttribute('position', new THREE.BufferAttribute(dustPos, 3));
      dustGeo.setAttribute('aSeed', new THREE.BufferAttribute(dustSeed, 1));
      const dustMat = new THREE.ShaderMaterial({
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        uniforms: { uTime: { value: 0 }, uColor: { value: new THREE.Color(SIGNAL) } },
        vertexShader: `
          attribute float aSeed;
          uniform float uTime;
          varying float vA;
          void main(){
            vec3 p=position;
            p.y += sin(uTime*.25+aSeed*17.0)*.045;
            vec4 mv=modelViewMatrix*vec4(p,1.);
            gl_Position=projectionMatrix*mv;
            gl_PointSize=(1.0+aSeed*1.2)*(110.0/-mv.z);
            vA=.10+.26*pow(.5+.5*sin(uTime*.8+aSeed*23.),6.);
          }`,
        fragmentShader: `
          uniform vec3 uColor; varying float vA;
          void main(){
            vec2 q=gl_PointCoord-.5; float d=length(q);
            if(d>.5) discard;
            float a=smoothstep(.5,0.,d)*vA;
            gl_FragColor=vec4(uColor,a);
          }`,
      });
      scene.add(new THREE.Points(dustGeo, dustMat));

      // Campo di terreno a punti
      const cols = isMobile ? 110 : 220,
        rows = isMobile ? 66 : 132;
      const positions: number[] = [],
        seeds: number[] = [],
        baseY: number[] = [];
      for (let iz = 0; iz < rows; iz++) {
        const z = THREE.MathUtils.lerp(-5.4, 8.2, iz / (rows - 1));
        for (let ix = 0; ix < cols; ix++) {
          const x = THREE.MathUtils.lerp(-9.5, 15.0, ix / (cols - 1));
          let y = -1.55;
          y += Math.sin(x * 0.68 + z * 0.26) * 0.18;
          y += Math.cos(x * 1.65 - z * 0.33) * 0.075;
          y += Math.sin(z * 0.72) * 0.06;
          y += Math.sin(x * 2.4 + z * 1.7) * 0.02;
          y += Math.exp(-Math.pow(x - 7.5, 2) * 0.18) * 0.22;
          y -= Math.exp(-Math.pow(x + 1.2, 2) * 0.32) * 0.1;
          y = Math.round(y / 0.03) * 0.03;
          positions.push(x, y, z);
          baseY.push(y);
          seeds.push(Math.random());
        }
      }
      const terrainGeo = new THREE.BufferGeometry();
      terrainGeo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      terrainGeo.setAttribute('aSeed', new THREE.Float32BufferAttribute(seeds, 1));
      terrainGeo.setAttribute('aBaseY', new THREE.Float32BufferAttribute(baseY, 1));

      const terrainMat = new THREE.ShaderMaterial({
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        uniforms: {
          uTime: { value: 0 },
          uMouse: { value: new THREE.Vector3(100, 0, 100) },
          uColorA: { value: new THREE.Color(SIGNAL_DEEP) },
          uColorB: { value: new THREE.Color(SIGNAL) },
        },
        vertexShader: `
          attribute float aSeed;
          uniform float uTime;
          uniform vec3 uMouse;
          varying float vGlow;
          varying float vDepth;
          varying float vSeed;
          void main(){
            vec3 p=position;
            float wave = sin(p.x*.9+p.z*.72+uTime*.7)*.018;
            p.y += wave;
            float d=distance(p.xz,uMouse.xz);
            float influence=smoothstep(3.8,0.0,d);
            p.y -= influence*.26;
            p.y += sin(d*6.5-uTime*5.2)*.095*influence;
            vec2 dir=normalize(p.xz-uMouse.xz+vec2(.0001));
            p.xz += dir*influence*.16;
            vec4 mv=modelViewMatrix*vec4(p,1.);
            gl_Position=projectionMatrix*mv;
            float perspective=130.0/max(2.0,-mv.z);
            gl_PointSize=(1.25+aSeed*1.25)*perspective;
            vGlow=influence;
            vDepth=smoothstep(20.0,3.0,-mv.z);
            vSeed=aSeed;
          }`,
        fragmentShader: `
          uniform vec3 uColorA;
          uniform vec3 uColorB;
          uniform float uTime;
          varying float vGlow;
          varying float vDepth;
          varying float vSeed;
          void main(){
            vec2 q=gl_PointCoord-.5;
            float d=max(abs(q.x),abs(q.y));
            if(d>.48) discard;
            float tw=.72+.28*sin(uTime*1.3+vSeed*31.);
            vec3 c=mix(uColorA,uColorB,.22+vGlow*.9);
            c=mix(c,vec3(1.0),vGlow*.22);
            float a=(.13+vDepth*.34+vGlow*.5)*tw;
            gl_FragColor=vec4(c,a);
          }`,
      });
      const terrain = new THREE.Points(terrainGeo, terrainMat);
      scene.add(terrain);

      // Tracce tipo circuito sul terreno
      const circuitGroup = new THREE.Group();
      scene.add(circuitGroup);
      for (let i = 0; i < 42; i++) {
        const z = THREE.MathUtils.randFloat(-4.4, 6.7);
        const sx = THREE.MathUtils.randFloat(-8, 12.5);
        const len = THREE.MathUtils.randFloat(0.7, 2.8);
        const y = -1.34 + Math.sin(sx * 0.68 + z * 0.26) * 0.18 + Math.cos(sx * 1.65 - z * 0.33) * 0.075;
        const pts = [
          new THREE.Vector3(sx, y, z),
          new THREE.Vector3(sx + len * 0.55, y, z),
          new THREE.Vector3(sx + len * 0.68, y, z + 0.13 * Math.sign(Math.random() - 0.5)),
          new THREE.Vector3(sx + len, y, z + 0.13 * Math.sign(Math.random() - 0.5)),
        ];
        const g = new THREE.BufferGeometry().setFromPoints(pts);
        const m = new THREE.LineBasicMaterial({
          color: i % 5 === 0 ? GREEN : SIGNAL,
          transparent: true,
          opacity: THREE.MathUtils.randFloat(0.06, 0.22),
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        });
        const l = new THREE.Line(g, m);
        l.userData.phase = Math.random() * Math.PI * 2;
        circuitGroup.add(l);
      }

      // ---------- Sole ----------
      // Non un disco caldo: resta sulla rampa navy/signal, un "sole segnale"
      // coerente con l'estetica a punti/circuito piuttosto che fotorealistica.
      const sun = new THREE.Group();
      sun.position.set(6.2, 5.7, -4.2);
      scene.add(sun);
      const sunCore = new THREE.Sprite(
        new THREE.SpriteMaterial({
          map: glowTex,
          color: ICE,
          transparent: true,
          opacity: 0.85,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
          fog: false,
        }),
      );
      sunCore.scale.set(1.05, 1.05, 1);
      sun.add(sunCore);
      const sunHalo = new THREE.Sprite(
        new THREE.SpriteMaterial({
          map: glowTex,
          color: SIGNAL,
          transparent: true,
          opacity: 0.22,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
          fog: false,
        }),
      );
      sunHalo.scale.set(4.4, 4.4, 1);
      sun.add(sunHalo);
      {
        const ringSegs = isMobile ? 40 : 64;
        const ringPts: number[] = [];
        for (let i = 0; i < ringSegs; i++) {
          const a = (i / ringSegs) * Math.PI * 2;
          ringPts.push(Math.cos(a) * 1.55, Math.sin(a) * 1.55, 0);
        }
        sun.add(pointCloud(ringPts, SIGNAL, 0.032, 0.5, false));
      }

      // ---------- Montagne all'orizzonte ----------
      // Non più un profilo a linea: un campo di punti denso come il terreno,
      // riempito dalla base al crinale, con lo stesso shader (twinkle +
      // gradiente di colore in base all'altezza) così la texture è coerente
      // col resto della scena invece di leggersi come un disegno a parte.
      const mountainMat = new THREE.ShaderMaterial({
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
        uniforms: {
          uTime: { value: 0 },
          uColorA: { value: new THREE.Color(SIGNAL_DEEP) },
          uColorB: { value: new THREE.Color(SIGNAL) },
        },
        vertexShader: `
          attribute float aSeed;
          attribute float aHeight;
          attribute float aOpacity;
          uniform float uTime;
          varying float vHeight;
          varying float vSeed;
          varying float vOpacity;
          void main(){
            vec4 mv=modelViewMatrix*vec4(position,1.);
            gl_Position=projectionMatrix*mv;
            float perspective=130.0/max(2.0,-mv.z);
            gl_PointSize=(1.35+aSeed*1.2)*perspective;
            vHeight=aHeight;
            vSeed=aSeed;
            vOpacity=aOpacity;
          }`,
        fragmentShader: `
          uniform vec3 uColorA;
          uniform vec3 uColorB;
          uniform float uTime;
          varying float vHeight;
          varying float vSeed;
          varying float vOpacity;
          void main(){
            vec2 q=gl_PointCoord-.5;
            float d=max(abs(q.x),abs(q.y));
            if(d>.48) discard;
            float tw=.85+.15*sin(uTime*1.1+vSeed*29.);
            vec3 c=mix(uColorA,uColorB,.2+vHeight*.55);
            float a=vOpacity*(.4+vHeight*.42)*tw;
            gl_FragColor=vec4(c,a);
          }`,
      });

      function mountainField(zBase: number, zSpan: number, ampBase: number, seed: number, opacity: number) {
        const cols = isMobile ? 90 : 170;
        const layers = isMobile ? 5 : 9;
        const positions: number[] = [],
          seeds: number[] = [],
          heights: number[] = [],
          opacities: number[] = [];
        for (let ix = 0; ix <= cols; ix++) {
          const x = THREE.MathUtils.lerp(-18, 24, ix / cols);
          const ridgeH =
            -1.05 +
            Math.abs(Math.sin(x * 0.16 + seed) * ampBase) +
            Math.abs(Math.sin(x * 0.42 + seed * 2.3) * ampBase * 0.45) +
            Math.abs(Math.sin(x * 0.95 + seed * 4.1) * ampBase * 0.18);
          for (let l = 0; l < layers; l++) {
            const tl = l / (layers - 1);
            const y = THREE.MathUtils.lerp(-1.35, ridgeH, tl);
            const z = zBase + (Math.random() - 0.5) * zSpan;
            positions.push(x + (Math.random() - 0.5) * 0.16, y, z);
            seeds.push(Math.random());
            heights.push(tl);
            opacities.push(opacity);
          }
        }
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
        g.setAttribute('aSeed', new THREE.Float32BufferAttribute(seeds, 1));
        g.setAttribute('aHeight', new THREE.Float32BufferAttribute(heights, 1));
        g.setAttribute('aOpacity', new THREE.Float32BufferAttribute(opacities, 1));
        scene.add(new THREE.Points(g, mountainMat));
      }
      mountainField(-8.6, 2.2, 1.7, 3.1, 0.42);
      mountainField(-6.6, 1.6, 1.05, 1.4, 0.55);

      // ---------- Pannelli solari ----------
      const solarGroup = new THREE.Group();
      solarGroup.position.set(5.6, -1.3, -2.5);
      scene.add(solarGroup);
      const solarRows = isMobile ? 2 : 3;
      const solarCols = isMobile ? 3 : 4;
      const panels: THREE.Group[] = [];
      for (let r = 0; r < solarRows; r++) {
        for (let c = 0; c < solarCols; c++) {
          const panel = new THREE.Group();
          panel.position.set(c * 0.95, 0, r * 1.15);
          panel.rotation.x = -0.55;
          panel.rotation.y = 0.05;
          solarGroup.add(panel);
          panels.push(panel);

          const pw = 0.72,
            ph = 0.42;
          const a: number[] = [];
          for (let x = -pw / 2; x <= pw / 2; x += 0.05) {
            for (let y = -ph / 2; y <= ph / 2; y += 0.05) {
              a.push(x, y, 0);
            }
          }
          panel.add(pointCloud(a, SIGNAL_DEEP, 0.05, 0.3), pointCloud(a, SIGNAL, 0.028, 0.95));

          const fr = [
            [-pw / 2, -ph / 2],
            [pw / 2, -ph / 2],
            [pw / 2, ph / 2],
            [-pw / 2, ph / 2],
            [-pw / 2, -ph / 2],
          ].map(([x, y]) => new THREE.Vector3(x, y, 0.002));
          panel.add(
            new THREE.Line(
              new THREE.BufferGeometry().setFromPoints(fr),
              new THREE.LineBasicMaterial({
                color: SIGNAL,
                transparent: true,
                opacity: 0.42,
                blending: THREE.AdditiveBlending,
                depthWrite: false,
              }),
            ),
          );
        }
      }
      // Filo verde che collega il campo fotovoltaico alla turbina — l'unico
      // altro accento "vivo" oltre al mozzo del rotore (Leaf Rarity Rule).
      const wireLine = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(5.6, -1.28, -1.9),
          new THREE.Vector3(4.0, -1.29, -0.8),
          new THREE.Vector3(2.7, -1.28, 0.3),
        ]),
        new THREE.LineBasicMaterial({
          color: GREEN,
          transparent: true,
          opacity: 0.3,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        }),
      );
      scene.add(wireLine);

      // Turbina eolica
      const turbine = new THREE.Group();
      turbine.position.set(2.6, -1.28, 0);
      scene.add(turbine);

      {
        const a: number[] = [];
        const h = 5.25;
        for (let j = 0; j < 100; j++) {
          const y = (j / 99) * h;
          const radius = THREE.MathUtils.lerp(0.23, 0.075, y / h);
          for (let k = 0; k < 22; k++) {
            const ang = (k / 22) * Math.PI * 2 + (j % 2) * 0.04;
            a.push(Math.cos(ang) * radius, y, Math.sin(ang) * radius * 0.55);
          }
        }
        turbine.add(pointCloud(a, SIGNAL_DEEP, 0.058, 0.2), pointCloud(a, SIGNAL, 0.024, 0.85));
      }

      {
        const a: number[] = [];
        for (let x = -0.33; x <= 0.33; x += 0.055)
          for (let y = 4.98; y <= 5.27; y += 0.055)
            for (let z = -0.04; z <= 0.55; z += 0.07) if (Math.random() > 0.38) a.push(x, y, z);
        turbine.add(pointCloud(a, SIGNAL, 0.025, 0.75));
      }

      // Luce di segnalazione aerea in cima alla navicella — lo strobo classico
      // sulle pale, ma in green-400 invece del rosso, per spezzare il blu
      // dominante con l'unico altro accento "vivo" del sito oltre al mozzo.
      const beacon = new THREE.Sprite(
        new THREE.SpriteMaterial({
          map: glowTex,
          color: GREEN,
          transparent: true,
          opacity: 0,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
          fog: false,
        }),
      );
      beacon.scale.set(0.62, 0.62, 1);
      beacon.position.set(0, 6.35, 0.3);
      turbine.add(beacon);
      const beaconHalo = new THREE.Sprite(
        new THREE.SpriteMaterial({
          map: glowTex,
          color: GREEN,
          transparent: true,
          opacity: 0,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
          fog: false,
        }),
      );
      beaconHalo.scale.set(2.6, 2.6, 1);
      beaconHalo.position.copy(beacon.position);
      turbine.add(beaconHalo);

      const rotor = new THREE.Group();
      rotor.position.set(0, 5.12, -0.09);
      turbine.add(rotor);

      {
        const a: number[] = [];
        for (let i = 0; i < 700; i++) {
          const u = Math.random(),
            v = Math.random();
          const th = 2 * Math.PI * u,
            ph = Math.acos(2 * v - 1);
          const r = 0.245 * Math.pow(Math.random(), 0.34);
          a.push(Math.sin(ph) * Math.cos(th) * r, Math.sin(ph) * Math.sin(th) * r, Math.cos(ph) * r * 0.42);
        }
        rotor.add(pointCloud(a, ICE, 0.028, 0.92));
        const hubGlow = new THREE.Sprite(
          new THREE.SpriteMaterial({
            map: glowTex,
            color: GREEN,
            transparent: true,
            opacity: 0.3,
            blending: THREE.AdditiveBlending,
            depthWrite: false,
          }),
        );
        hubGlow.scale.set(1.35, 1.35, 1);
        rotor.add(hubGlow);
      }

      for (let b = 0; b < 3; b++) {
        const blade = new THREE.Group();
        blade.rotation.z = (b * Math.PI * 2) / 3;
        rotor.add(blade);

        const a: number[] = [];
        const outlineTop: THREE.Vector3[] = [];
        const outlineBottom: THREE.Vector3[] = [];
        const L = 2.55;
        for (let ir = 0; ir < 64; ir++) {
          const r = 0.24 + (L - 0.24) * (ir / 63);
          const k = (r - 0.24) / (L - 0.24);
          const width = THREE.MathUtils.lerp(0.23, 0.035, Math.pow(k, 0.78));
          const sweep = 0.11 * Math.sin(k * Math.PI * 0.72) * k;
          const centerX = sweep;
          const centerY = r;

          outlineTop.push(new THREE.Vector3(centerX - width * 0.5, centerY, 0));
          outlineBottom.push(new THREE.Vector3(centerX + width * 0.5, centerY, 0));

          const across = Math.max(2, Math.round(7 * (1 - k) + 2));
          for (let j = 0; j < across; j++) {
            const t = across === 1 ? 0 : j / (across - 1);
            const x = centerX + THREE.MathUtils.lerp(-width * 0.5, width * 0.5, t);
            const y = centerY;
            const z = (Math.random() - 0.5) * 0.027;
            a.push(x, y, z);
          }
        }
        blade.add(pointCloud(a, SIGNAL_DEEP, 0.065, 0.22), pointCloud(a, SIGNAL, 0.026, 0.92));

        const outlinePts = [...outlineTop, ...outlineBottom.reverse(), outlineTop[0]];
        const lg = new THREE.BufferGeometry().setFromPoints(outlinePts);
        blade.add(
          new THREE.Line(
            lg,
            new THREE.LineBasicMaterial({
              color: SIGNAL,
              transparent: true,
              opacity: 0.2,
              blending: THREE.AdditiveBlending,
              depthWrite: false,
            }),
          ),
        );
      }

      // ---------- interazione puntatore ----------
      const mouseNDC = new THREE.Vector2(0, 0);
      const pointerWorld = new THREE.Vector3(100, 0, 100);
      const raycaster = new THREE.Raycaster();
      const groundPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 1.46);

      let targetX = 0.5,
        targetY = 0.5,
        mouseX = 0.5,
        mouseY = 0.5;
      let pointerSpeed = 0,
        lastPX = 0,
        lastPY = 0;
      let hoverTurbine = 0;
      let rotorVelocity = 0.18;

      function onPointerMove(e: PointerEvent) {
        const rect = canvas.getBoundingClientRect();
        const localX = e.clientX - rect.left;
        const localY = e.clientY - rect.top;
        targetX = localX / rect.width;
        targetY = localY / rect.height;
        mouseNDC.x = targetX * 2 - 1;
        mouseNDC.y = -(targetY * 2 - 1);
        pointerSpeed = Math.min(1, Math.hypot(localX - lastPX, localY - lastPY) / 45);
        lastPX = localX;
        lastPY = localY;

        const dx = localX - rect.width * 0.72;
        const dy = localY - rect.height * 0.42;
        hoverTurbine = THREE.MathUtils.clamp(1 - Math.hypot(dx / 220, dy / 300), 0, 1);
      }
      function onPointerLeave() {
        targetX = 0.5;
        targetY = 0.5;
        hoverTurbine = 0;
      }
      addEventListener('pointermove', onPointerMove, { passive: true });
      addEventListener('pointerleave', onPointerLeave, { passive: true });

      // ---------- resize ----------
      function resize() {
        const rect = canvas.getBoundingClientRect();
        const w = Math.max(1, rect.width);
        const h = Math.max(1, rect.height);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setPixelRatio(Math.min(devicePixelRatio, isMobile ? 1.4 : 1.8));
        renderer.setSize(w, h, false);
      }
      const ro = new ResizeObserver(resize);
      ro.observe(canvas);
      resize();

      // ---------- pausa fuori schermo ----------
      let visible = true;
      if (section && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) visible = en.isIntersecting;
          },
          { threshold: 0 },
        );
        io.observe(section);
      }
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden && visible && !raf) tick();
      });

      // ---------- animazione ----------
      const startTime = performance.now();

      function tick() {
        raf = requestAnimationFrame(tick);
        if (document.hidden || !visible) {
          cancelAnimationFrame(raf);
          raf = 0;
          return;
        }
        const t = (performance.now() - startTime) / 1000;

        mouseX += (targetX - mouseX) * 0.055;
        mouseY += (targetY - mouseY) * 0.055;

        camera.position.x += (2.4 + (mouseX - 0.5) * 0.9 - camera.position.x) * 0.025;
        camera.position.y += (3.1 - (mouseY - 0.5) * 0.32 - camera.position.y) * 0.025;
        camera.lookAt(2.1 + (mouseX - 0.5) * 0.22, 2.68 - (mouseY - 0.5) * 0.12, 0);

        raycaster.setFromCamera(mouseNDC, camera);
        const hit = new THREE.Vector3();
        if (raycaster.ray.intersectPlane(groundPlane, hit)) {
          pointerWorld.lerp(hit, 0.12);
          terrainMat.uniforms.uMouse.value.copy(pointerWorld);
        }

        const targetSpeed = 0.2 + pointerSpeed * 0.2 + hoverTurbine * 0.055;
        rotorVelocity += (targetSpeed - rotorVelocity) * 0.035;
        rotor.rotation.z -= rotorVelocity * 0.016;
        pointerSpeed *= 0.9;

        const scale = 1 + hoverTurbine * 0.012 + Math.sin(t * 0.7) * 0.0015;
        turbine.scale.setScalar(scale);
        turbine.rotation.y = (mouseX - 0.5) * 0.055;
        turbine.rotation.x = (mouseY - 0.5) * 0.025;

        dustMat.uniforms.uTime.value = t;
        terrainMat.uniforms.uTime.value = t;
        mountainMat.uniforms.uTime.value = t;

        backGlow.material.opacity = 0.15 + 0.04 * Math.sin(t * 0.45) + hoverTurbine * 0.035;
        signalGlow.material.opacity = 0.06 + 0.025 * Math.sin(t * 0.63 + 1.1) + hoverTurbine * 0.045;

        circuitGroup.children.forEach((l) => {
          const line = l as THREE.Line;
          (line.material as THREE.LineBasicMaterial).opacity =
            0.06 + 0.09 * (0.5 + 0.5 * Math.sin(t * 1.1 + line.userData.phase));
        });

        sunCore.material.opacity = 0.8 + 0.08 * Math.sin(t * 0.5);
        sunHalo.material.opacity = 0.2 + 0.05 * Math.sin(t * 0.4 + 0.6);
        sun.position.y = 5.7 + Math.sin(t * 0.12) * 0.12;

        panels.forEach((p, i) => {
          const glowMat = p.children[1] as THREE.Points;
          (glowMat.material as THREE.PointsMaterial).opacity =
            0.7 + 0.25 * Math.sin(t * 0.9 + i * 0.7);
        });
        (wireLine.material as THREE.LineBasicMaterial).opacity = 0.22 + 0.14 * (0.5 + 0.5 * Math.sin(t * 1.6));

        // Strobo aeronautico: un lampo netto ogni ~2.2s, non un respiro sinusoidale.
        const beaconPhase = t % 2.2;
        const flash = beaconPhase < 0.35 ? Math.exp(-beaconPhase * 14) : 0;
        beacon.material.opacity = 0.15 + flash * 0.85;
        beaconHalo.material.opacity = flash * 0.85;

        renderer.render(scene, camera);

        if (!started) {
          started = true;
          canvas.classList.add('is-ready');
        }
      }
      tick();
    }

    function start() {
      if (renderer) return;
      init();
    }

    // Il fermo-immagine resta il paint LCP, ma non deve restare a schermo più
    // di un frame: si monta subito dopo il primo paint, non in idle (che con
    // il thread occupato da altro lavoro di pagina poteva slittare parecchio).
    requestAnimationFrame(() => requestAnimationFrame(start));
  }
</script>
