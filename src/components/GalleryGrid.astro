---
import type { CollectionEntry } from 'astro:content';
import GalleryItem from './GalleryItem.astro';
import WaveDivider from './WaveDivider.astro';

interface Props {
  entries: CollectionEntry<'progetti'>[];
}

const { entries } = Astro.props;

// Full-bleed (variant 'c') is reserved for entries flagged `full` — always a
// real photograph. Everything else alternates the two side-by-side layouts, so
// technical schematics never land in a full-bleed crop.
let sideCount = 0;
const variantFor = (entry: CollectionEntry<'progetti'>): 'a' | 'b' | 'c' => {
  if (entry.data.full) return 'c';
  return sideCount++ % 2 === 0 ? 'a' : 'b';
};
---

<div class="gallery-groups">
  {
    entries.map((entry, i) => (
      <>
        <div class="py-16 lg:py-24">
          <GalleryItem entry={entry} index={i} total={entries.length} variant={variantFor(entry)} />
        </div>
        {(i + 1) % 3 === 0 && i !== entries.length - 1 && (
          <div class="wrap">
            <WaveDivider tone="navy" />
          </div>
        )}
      </>
    ))
  }
</div>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealEls = Array.from(document.querySelectorAll<HTMLElement>('.gallery-reveal'));
  const reveal = (el: Element) => el.classList.add('is-visible');

  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    revealEls.forEach(reveal);
  } else {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            reveal(entry.target);
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
    );
    const vh = window.innerHeight || document.documentElement.clientHeight;
    revealEls.forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.top < vh * 0.96 && r.bottom > 0) reveal(el);
      else observer.observe(el);
    });
    window.addEventListener('load', () => window.setTimeout(() => revealEls.forEach(reveal), 800), {
      once: true,
    });
  }
</script>
