---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'progetti'>;
  index: number;
  /** Card sits on a dark overlay (variant C) vs. the normal light page background. */
  onDark?: boolean;
}

const { entry, index, onDark = false } = Astro.props;
const { titolo, kv, committente, provincia, tipologia } = entry.data;
const indexLabel = String(index + 1).padStart(2, '0');

// Hide fields still awaiting client confirmation rather than printing the marker.
const isPlaceholder = (v: string) => /da confermare/i.test(v);
const kvShown = kv && !isPlaceholder(kv);
const meta = [committente, provincia, tipologia].filter((v) => v && !isPlaceholder(v)).join(' · ');
---

<div class:list={['gallery-card', { 'gallery-card--dark': onDark }]}>
  <p class="gallery-card-index" aria-hidden="true">{indexLabel}</p>
  {kvShown && <span class="ds-chip-kv">{kv}</span>}
  <h3 class:list={['mt-3 font-display text-xl font-semibold tracking-tight', onDark ? 'text-paper' : 'text-ink']}>
    {titolo}
  </h3>
  <div class:list={['mt-2 text-sm leading-relaxed gallery-card-desc', onDark ? 'text-paper/80' : 'text-ink/75']}>
    <slot />
  </div>
  {
    meta && (
      <p class:list={['mt-4 text-xs tracking-wide', onDark ? 'text-paper/60' : 'text-ink/55']}>{meta}</p>
    )
  }
</div>

<style>
  .gallery-card-index {
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    color: var(--color-signal-400);
  }

  .gallery-card-desc :global(p) {
    margin: 0;
  }
</style>
