---
/**
 * Amon Energy brand — the official logo (monogram + "AMON ENERGY" wordmark),
 * white version for the dark surfaces used across the site (header, footer,
 * mobile nav). `variant="mark"` shows the leaf-A monogram alone.
 */
import { Image } from 'astro:assets';
import logoWhite from '../assets/img/brand/logo-amon-white.png';
import markWhite from '../assets/img/brand/mark-amon-white.png';

interface Props {
  /** 'full' = monogram + wordmark; 'mark' = monogram only. */
  variant?: 'full' | 'mark';
  /** Logo height in px (width scales proportionally). */
  size?: number;
  class?: string;
  /** 'eager' for the header (above the fold everywhere); footer stays 'lazy'. */
  loading?: 'eager' | 'lazy';
}

const { variant = 'full', size = 34, class: className = '', loading = 'lazy' } = Astro.props;

const fullRatio = logoWhite.width / logoWhite.height;
const cssWidth = Math.ceil(size * (variant === 'full' ? fullRatio : 1));
---

{
  variant === 'full' ? (
    <Image
      src={logoWhite}
      alt="Amon Energy"
      widths={[200, 400, 750]}
      sizes={`${cssWidth}px`}
      style={`--logo-h:${size}px`}
      class:list={['amon-logo', className]}
      loading={loading}
    />
  ) : (
    <Image
      src={markWhite}
      alt="Amon Energy"
      widths={[68, 136, 250]}
      sizes={`${size}px`}
      style={`--logo-h:${size}px`}
      class:list={['amon-logo', className]}
      loading={loading}
    />
  )
}

<style>
  .amon-logo {
    display: block;
    height: var(--logo-h);
    width: auto;
  }
</style>
