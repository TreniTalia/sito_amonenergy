---
import { clienti } from '../data/clienti.ts';
import { t as testiUi } from '../i18n/ui.ts';
import type { Lingua } from '../i18n/routes.ts';

interface Props {
  titolo: string;
  lingua?: Lingua;
}

const { titolo, lingua = 'it' } = Astro.props;
const prefissoAria = testiUi(lingua).a11y.clientiAriaPrefisso;
---

<section class="bg-paper border-y border-navy-100 py-12 lg:py-16 overflow-hidden">
  <p class="wrap ds-eyebrow-label" style="color: var(--color-navy-700); margin-bottom: 1.5rem;">{titolo}</p>
  <div class="marquee-track flex items-center gap-16" aria-label={`${prefissoAria}: ${clienti.join(', ')}`}>
    {
      [0, 1].map((rep) => (
        <div class="flex items-center gap-16 shrink-0" aria-hidden={rep === 1}>
          {clienti.map((nome) => (
            <span class="marquee-word whitespace-nowrap">
              {nome}
            </span>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  /* I nomi cliente scorrevoli non sono titoli: prima portavano `.text-headline`
     con un `font-size` inline che ne annullava la scala fluida, quindi la
     stessa classe rendeva a 24px qui e a 48px nelle sezioni — due misure per
     una classe sola. Qui hanno una voce propria, costruita sugli stessi assi
     dei display (Archivo Expanded) ma sulla scala del titolo di card. */
  .marquee-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 125%;
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    letter-spacing: -0.015em;
    color: var(--color-navy-700);
    /* 0,8 e non 0,6: a 0,6 i nomi stavano sotto il contrasto AA. */
    opacity: 0.8;
  }

  .marquee-track {
    width: max-content;
    animation: marquee-scroll 36s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
    }
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
