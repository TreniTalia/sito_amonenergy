---
interface StatItem {
  valore: string;
  label: string;
  finto: boolean;
}

interface Props {
  items: StatItem[];
  /** Optional small source/eyebrow line shown above the numbers. */
  nota?: string;
}

const { items, nota } = Astro.props;

const parsed = items.map((item) => {
  const match = item.valore.match(/^(\d+)(.*)$/);
  return {
    ...item,
    numero: match ? match[1] : '',
    suffisso: match ? match[2] : item.valore,
  };
});
---

<section class="stat-bar relative isolate overflow-hidden bg-navy-950 text-paper">
  <div class="stat-bar-glow" aria-hidden="true"></div>
  <div class="wrap-wide relative z-10 py-16 lg:py-24">
    {
      nota && (
        <p class="mb-10 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-paper/55">
          <span class="ds-eyebrow-dash" />
          {nota}
        </p>
      )
    }
    <div class="grid grid-cols-2 gap-x-8 gap-y-12 md:grid-cols-4 lg:gap-x-12">
      {
        parsed.map((item, i) => (
          <div data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <span class="stat-dash mb-4 block h-[3px] w-10 rounded-full bg-signal-400" aria-hidden="true" />
            <p
              class="stat-value tnum text-display leading-none"
              style="font-size: clamp(2.6rem, 1.4rem + 3vw, 4.25rem); font-stretch: 125%; font-weight: 800;"
              data-numero={item.numero}
              data-suffisso={item.suffisso}
            >
              {item.numero ? '0' : ''}
              {item.suffisso}
            </p>
            <p class="mt-3 max-w-[22ch] text-sm leading-snug text-paper/70">
              {item.label}
              {item.finto && <Fragment set:html="<!-- DATO-FINTO -->" />}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Stessa profondità della fascia Control Room (radial glow in navy), a
     intensità più bassa: la fascia numeri non deve competere con quella. */
  .stat-bar-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55% 70% at 85% 0%, color-mix(in srgb, var(--color-navy-700) 40%, transparent), transparent 70%),
      radial-gradient(45% 60% at 5% 100%, color-mix(in srgb, var(--color-navy-800) 45%, transparent), transparent 70%);
    z-index: 0;
  }
  .stat-dash {
    box-shadow: var(--glow-signal);
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const values = document.querySelectorAll<HTMLElement>('.stat-value');

  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.numero);
    const suffix = el.dataset.suffisso ?? '';
    if (!target || prefersReducedMotion) {
      el.textContent = `${el.dataset.numero ?? ''}${suffix}`;
      return;
    }
    const duration = 1600;
    const start = performance.now();
    const step = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 4);
      el.textContent = `${Math.round(target * eased)}${suffix}`;
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  const observer = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animate(entry.target as HTMLElement);
          obs.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.4 },
  );

  values.forEach((el) => {
    if (el.dataset.numero) observer.observe(el);
  });
</script>
