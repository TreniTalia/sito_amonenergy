---
import { Icon } from 'astro-icon/components';
import PackIcon from './PackIcon.astro';
import GlassSvgIcon from './GlassSvgIcon.astro';

interface Props {
  titolo: string;
  excerpt: string;
  icona: string;
  href: string;
  /** 1-based position, shown as a quiet index. */
  index?: number;
  /** Accent color role for the icon. */
  accent?: 'leaf' | 'signal';
  /**
   * Stronger card treatment (solid paper background, top accent bar, bigger
   * icon chip) for sections where the default glass-on-white card reads as
   * too faint. Additive-only: the base `.ds-card-service` look is untouched,
   * so pages that don't opt in (`/servizi/`) are unaffected.
   */
  elevated?: boolean;
  /** Text of the closing link — 'Approfondisci' fits a detail page, but a
   * card with no page to link to (e.g. a call-to-contact) needs its own
   * wording. */
  ctaLabel?: string;
}

const { titolo, excerpt, icona, href, index, accent = 'leaf', elevated = false, ctaLabel = 'Approfondisci' } = Astro.props;
const accentColor = accent === 'signal' ? 'var(--color-signal-400)' : 'var(--color-green-500)';
---

<a
  href={href}
  class:list={['ds-card-service group relative flex flex-col no-underline', elevated && 'ds-card-service--elevated']}
>
  <div class="flex items-start justify-between">
    <span class="glass-icon" style={`--accent: ${accentColor};`}>
      {
        icona.startsWith('glass-png:') ? (
          <PackIcon name={icona.replace('glass-png:', '')} class="text-[1.4rem]" />
        ) : icona.startsWith('glass-svg:') ? (
          <GlassSvgIcon name={icona.replace('glass-svg:', '')} class="text-[1.4rem]" />
        ) : (
          <Icon name={icona} class="text-[1.4rem]" />
        )
      }
    </span>
    {
      index !== undefined && (
        <span class:list={['tnum font-display text-sm font-semibold', elevated ? 'text-paper/45' : 'text-navy-300']}>
          {String(index).padStart(2, '0')}
        </span>
      )
    }
  </div>
  <div class="mt-6">
    <h3 class:list={['font-display text-lg font-bold tracking-tight', elevated ? 'text-paper' : 'text-ink']}>{titolo}</h3>
    <p class:list={['mt-2.5 text-sm leading-relaxed', elevated ? 'text-paper/80' : 'text-ink/70']}>{excerpt}</p>
  </div>
  <span class:list={['mt-6 inline-flex items-center gap-2 text-sm font-semibold', elevated ? 'text-paper' : 'text-navy-900']}>
    {ctaLabel}
    <Icon
      name="fa6-solid:arrow-right"
      class="text-xs transition-transform duration-300 group-hover:translate-x-1"
      style="transition-timing-function: var(--ease-signature);"
    />
  </span>
</a>
