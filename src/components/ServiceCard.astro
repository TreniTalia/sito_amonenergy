---
import { Icon } from 'astro-icon/components';

interface Props {
  titolo: string;
  excerpt: string;
  icona: string;
  href: string;
  /** 1-based position, shown as a quiet index. */
  index?: number;
  /** Accent color role for the icon. */
  accent?: 'leaf' | 'signal';
}

const { titolo, excerpt, icona, href, index, accent = 'leaf' } = Astro.props;
const accentColor = accent === 'signal' ? 'var(--color-signal-400)' : 'var(--color-green-500)';
---

<a href={href} class="ds-card-service group relative flex flex-col no-underline">
  <div class="flex items-center justify-between">
    <Icon name={icona} width={30} height={30} style={`color: ${accentColor};`} />
    {
      index !== undefined && (
        <span class="tnum font-display text-sm font-semibold text-navy-300">
          {String(index).padStart(2, '0')}
        </span>
      )
    }
  </div>
  <div class="mt-6">
    <h3 class="font-display text-lg font-bold tracking-tight text-ink">{titolo}</h3>
    <p class="mt-2.5 text-sm leading-relaxed text-ink/70">{excerpt}</p>
  </div>
  <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-navy-900">
    Approfondisci
    <svg
      class="transition-transform duration-300 group-hover:translate-x-1"
      style="transition-timing-function: var(--ease-signature);"
      width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
    >
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  </span>
</a>
