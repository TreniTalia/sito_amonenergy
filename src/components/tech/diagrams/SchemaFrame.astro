---
/**
 * Telaio per gli schemi a blocchi (catene RCS/A.72/contatori, PF1/PF2 del
 * CCI, sagoma del trasformatore): stesso fondo, trama e cornice dei grafici a
 * dati, tramite il telaio comune `FrameChrome` in modalità 'html'. Il
 * contenuto è HTML/CSS reale (box, frecce, liste), non SVG a coordinate
 * fisse: va a capo da solo e non ha bisogno di una tela di dimensione fissa
 * quando il contenuto è più corto o più lungo del previsto.
 */
import FrameChrome from '../charts/FrameChrome.astro';

interface Props {
  ariaLabel: string;
  didascalia: string;
  didascaliaSub: string;
}
const { ariaLabel, didascalia, didascaliaSub } = Astro.props;
---

<FrameChrome ariaLabel={ariaLabel} didascalia={didascalia} didascaliaSub={didascaliaSub} figureClass="schema" mode="html">
  <slot />
</FrameChrome>
