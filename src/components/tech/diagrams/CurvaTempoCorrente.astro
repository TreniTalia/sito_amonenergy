---
/**
 * Diagramma tempo-corrente per la verifica delle protezioni AT/MT.
 *
 * Stessa lingua grafica delle altre diagnostiche, qui sul telaio condiviso
 * `ChartFrame`: fondo navy, reticolo a puntini, cornice con tacche d'angolo.
 * Il contenuto è la caratteristica calcolata dal modello di
 * `charts/models/iec60255.ts`: soglia selettiva I> a tempo inverso secondo la
 * curva "standard inverse" della IEC 60255-151, tagliata alle correnti di
 * cortocircuito dalla soglia di massima corrente I>> a tempo definito. I
 * punti verdi sono le iniezioni di prova ai multipli canonici della soglia,
 * con il tempo cronometrato che si discosta di pochi punti percentuali dalla
 * curva teorica, come in un referto reale di verifica con DRTS/64 o ISA CBA
 * 1000.
 */
import type { Lingua } from '../../../i18n/routes.ts';
import ChartFrame from '../charts/ChartFrame.astro';
import { tempoIntervento, TARATURA_ESEMPIO, PUNTI_PROVA } from '../charts/models/iec60255.ts';
import { logspace } from '../charts/models/scale.ts';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;

// Formattazione dei decimali secondo la lingua: virgola in italiano, punto in
// inglese.
const num = (v: number) => (lingua === 'it' ? String(v).replace('.', ',') : String(v));

const TESTI = {
  it: {
    ariaLabel:
      'Diagramma tempo-corrente su assi logaritmici: la soglia selettiva I> a tempo inverso secondo la IEC 60255-151, con il tempo di intervento che scende al crescere della corrente, tagliata alle correnti più alte dalla soglia di massima corrente I>> a tempo definito. Punti verdi segnano le correnti di prova iniettate e i tempi di intervento misurati, vicini alla curva teorica.',
    caption: 'Verifica della curva di intervento',
    captionSub: 'Curva calcolata da modello · IEC 60255-151 standard inverse, Is 400 A, TMS 0,1, I>> 4 kA',
    legendaCurva: 'Caratteristica I> tempo inverso',
    legendaSoglia: 'Soglia I>> tempo definito',
    legendaPunti: 'Punti di prova',
  },
  en: {
    ariaLabel:
      'Time-current diagram on logarithmic axes: the selective threshold I> at inverse time under IEC 60255-151, with tripping time falling as current rises, cut off at higher currents by the definite-time overcurrent threshold I>>. Green points mark the injected test currents and the measured tripping times, close to the theoretical curve.',
    caption: 'Tripping curve verification',
    captionSub: 'Computed from a model · IEC 60255-151 standard inverse, Is 400 A, TMS 0.1, I>> 4 kA',
    legendaCurva: 'I> inverse-time curve',
    legendaSoglia: 'I>> definite-time threshold',
    legendaPunti: 'Test points',
  },
} as const;

const t = TESTI[lingua];

const I = logspace(420, 20000, 300);
const curva = I.map((i) => [i, Math.min(100, tempoIntervento(i, TARATURA_ESEMPIO))] as [number, number]);
const soglia = [[4000, 0.05], [20000, 0.05]] as [number, number][];
const punti = PUNTI_PROVA.map((p) => [p.I, p.t] as [number, number]);
---

<ChartFrame
  uid="tcc"
  ariaLabel={t.ariaLabel}
  x={{
    scala: { tipo: 'log', min: 100, max: 20000 },
    // Unità vuota: ogni tacca porta già la propria ("100 A", "20 kA"), una
    // "A" separata sarebbe ridondante e a 390px finirebbe per toccare
    // l'ultima tacca.
    unita: '',
    tacche: [
      { v: 100, t: '100 A' },
      { v: 1000, t: '1 kA' },
      { v: 10000, t: '10 kA', minore: true },
      { v: 20000, t: '20 kA' },
    ],
  }}
  y={{
    scala: { tipo: 'log', min: 0.01, max: 100 },
    // Idem: ogni tacca porta già la "s" ("0,01 s" … "100 s").
    unita: '',
    tacche: [0.01, 0.1, 1, 10, 100].map((v) => ({ v, t: `${num(v)} s` })),
  }}
  serie={[
    { tipo: 'line', punti: curva, colore: '#bcd6e8', spessore: 1.8, legenda: t.legendaCurva },
    { tipo: 'line', punti: soglia, colore: '#4fd07f', spessore: 1.8, legenda: t.legendaSoglia },
    { tipo: 'scatter', punti: punti, colore: '#4fd07f', raggio: 4, opacita: 1, legenda: t.legendaPunti },
  ]}
  didascalia={t.caption}
  didascaliaSub={t.captionSub}
/>
