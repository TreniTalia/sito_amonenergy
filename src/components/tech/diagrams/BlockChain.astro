---
/**
 * Griglia HTML/CSS per gli schemi a catena orizzontale (RCS, A.72, lettura
 * contatori): fino a 4 box, quattro colonne da 768px in su, una sola colonna
 * (impilati) sotto i 768px, con le frecce che passano da orizzontali a
 * verticali.
 *
 * Fix round 1: la versione precedente disegnava tutto in SVG a coordinate
 * fisse, con la larghezza delle righe stimata a build time (`righe.ts`) —
 * una stima, non una misura, che a certe combinazioni di lingua/larghezza
 * sbagliava e faceva uscire il testo dal box ("Protezione di interfaccia"
 * nel teledistacco A.72, tagli di parole altrove). Qui i box sono elementi
 * HTML reali: il testo va a capo secondo le regole normali del flusso e non
 * può mai uscire dal proprio riquadro, perché è il riquadro a crescere con
 * lui. Le dimensioni dei testi sono quelle del sistema di design
 * (`--fs-small`/`--fs-micro`), non stimate: niente più corse a chi arriva
 * primo fra dimensione mobile e reale.
 */
interface Blocco {
  t1: string;
  t2: string;
  accento?: boolean;
}
interface Props {
  uid: string;
  blocchi: Blocco[];
  sopra?: { etichetta: string };
  sotto?: { etichetta: string; evidenza?: string };
  unica?: { etichetta: string };
}
const { uid, blocchi, sopra, sotto, unica } = Astro.props;
---

<div class="chain" id={`chain-${uid}`}>
  {sopra && (
    <div class="chain__lane chain__lane--sopra">
      <span class="chain__lane-label">{sopra.etichetta}</span>
      <span class="chain__lane-line" aria-hidden="true"></span>
    </div>
  )}

  {unica && <p class="chain__lane-label chain__lane-label--unica">{unica.etichetta}</p>}

  <div class:list={['chain__boxes', { 'chain__boxes--unica': !!unica }]}>
    {
      blocchi.map((b, i) => (
        <>
          <div class="chain__box" data-schema-box class:list={{ 'chain__box--accento': b.accento }}>
            <p class="chain__box-title">{b.t1}</p>
            <p class="chain__box-sub">{b.t2}</p>
          </div>
          {unica && i < blocchi.length - 1 && (
            <span class="chain__connector" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M4 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          )}
        </>
      ))
    }
  </div>

  {sotto && (
    <div class="chain__lane chain__lane--sotto">
      {sotto.evidenza && <span class="chain__lane-evidenza">{sotto.evidenza}</span>}
      <span class="chain__lane-line" aria-hidden="true"></span>
      <span class="chain__lane-label">{sotto.etichetta}</span>
    </div>
  )}
</div>

<style>
  .chain {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    color: #e7f0f7;
  }

  /* Griglia: 4 colonne da 768px, una sola sotto. Con `unica` (contatori) le
     colonne aggiuntive "auto" ospitano le frecce fra un box e l'altro, senza
     bisogno di misurarne la posizione via JS: sono semplicemente altre
     colonne della stessa griglia. */
  .chain__boxes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
  }
  .chain__boxes--unica {
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
  }

  .chain__box {
    background: #0f3656;
    border: 1.4px solid rgba(107, 167, 210, 0.55);
    border-radius: 10px;
    padding: 0.85rem 0.9rem;
    text-align: center;
  }
  .chain__box--accento {
    background: #123a5e;
    border-color: #4fd07f;
    border-width: 1.6px;
  }
  .chain__box-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-small);
    line-height: 1.25;
  }
  .chain__box--accento .chain__box-title {
    color: #8fd9ab;
  }
  .chain__box-sub {
    margin: 0.25rem 0 0;
    font-size: var(--fs-micro);
    line-height: 1.35;
    color: #bcd6e8;
    opacity: 0.85;
  }

  .chain__lane {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .chain__lane-label,
  .chain__lane-evidenza {
    flex: none;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.6875rem;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .chain__lane--sopra .chain__lane-label {
    color: #8fbfe0;
  }
  .chain__lane--sotto .chain__lane-label,
  .chain__lane--sotto .chain__lane-evidenza,
  .chain__lane-label--unica {
    color: #8fd9ab;
  }
  .chain__lane-label--unica {
    margin: 0;
  }

  /* Linea di corsia con freccia: un bordo triangolare CSS all'estremità,
     niente marker SVG (non serve più un `<marker>` condiviso). */
  .chain__lane-line {
    position: relative;
    flex: 1 1 auto;
    min-width: 1.5rem;
    height: 2px;
    border-radius: 1px;
  }
  .chain__lane--sopra .chain__lane-line {
    background: #6ba7d2;
  }
  .chain__lane--sopra .chain__lane-line::after {
    content: '';
    position: absolute;
    right: -1px;
    top: 50%;
    translate: 0 -50%;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 7px solid #6ba7d2;
  }
  .chain__lane--sotto .chain__lane-line {
    background: #4fd07f;
  }
  .chain__lane--sotto .chain__lane-line::after {
    content: '';
    position: absolute;
    left: -1px;
    top: 50%;
    translate: 0 -50%;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-right: 7px solid #4fd07f;
  }

  .chain__connector {
    display: flex;
    justify-self: center;
    width: 1.4rem;
    height: 1.4rem;
    color: #4fd07f;
  }
  .chain__connector svg {
    width: 100%;
    height: 100%;
  }

  /* Sotto i 768px la griglia diventa una sola colonna: i box si impilano
     nell'ordine della catena, e la freccia fra un box e l'altro (solo per
     `unica`) ruota di 90° per restare coerente col nuovo verso verticale. */
  @media (max-width: 767px) {
    .chain__boxes {
      grid-template-columns: 1fr;
    }
    .chain__connector {
      transform: rotate(90deg);
    }
  }
</style>
