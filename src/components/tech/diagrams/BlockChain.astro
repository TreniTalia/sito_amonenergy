---
/**
 * Griglia HTML/CSS per gli schemi a catena orizzontale (RCS, A.72, lettura
 * contatori): 4 box. La disposizione dipende dalla larghezza della figura,
 * non della finestra (container query sul contenitore `telaio` di
 * `FrameChrome`): da 1024px la figura sta in una colonna stretta accanto al
 * testo, larga meno che su un tablet in verticale, e una regola sulla
 * viewport vi metterebbe quattro colonne da 80px. Quattro colonne quando la
 * figura è larga almeno 46rem; sotto, le catene a due corsie vanno su due
 * righe da due box (la corsia sopra e quella sotto restano ai due lati della
 * griglia) e la catena a corsia unica si impila in verticale, con le frecce
 * ruotate. Sotto i 24rem anche le catene a due corsie si impilano.
 *
 * I box sono elementi HTML reali: il testo va a capo secondo le regole
 * normali del flusso e non può mai uscire dal proprio riquadro, perché è il
 * riquadro a crescere con lui. Le dimensioni dei testi sono quelle del
 * sistema di design (`--fs-small`/`--fs-micro`), le stesse a qualunque
 * larghezza e in qualunque lingua.
 */
interface Blocco {
  t1: string;
  t2: string;
  accento?: boolean;
}
interface Props {
  blocchi: Blocco[];
  sopra?: { etichetta: string };
  sotto?: { etichetta: string; evidenza?: string };
  unica?: { etichetta: string };
}
const { blocchi, sopra, sotto, unica } = Astro.props;
---

<div class="chain">
  {sopra && (
    <div class="chain__lane chain__lane--sopra">
      <span class="chain__lane-label">{sopra.etichetta}</span>
      <span class="chain__lane-line" aria-hidden="true"></span>
    </div>
  )}

  {unica && <p class="chain__lane-label chain__lane-label--unica">{unica.etichetta}</p>}

  <div class:list={['chain__boxes', { 'chain__boxes--unica': !!unica }]}>
    {
      blocchi.map((b, i) => (
        <>
          <div class="chain__box" data-schema-box class:list={{ 'chain__box--accento': b.accento }}>
            <p class="chain__box-title">{b.t1}</p>
            <p class="chain__box-sub">{b.t2}</p>
          </div>
          {unica && i < blocchi.length - 1 && (
            <span class="chain__connector" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M4 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          )}
        </>
      ))
    }
  </div>

  {sotto && (
    <div class="chain__lane chain__lane--sotto">
      {sotto.evidenza && <span class="chain__lane-evidenza">{sotto.evidenza}</span>}
      <span class="chain__lane-line" aria-hidden="true"></span>
      <span class="chain__lane-label">{sotto.etichetta}</span>
    </div>
  )}
</div>

<style>
  .chain {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    color: #e7f0f7;
  }

  /* Griglia a una colonna di partenza: i box si impilano nell'ordine della
     catena. Le soglie più larghe sono in fondo al file. */
  .chain__boxes {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  .chain__box {
    /* Un box è un elemento di griglia sull'asse principale: senza
       `min-width: 0` il suo minimo implicito è la larghezza del contenuto
       più lungo, e una parola senza spazi (un refuso, un termine tecnico non
       tradotto) allargherebbe la colonna invece di andare a capo. */
    min-width: 0;
    background: #0f3656;
    border: 1.4px solid rgba(107, 167, 210, 0.55);
    border-radius: 10px;
    padding: 0.85rem 0.9rem;
    text-align: center;
  }
  .chain__box--accento {
    background: #123a5e;
    border-color: #4fd07f;
    border-width: 1.6px;
  }
  .chain__box-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-small);
    line-height: 1.25;
    /* `break-word`, non `anywhere`: spezza una parola solo se da sola non
       sta nella riga, e non riduce la larghezza minima del box fino a una
       lettera (con `anywhere` la griglia stringeva le colonne e i titoli si
       spezzavano a metà parola anche dove c'era spazio). */
    overflow-wrap: break-word;
  }
  .chain__box--accento .chain__box-title {
    color: #8fd9ab;
  }
  .chain__box-sub {
    margin: 0.25rem 0 0;
    font-size: var(--fs-micro);
    line-height: 1.35;
    color: #bcd6e8;
    opacity: 0.85;
    overflow-wrap: break-word;
  }

  /* Le etichette di corsia possono andare a capo: in una figura stretta
     «RICHIUSURA AUTOMATICA» più «COMANDO» su una sola riga sono più larghi
     del telaio, e un'etichetta che non si piega allarga la figura oltre la
     pagina. */
  .chain__lane {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
  }
  .chain__lane-label,
  .chain__lane-evidenza {
    flex: 0 1 auto;
    min-width: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.6875rem;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }
  .chain__lane--sopra .chain__lane-label {
    color: #8fbfe0;
  }
  .chain__lane--sotto .chain__lane-label,
  .chain__lane--sotto .chain__lane-evidenza,
  .chain__lane-label--unica {
    color: #8fd9ab;
  }
  .chain__lane-label--unica {
    margin: 0;
  }

  /* Linea di corsia con freccia: un bordo triangolare CSS all'estremità,
     niente marker SVG (non serve più un `<marker>` condiviso). */
  .chain__lane-line {
    position: relative;
    flex: 1 1 auto;
    min-width: 1.5rem;
    height: 2px;
    border-radius: 1px;
  }
  .chain__lane--sopra .chain__lane-line {
    background: #6ba7d2;
  }
  .chain__lane--sopra .chain__lane-line::after {
    content: '';
    position: absolute;
    right: -1px;
    top: 50%;
    translate: 0 -50%;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 7px solid #6ba7d2;
  }
  .chain__lane--sotto .chain__lane-line {
    background: #4fd07f;
  }
  .chain__lane--sotto .chain__lane-line::after {
    content: '';
    position: absolute;
    left: -1px;
    top: 50%;
    translate: 0 -50%;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-right: 7px solid #4fd07f;
  }

  .chain__connector {
    display: flex;
    justify-self: center;
    width: 1.4rem;
    height: 1.4rem;
    color: #4fd07f;
  }
  .chain__connector svg {
    width: 100%;
    height: 100%;
  }

  /* Nella griglia impilata la freccia fra un box e l'altro (solo per
     `unica`) ruota di 90° per seguire il verso verticale della catena. */
  .chain__connector {
    transform: rotate(90deg);
  }

  /* Figura stretta: l'evidenza della corsia di comando passa su una riga
     sua, sopra la linea e l'etichetta, invece di contendere loro lo spazio. */
  @container telaio (width < 24rem) {
    .chain__lane-evidenza {
      flex-basis: 100%;
    }
  }

  /* Da 24rem le catene a due corsie vanno su due righe da due box: ogni box
     ha così almeno 160px, abbastanza per le parole più lunghe dei titoli
     («Collegamento», «Integrazione») in una riga sola. La catena a corsia
     unica resta impilata: su due righe le sue frecce non avrebbero più un
     verso leggibile. */
  @container telaio (min-width: 24rem) {
    .chain__boxes:not(.chain__boxes--unica) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Da 46rem la catena sta su una riga sola, quattro box affiancati. Con
     `unica` (contatori) le colonne aggiuntive "auto" ospitano le frecce fra
     un box e l'altro, senza bisogno di misurarne la posizione via JS: sono
     semplicemente altre colonne della stessa griglia. */
  @container telaio (min-width: 46rem) {
    .chain__boxes:not(.chain__boxes--unica) {
      grid-template-columns: repeat(4, 1fr);
    }
    .chain__boxes--unica {
      grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
      align-items: center;
    }
    .chain__connector {
      transform: none;
    }
  }
</style>
