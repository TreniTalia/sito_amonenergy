---
/**
 * Diagramma PRPD (phase-resolved partial discharge) delle misure di scariche
 * parziali.
 *
 * Stessa lingua grafica delle altre diagnostiche, ora sul telaio condiviso
 * `ChartFrame`: fondo navy, reticolo a puntini, cornice con tacche d'angolo.
 * Il contenuto è quello che restituisce davvero uno strumento come il
 * b2 HVA68TD+PD: ogni punto è un impulso di scarica, in ascissa la fase della
 * tensione di prova a cui è comparso, in ordinata la sua carica apparente in
 * picocoulomb secondo il metodo convenzionale della IEC 60270. La nuvola di
 * `charts/models/prpd.ts` è quella di una cavità interna all'isolante: scarica
 * sui fronti di salita delle due semionde, con due "orecchie" quasi
 * simmetriche (la negativa un po' più alta, come si vede di solito), non a
 * caso su tutta la fase. La sinusoide di riferimento è la tensione di prova
 * stessa, sull'asse destro in kV: è quella che fissa la fase, non un dato in
 * pC.
 */
import type { Lingua } from '../../../i18n/routes.ts';
import ChartFrame from '../charts/ChartFrame.astro';
import { nuvolaPrpd, tensioneProva } from '../charts/models/prpd.ts';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;

const TESTI = {
  it: {
    ariaLabel:
      'Diagramma PRPD delle misure di scariche parziali: fase della tensione di prova in ascissa, carica apparente in picocoulomb in ordinata. Gli impulsi di una cavità interna all\'isolante si addensano in due nuvole sui fronti di salita delle due semionde della tensione, una attorno ai 45 gradi e una, leggermente più intensa, attorno ai 225 gradi.',
    legendaNuvola: 'Impulsi di scarica',
    legendaSinusoide: 'Tensione di prova',
    caption: 'Impulsi di scarica per fase della tensione',
    captionSub: 'Calcolato da modello · cavità interna, carica apparente in pC secondo IEC 60270',
  },
  en: {
    ariaLabel:
      'PRPD chart of partial discharge measurements: phase of the test voltage on the horizontal axis, apparent charge in picocoulombs on the vertical axis. Pulses from an internal void in the insulation cluster in two clouds on the rising fronts of the two voltage half cycles, one around 45 degrees and one, slightly stronger, around 225 degrees.',
    legendaNuvola: 'Discharge pulses',
    legendaSinusoide: 'Test voltage',
    caption: 'Discharge pulses by voltage phase',
    captionSub: 'Computed from a model · internal void, apparent charge in pC under IEC 60270',
  },
} as const;

const t = TESTI[lingua];

const nuvola = nuvolaPrpd(7, 900).map((p) => [p.fase, p.pC] as [number, number]);
const sinusoide = Array.from({ length: 181 }, (_, i) => [i * 2, tensioneProva(i * 2, 12)] as [number, number]);
---

<ChartFrame
  uid="prpd"
  ariaLabel={t.ariaLabel}
  x={{
    scala: { tipo: 'lin', min: 0, max: 360 },
    unita: '°',
    tacche: [0, 90, 180, 270, 360].map((v) => ({ v, t: `${v}°` })),
  }}
  y={{
    scala: { tipo: 'lin', min: 0, max: 100 },
    unita: 'pC',
    tacche: [0, 25, 50, 75, 100].map((v) => ({ v, t: String(v) })),
  }}
  y2={{
    scala: { tipo: 'lin', min: -15, max: 15 },
    unita: 'kV',
    tacche: [-15, 0, 15].map((v) => ({ v, t: String(v) })),
  }}
  serie={[
    { tipo: 'scatter', punti: nuvola, colore: '#4fd07f', raggio: 1.8, opacita: 0.5, legenda: t.legendaNuvola },
    { tipo: 'line', punti: sinusoide, colore: '#bcd6e8', spessore: 1.4, opacita: 0.8, asse: 'y2', legenda: t.legendaSinusoide },
  ]}
  didascalia={t.caption}
  didascaliaSub={t.captionSub}
/>
