---
/**
 * Diagramma a due colonne per il Controllore Centrale d'Impianto (CCI).
 *
 * Non una misura, un confronto fra due funzioni: PF1 osservabilità (il CCI
 * legge lo stato dell'impianto) e PF2 controllabilità (limitazione della
 * potenza attiva su comando del distributore). Ogni colonna è tre box in
 * verticale — sorgente del dato o del comando, il CCI al centro, l'impianto —
 * con il verso della freccia che distingue lettura da comando. In basso il
 * riferimento normativo comune, confermato dal cliente: CEI 0-16 V5 e la
 * Delibera ARERA 564/2025/R/eel.
 *
 * HTML/CSS reale: le due colonne sono `<div>` in un flusso normale, che si
 * dimensionano sul proprio contenuto invece che su coordinate assolute — un
 * titolo più alto del previsto si fa semplicemente spazio, non viene tagliato
 * dal bordo del box sottostante. Affiancate quando la figura è larga almeno
 * 25rem, impilate sotto, dentro lo stesso telaio `SchemaFrame`: la soglia
 * guarda la figura (contenitore `telaio`), non la finestra, perché da 1024px
 * la figura sta in una colonna stretta accanto al testo.
 */
import type { Lingua } from '../../../i18n/routes.ts';
import SchemaFrame from './SchemaFrame.astro';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;

const TESTI = {
  it: {
    ariaLabel:
      'Due colonne verticali. A sinistra PF1, osservabilità: lo stato dell\'impianto sale dall\'impianto al CCI, che lo rende leggibile al distributore. A destra PF2, controllabilità: il comando di limitazione della potenza attiva scende dal distributore, passa per il CCI e raggiunge l\'impianto. In basso il riferimento comune, CEI 0-16 V5 e Delibera ARERA 564/2025/R/eel.',
    pf1: 'PF1 · Osservabilità',
    pf2: 'PF2 · Controllabilità',
    distributore: 'Distributore',
    impianto: 'Impianto',
    riferimento: 'CEI 0-16 V5 · Delibera ARERA 564/2025/R/eel',
    caption: 'Due funzioni, due versi opposti',
    captionSub: 'Schema esemplificativo · PF1 osservabilità e PF2 controllabilità secondo CEI 0-16 V5',
  },
  en: {
    ariaLabel:
      "Two vertical columns. On the left, PF1, observability: the plant's status rises from the plant to the CCI, which makes it readable to the distributor. On the right, PF2, controllability: the active power curtailment command comes down from the distributor, passes through the CCI and reaches the plant. At the bottom, the shared reference, CEI 0-16 V5 and Delibera ARERA 564/2025/R/eel.",
    pf1: 'PF1 · Observability',
    pf2: 'PF2 · Controllability',
    distributore: 'Distributor',
    impianto: 'Plant',
    riferimento: 'CEI 0-16 V5 · Delibera ARERA 564/2025/R/eel',
    caption: 'Two functions, two opposite directions',
    captionSub: 'Sample diagram · PF1 observability and PF2 controllability under CEI 0-16 V5',
  },
} as const;

const t = TESTI[lingua];

// Le frecce sono un piccolo SVG per verso (su per PF1, giù per PF2): non
// serve più un `<marker>` condiviso, ogni colonna disegna la propria.
const FRECCIA = {
  up: 'M12 20V7M6 11l6-6 6 6',
  down: 'M12 4v13M6 13l6 6 6-6',
} as const;

const colonne = [
  { colore: 'blue', titolo: t.pf1, direzione: 'up' as const },
  { colore: 'green', titolo: t.pf2, direzione: 'down' as const },
] as const;
---

<SchemaFrame ariaLabel={t.ariaLabel} didascalia={t.caption} didascaliaSub={t.captionSub}>
  <div class="occ">
    {
      colonne.map((col) => (
        <div class:list={['occ__col', `occ__col--${col.colore}`]}>
          <p class="occ__title">{col.titolo}</p>
          <div class="occ__box" data-schema-box>
            <p class="occ__box-title">{t.distributore}</p>
          </div>
          <span class="occ__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d={FRECCIA[col.direzione]} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <div class="occ__box occ__box--cci" data-schema-box>
            <p class="occ__box-title">CCI</p>
          </div>
          <span class="occ__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d={FRECCIA[col.direzione]} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <div class="occ__box" data-schema-box>
            <p class="occ__box-title">{t.impianto}</p>
          </div>
        </div>
      ))
    }
  </div>
  <p class="occ__riferimento">{t.riferimento}</p>
</SchemaFrame>

<style>
  /* Di partenza le due colonne sono impilate; si affiancano da 25rem (in
     fondo al file). Ognuna resta comunque una colonna verticale: i box non
     cambiano orientamento, cambia solo l'affiancamento. */
  .occ {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    color: #e7f0f7;
  }
  .occ__col {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    flex: 1 1 0;
    /* Elemento di griglia flessibile sull'asse principale (`.occ` è una riga):
       senza questo il minimo implicito è la larghezza del contenuto più
       lungo, e una parola senza spazi allargherebbe la colonna anziché
       andare a capo. */
    min-width: 0;
    width: 100%;
    max-width: 18rem;
  }
  /* Separatore fra le due colonne: orizzontale finché sono impilate,
     verticale quando si affiancano. */
  .occ__col + .occ__col {
    border-top: 1px dashed rgba(63, 127, 176, 0.3);
    padding-top: 1.5rem;
  }
  .occ__title {
    margin: 0 0 0.5rem;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-small);
    line-height: 1.3;
  }
  .occ__col--blue .occ__title {
    color: #8fbfe0;
  }
  .occ__col--green .occ__title {
    color: #8fd9ab;
  }
  .occ__box {
    background: #0e3457;
    border: 1.4px solid rgba(107, 167, 210, 0.6);
    border-radius: 8px;
    padding: 0.6rem 0.75rem;
    text-align: center;
  }
  .occ__box--cci {
    background: #123a5e;
    border-color: #8fd9ab;
    border-width: 1.6px;
  }
  .occ__box-title {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--fs-small);
    line-height: 1.3;
    /* Spezza una parola solo se da sola non sta nella riga. */
    overflow-wrap: break-word;
  }
  .occ__box--cci .occ__box-title {
    font-family: var(--font-display);
    color: #8fd9ab;
  }
  .occ__arrow {
    display: flex;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    margin: 0.1rem auto;
  }
  .occ__col--blue .occ__arrow {
    color: #6ba7d2;
  }
  .occ__col--green .occ__arrow {
    color: #4fd07f;
  }
  .occ__arrow svg {
    width: 100%;
    height: 100%;
  }
  .occ__riferimento {
    margin: 1.75rem 0 0;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--fs-micro);
    letter-spacing: 0.04em;
    color: #bcd6e8;
    opacity: 0.85;
  }

  @container telaio (width >= 25rem) {
    .occ {
      flex-direction: row;
      align-items: stretch;
      justify-content: center;
      gap: 2.5rem;
    }
    .occ__col {
      width: auto;
      max-width: 15rem;
    }
    .occ__col + .occ__col {
      border-top: none;
      padding-top: 0;
      border-left: 1px dashed rgba(63, 127, 176, 0.3);
      padding-left: 2.5rem;
    }
  }
</style>
