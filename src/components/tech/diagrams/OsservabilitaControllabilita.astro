---
/**
 * Diagramma a due colonne per il Controllore Centrale d'Impianto (CCI).
 *
 * Non una misura, un confronto fra due funzioni: PF1 osservabilità (il CCI
 * legge lo stato dell'impianto) e PF2 controllabilità (limitazione della
 * potenza attiva su comando del distributore). Ogni colonna è tre box in
 * verticale — sorgente del dato o del comando, il CCI al centro, l'impianto —
 * con il verso della freccia che distingue lettura da comando. In basso il
 * riferimento normativo comune, confermato dal cliente: CEI 0-16 V5 e la
 * Delibera ARERA 564/2025/R/eel.
 *
 * Non è una catena orizzontale come RCS/A.72/contatori, quindi non usa
 * `BlockChain`: è disegnato direttamente dentro `SchemaFrame`, sulla stessa
 * griglia di box (132 di larghezza, la stessa funzione `righe()` per andare a
 * capo senza uscire dal riquadro) per restare coerente col resto del sito.
 */
import type { Lingua } from '../../../i18n/routes.ts';
import SchemaFrame from './SchemaFrame.astro';
import { righe } from './righe.ts';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;

const TESTI = {
  it: {
    ariaLabel:
      'Due colonne verticali. A sinistra PF1, osservabilità: lo stato dell\'impianto sale dall\'impianto al CCI, che lo rende leggibile al distributore. A destra PF2, controllabilità: il comando di limitazione della potenza attiva scende dal distributore, passa per il CCI e raggiunge l\'impianto. In basso il riferimento comune, CEI 0-16 V5 e Delibera ARERA 564/2025/R/eel.',
    pf1: 'PF1 · Osservabilità',
    pf2: 'PF2 · Controllabilità',
    distributore: 'Distributore',
    impianto: 'Impianto',
    riferimento: 'CEI 0-16 V5 · Delibera ARERA 564/2025/R/eel',
    caption: 'Due funzioni, due versi opposti',
    captionSub: 'Schema esemplificativo · PF1 osservabilità e PF2 controllabilità secondo CEI 0-16 V5',
  },
  en: {
    ariaLabel:
      "Two vertical columns. On the left, PF1, observability: the plant's status rises from the plant to the CCI, which makes it readable to the distributor. On the right, PF2, controllability: the active power curtailment command comes down from the distributor, passes through the CCI and reaches the plant. At the bottom, the shared reference, CEI 0-16 V5 and Delibera ARERA 564/2025/R/eel.",
    pf1: 'PF1 · Observability',
    pf2: 'PF2 · Controllability',
    distributore: 'Distributor',
    impianto: 'Plant',
    riferimento: 'CEI 0-16 V5 · Delibera ARERA 564/2025/R/eel',
    caption: 'Two functions, two opposite directions',
    captionSub: 'Sample diagram · PF1 observability and PF2 controllability under CEI 0-16 V5',
  },
} as const;

const t = TESTI[lingua];
const uid = 'occ';

// Griglia: due colonne di tre box, stessa larghezza box (132) e stesso
// margine interno (116 di testo utile) della griglia orizzontale di
// BlockChain, così le due famiglie di schemi restano coerenti fra loro.
const COL1 = 190;
const COL2 = 450;
const ROW_TOP = 116;
const ROW_MID = 200;
const ROW_BOT = 284;
const BOX_W = 132;
const BOX_H = 58;
const MAX_TESTO = BOX_W - 16;
const n = (v: number) => Math.round(v * 10) / 10;

// Un solo rigo di testo per box (non titolo+sottotitolo come in BlockChain):
// righe() lo spezza al massimo su due righe, centrate sul centro riga. Come
// in BlockChain, la stima usa la dimensione mobile (21, la più larga: sotto
// i 768px il font cresce ma il viewBox no) e le righe oltre la prima sono
// `tspan` con `dy` in "em", cioè proporzionati al font-size in vigore anche
// dopo il cambio di dimensione sotto i 768px.
const EM_MOBILE = 21;
const LH = 15;
function layout(testo: string, rowY: number) {
  const linee = righe(testo, EM_MOBILE, MAX_TESTO);
  const top = n(rowY - (linee.length * LH) / 2 + LH * 0.78);
  return { linee, y: top };
}

const colonne = [
  {
    cx: COL1,
    titolo: t.pf1,
    titoloFill: '#8fbfe0',
    righe: [
      { rowY: ROW_TOP, testo: t.distributore, cci: false },
      { rowY: ROW_MID, testo: 'CCI', cci: true },
      { rowY: ROW_BOT, testo: t.impianto, cci: false },
    ],
    // PF1, osservabilità: lo stato risale, dal basso in alto.
    frecce: [
      { y1: n(ROW_BOT - BOX_H / 2), y2: n(ROW_MID + BOX_H / 2) },
      { y1: n(ROW_MID - BOX_H / 2), y2: n(ROW_TOP + BOX_H / 2) },
    ],
    freccia: `url(#${uid}-arrow-blue)`,
    strokeFreccia: '#6ba7d2',
  },
  {
    cx: COL2,
    titolo: t.pf2,
    titoloFill: '#8fd9ab',
    righe: [
      { rowY: ROW_TOP, testo: t.distributore, cci: false },
      { rowY: ROW_MID, testo: 'CCI', cci: true },
      { rowY: ROW_BOT, testo: t.impianto, cci: false },
    ],
    // PF2, controllabilità: il comando scende, dall'alto in basso.
    frecce: [
      { y1: n(ROW_TOP + BOX_H / 2), y2: n(ROW_MID - BOX_H / 2) },
      { y1: n(ROW_MID + BOX_H / 2), y2: n(ROW_BOT - BOX_H / 2) },
    ],
    freccia: `url(#${uid}-arrow-green)`,
    strokeFreccia: '#4fd07f',
  },
] as const;
---

<SchemaFrame uid={uid} ariaLabel={t.ariaLabel} didascalia={t.caption} didascaliaSub={t.captionSub}>
  <!-- Separatore centrale fra le due colonne. -->
  <line x1="320" y1="88" x2="320" y2="314" stroke="#3f7fb0" stroke-opacity="0.3" stroke-width="1" stroke-dasharray="2 4"></line>

  {
    colonne.map((col) => (
      <>
        <text x={col.cx} y="90" text-anchor="middle" class="schema-label" font-family="Sora, Inter Variable, Inter, sans-serif" font-size="14" font-weight="700" fill={col.titoloFill}>
          {col.titolo}
        </text>
        {col.frecce.map((f) => (
          <line x1={col.cx} y1={f.y1} x2={col.cx} y2={f.y2} stroke={col.strokeFreccia} stroke-width="1.8" marker-end={col.freccia} />
        ))}
        {col.righe.map((riga) => {
          const { linee, y } = layout(riga.testo, riga.rowY);
          return (
            <g data-schema-box>
              <rect
                class="schema-box"
                x={n(col.cx - BOX_W / 2)}
                y={n(riga.rowY - BOX_H / 2)}
                width={BOX_W}
                height={BOX_H}
                rx="8"
                fill={riga.cci ? '#123a5e' : '#0e3457'}
                stroke={riga.cci ? '#8fd9ab' : '#6ba7d2'}
                stroke-opacity={riga.cci ? '0.7' : '0.6'}
                stroke-width={riga.cci ? '1.6' : '1.4'}
              />
              <text
                class="schema-box__t"
                x={col.cx}
                y={y}
                text-anchor="middle"
                font-family={riga.cci ? 'Sora, Inter Variable, Inter, sans-serif' : 'Inter Variable, Inter, sans-serif'}
                font-size={riga.cci ? '12.5' : '12'}
                font-weight="700"
                fill={riga.cci ? '#8fd9ab' : '#e7f0f7'}
              >
                {linee.map((testoRiga, i) => <tspan x={col.cx} dy={i === 0 ? '0' : '1.2em'}>{testoRiga}</tspan>)}
              </text>
            </g>
          );
        })}
      </>
    ))
  }

  <!-- Riferimento normativo comune. -->
  <text x="320" y="376" text-anchor="middle" class="schema-label" font-family="Inter Variable, Inter, sans-serif" font-size="11" font-weight="600" letter-spacing="0.04em" fill="#bcd6e8" fill-opacity="0.85">
    {t.riferimento}
  </text>
</SchemaFrame>

<style>
  /* Stessa strategia di BlockChain: sotto i 768px la tela reale è ~350px per
     640 unità di viewBox, e senza ingrandire i font qui i testi scenderebbero
     sotto gli 11px effettivi su schermo. */
  @media (max-width: 767px) {
    .schema-label { font-size: 22px; }
    .schema-box__t { font-size: 21px; }
  }
</style>
