---
/**
 * Diagramma a catena per il teledistacco secondo l'Allegato A.72.
 *
 * Quattro blocchi in fila: la protezione di interfaccia con il dispositivo
 * RIGEDI, il modem che riceve il comando del distributore, l'integrazione
 * SCADA che ne rende visibile lo stato, il distributore che invia l'ordine di
 * distacco o riconnessione. Una sola freccia, un solo verso: il comando che
 * arriva dal distributore e scende fino alla protezione, e lo stato che torna
 * indietro attraverso lo SCADA — la stessa struttura a due corsie delle altre
 * pagine di controllo, qui applicata a una catena di sicurezza di rete.
 * Disegnata sulla griglia condivisa `SchemaFrame`/`BlockChain`: il titolo del
 * primo box, che a coordinate scritte a mano usciva dal riquadro, ora va a
 * capo con `righe()` come ogni altro box del sito.
 */
import type { Lingua } from '../../../i18n/routes.ts';
import SchemaFrame from './SchemaFrame.astro';
import BlockChain from './BlockChain.astro';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;

const TESTI = {
  it: {
    ariaLabel:
      "Catena a quattro blocchi: protezione di interfaccia con dispositivo RIGEDI, modem, integrazione SCADA, distributore. Una freccia superiore porta lo stato della protezione fino allo SCADA, una freccia inferiore riporta il comando di distacco o riconnessione dal distributore fino alla protezione di interfaccia.",
    blocchi: [
      // "Protezione di interfaccia" (senza accorciare) va a capo su tre
      // righe nel box da 132 unità: la funzione righe() ne tiene solo due e
      // perderebbe "interfaccia". Senza la preposizione il titolo va a capo
      // pulito su due righe, "Protezione" / "interfaccia".
      { t1: 'Protezione interfaccia', t2: 'Dispositivo RIGEDI' },
      { t1: 'Modem', t2: 'Ricezione comando' },
      // "Stato e storicizzazione" esce dal box a 390px (misurato nel
      // browser): "storicizzazione" da sola è troppo larga al font mobile.
      { t1: 'Integrazione SCADA', t2: 'Stato, storico' },
      { t1: 'Distributore', t2: 'Ordine di distacco' },
    ],
    stato: 'STATO',
    comando: 'COMANDO DI DISTACCO',
    caption: 'Il comando arriva, lo stato torna indietro',
    captionSub: 'Catena esemplificativa · protezione RIGEDI, modem, SCADA, distributore',
  },
  en: {
    ariaLabel:
      "Four-block chain: interface protection with the RIGEDI device, modem, SCADA integration, distributor. An upper arrow carries the protection's status up to the SCADA, a lower arrow carries the disconnection or reconnection command from the distributor down to the interface protection.",
    blocchi: [
      { t1: 'Interface protection', t2: 'RIGEDI device' },
      { t1: 'Modem', t2: 'Command reception' },
      // "Status and history" andrebbe a capo su tre righe nel box: righe()
      // ne tiene solo due e perderebbe "history". "Disconnection order" esce
      // dal box a 390px (misurato nel browser): "Disconnection" da sola è
      // troppo larga al font mobile.
      { t1: 'SCADA integration', t2: 'Status, history' },
      { t1: 'Distributor', t2: 'Trip order' },
    ],
    stato: 'STATUS',
    comando: 'DISCONNECTION COMMAND',
    caption: 'The command arrives, the status comes back',
    captionSub: 'Sample chain · RIGEDI protection, modem, SCADA, distributor',
  },
} as const;

const t = TESTI[lingua];
---

<SchemaFrame uid="a72" ariaLabel={t.ariaLabel} didascalia={t.caption} didascaliaSub={t.captionSub}>
  <BlockChain
    uid="a72"
    blocchi={t.blocchi.map((b, i) => ({ ...b, accento: i === 0 }))}
    sopra={{ etichetta: t.stato }}
    sotto={{ etichetta: t.comando }}
  />
</SchemaFrame>
