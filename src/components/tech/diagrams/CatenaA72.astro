---
/**
 * Diagramma a catena per il teledistacco secondo l'Allegato A.72.
 *
 * Quattro blocchi in fila: la protezione di interfaccia con il dispositivo
 * RIGEDI, il modem che riceve il comando del distributore, l'integrazione
 * SCADA che ne rende visibile lo stato, il distributore che invia l'ordine di
 * distacco o riconnessione. Una sola freccia, un solo verso: il comando che
 * arriva dal distributore e scende fino alla protezione, e lo stato che torna
 * indietro attraverso lo SCADA — la stessa struttura a due corsie delle altre
 * pagine di controllo, qui applicata a una catena di sicurezza di rete.
 */
const W = 640;
const H = 320;
const uid = 'a72';

const blocchi = [
  { cx: 108, t1: 'Protezione di interfaccia', t2: 'Dispositivo RIGEDI' },
  { cx: 268, t1: 'Modem', t2: 'Ricezione comando' },
  { cx: 428, t1: 'Integrazione SCADA', t2: 'Stato e storicizzazione' },
  { cx: 555, t1: 'Distributore', t2: 'Ordine di distacco' },
];
const boxW = 128;
const boxH = 76;
const boxY = 118;
const laneY1 = 96; // corsia superiore: lo stato che risale allo SCADA
const laneY2 = 216; // corsia inferiore: il comando di distacco che scende
const n = (v: number) => Math.round(v * 10) / 10;
---

<figure class="a72-plot">
  <div class="a72-plot__frame rounded-[var(--radius-card)] border border-navy-100 shadow-[var(--shadow-md)]">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label="Catena a quattro blocchi: protezione di interfaccia con dispositivo RIGEDI, modem, integrazione SCADA, distributore. Una freccia superiore porta lo stato della protezione fino allo SCADA, una freccia inferiore riporta il comando di distacco o riconnessione dal distributore fino alla protezione di interfaccia."
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="0.35" y2="1">
          <stop offset="0" stop-color="#0c3151"></stop>
          <stop offset="1" stop-color="#081f36"></stop>
        </linearGradient>
        <pattern id={`${uid}-dots`} width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="1.1" cy="1.1" r="1.1" fill="#4f93c4" fill-opacity="0.16"></circle>
        </pattern>
        <marker id={`${uid}-arrow-up`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 Z" fill="#6ba7d2"></path>
        </marker>
        <marker id={`${uid}-arrow-down`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 Z" fill="#4fd07f"></path>
        </marker>
      </defs>

      <rect width={W} height={H} fill={`url(#${uid}-bg)`}></rect>
      <rect width={W} height={H} fill={`url(#${uid}-dots)`}></rect>

      <!-- Corsia dello stato: dalla protezione allo SCADA. -->
      <line
        x1={blocchi[0].cx}
        y1={laneY1}
        x2={blocchi[2].cx}
        y2={laneY1}
        stroke="#6ba7d2"
        stroke-width="1.6"
        marker-end={`url(#${uid}-arrow-up)`}
      ></line>

      <!-- Corsia del comando: dal distributore alla protezione. -->
      <line
        x1={blocchi[3].cx}
        y1={laneY2}
        x2={blocchi[0].cx}
        y2={laneY2}
        stroke="#4fd07f"
        stroke-width="2"
        marker-end={`url(#${uid}-arrow-down)`}
      ></line>

      <!-- Blocchi. -->
      {
        blocchi.map((b) => (
          <g>
            <rect
              x={n(b.cx - boxW / 2)}
              y={boxY}
              width={boxW}
              height={boxH}
              rx="8"
              fill="#0e3457"
              stroke="#6ba7d2"
              stroke-opacity="0.6"
              stroke-width="1.4"
            />
            <text
              x={n(b.cx)}
              y={boxY + 27}
              text-anchor="middle"
              font-family="Sora, Inter Variable, Inter, sans-serif"
              font-size="12.5"
              font-weight="700"
              fill="#e7f0f7"
            >
              {b.t1}
            </text>
            <text
              x={n(b.cx)}
              y={boxY + 52}
              text-anchor="middle"
              font-family="Inter Variable, Inter, sans-serif"
              font-size="10.5"
              fill="#bcd6e8"
              fill-opacity="0.85"
            >
              {b.t2}
            </text>
          </g>
        ))
      }

      <!-- Collegamenti verticali fra blocco e corsia. -->
      <g stroke="#3f7fb0" stroke-opacity="0.45" stroke-width="1">
        {blocchi.slice(0, 3).map((b) => <line x1={n(b.cx)} y1={laneY1} x2={n(b.cx)} y2={boxY} />)}
        {blocchi.map((b) => <line x1={n(b.cx)} y1={boxY + boxH} x2={n(b.cx)} y2={laneY2} />)}
      </g>

      <!-- Etichette delle due corsie. -->
      <g font-family="Inter Variable, Inter, sans-serif" font-size="10.5" font-weight="700" letter-spacing="0.06em">
        <text x={blocchi[0].cx} y={laneY1 - 12} fill="#8fbfe0">STATO</text>
        <text x={blocchi[3].cx} y={laneY2 + 22} text-anchor="end" fill="#8fd9ab">COMANDO DI DISTACCO</text>
      </g>

      <!-- Cornice con tacche d'angolo. -->
      <rect x="14" y="14" width={W - 28} height={H - 28} rx="6" fill="none" stroke="#6ba7d2" stroke-opacity="0.26" stroke-width="1"></rect>
      <g stroke="#8fd9ab" stroke-opacity="0.5" stroke-width="1.4" stroke-linecap="square">
        <line x1="14" y1="38" x2="14" y2="14"></line>
        <line x1="14" y1="14" x2="38" y2="14"></line>
        <line x1={W - 38} y1="14" x2={W - 14} y2="14"></line>
        <line x1={W - 14} y1="14" x2={W - 14} y2="38"></line>
        <line x1="14" y1={H - 38} x2="14" y2={H - 14}></line>
        <line x1="14" y1={H - 14} x2="38" y2={H - 14}></line>
        <line x1={W - 38} y1={H - 14} x2={W - 14} y2={H - 14}></line>
        <line x1={W - 14} y1={H - 14} x2={W - 14} y2={H - 38}></line>
      </g>
    </svg>
  </div>

  <figcaption class="a72-plot__caption">
    <span class="a72-plot__dot" aria-hidden="true"></span>
    <span>
      <strong>Il comando arriva, lo stato torna indietro</strong>
      <span class="a72-plot__caption-sub">
        Catena esemplificativa · protezione RIGEDI, modem, SCADA, distributore
      </span>
    </span>
  </figcaption>
</figure>

<style>
  .a72-plot__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 2 / 1;
    background: #0a2a44;
  }

  .a72-plot__frame svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 767px) {
    .a72-plot__frame svg text {
      font-size: 15px;
    }
  }

  .a72-plot__caption {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.85rem;
    padding-left: 0.15rem;
    color: currentColor;
    font-size: var(--fs-small);
    line-height: 1.35;
  }

  .a72-plot__caption strong {
    display: block;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .a72-plot__caption-sub {
    display: block;
    color: color-mix(in srgb, currentColor 62%, transparent);
    font-size: var(--fs-micro);
  }

  .a72-plot__dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    border-radius: 999px;
    background: #2fa85f;
    box-shadow: 0 0 0 4px rgb(79 208 127 / 0.22);
  }
</style>
