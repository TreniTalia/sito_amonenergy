---
/**
 * Diagramma della risposta in frequenza di un avvolgimento (SFRA).
 *
 * Disegnato sul telaio condiviso `ChartFrame`, con la stessa lingua grafica
 * degli altri grafici delle pagine tecniche: fondo navy, reticolo
 * sottilissimo che dà scala senza farsi guardare, verde solo come
 * micro-accento, cornice con tacche d'angolo da strumento. È un grafico a
 * dati: i due tracciati escono da una funzione, non da una curva disegnata a
 * mano.
 *
 * Il contenuto è quello che la IEC 60076-18 misura davvero: ampiezza in dB
 * su scala logaritmica da 20 Hz a 2 MHz, calcolata dal modello di
 * `charts/models/sfra.ts`: ramo di magnetizzazione del nucleo in cascata con
 * la rete RLC dell'avvolgimento (dischi con mutue induttanze), terminata su
 * 50 Ω. Ne escono le tre regioni di una SFRA vera: la discesa del nucleo con
 * il minimo profondo attorno a 1 kHz, le risonanze della banda media, quelle
 * più fitte della banda alta. Il tracciato di riferimento e quello misurato
 * coincidono in bassa frequenza — dove risponde il nucleo, insensibile alla
 * geometria degli avvolgimenti — e divergono sopra i 100 kHz, dove una
 * deformazione dell'avvolgimento sposta e rimodella le risonanze. È l'unico
 * punto del disegno che deve leggersi al primo sguardo.
 */
import type { Lingua } from '../../../i18n/routes.ts';
import ChartFrame from '../charts/ChartFrame.astro';
import { rispostaSfra, AVVOLGIMENTO_RIFERIMENTO, AVVOLGIMENTO_DEFORMATO } from '../charts/models/sfra.ts';
import { logspace } from '../charts/models/scale.ts';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;

const TESTI = {
  it: {
    ariaLabel:
      'Grafico della risposta in frequenza di un avvolgimento di trasformatore: ampiezza in decibel su scala logaritmica da 20 Hz a 2 MHz. Il tracciato di riferimento e quello misurato coincidono fino a circa 100 kHz; sopra i 100 kHz le risonanze del tracciato misurato si spostano in frequenza e cambiano ampiezza, lo scostamento che segnala una deformazione dell\'avvolgimento.',
    scostamento: 'SCOSTAMENTO',
    impronta: 'Impronta di riferimento',
    misuraInCampo: 'Misura in campo',
    caption: "Confronto con l'impronta di riferimento",
    captionSub: "Curva calcolata da modello · rete RLC dell'avvolgimento, da 20 Hz a 2 MHz secondo IEC 60076-18",
  },
  en: {
    ariaLabel:
      'Frequency response chart of a transformer winding: amplitude in decibels on a logarithmic scale from 20 Hz to 2 MHz. The reference and measured traces coincide up to about 100 kHz; above 100 kHz the resonances of the measured trace shift in frequency and change in amplitude, the deviation that signals a winding deformation.',
    scostamento: 'DEVIATION',
    impronta: 'Reference fingerprint',
    misuraInCampo: 'Field measurement',
    caption: 'Comparison with the reference fingerprint',
    captionSub: 'Computed from a model · RLC winding network, 20 Hz to 2 MHz under IEC 60076-18',
  },
} as const;

const t = TESTI[lingua];

const f = logspace(20, 2e6, 480);
const riferimento = f.map((x) => [x, rispostaSfra(x, AVVOLGIMENTO_RIFERIMENTO)] as [number, number]);
const misura = f.map((x) => [x, rispostaSfra(x, AVVOLGIMENTO_DEFORMATO)] as [number, number]);
---

<ChartFrame
  uid="sfra"
  ariaLabel={t.ariaLabel}
  x={{
    scala: { tipo: 'log', min: 20, max: 2e6 },
    unita: 'Hz',
    tacche: [
      { v: 20, t: '20 Hz' },
      { v: 100, t: '100', minore: true },
      { v: 1e3, t: '1 k' },
      { v: 1e4, t: '10 k' },
      { v: 1e5, t: '100 k' },
      { v: 2e6, t: '2 MHz' },
    ],
  }}
  y={{
    scala: { tipo: 'lin', min: -100, max: 0 },
    unita: 'dB',
    tacche: [0, -20, -40, -60, -80, -100].map((v) => ({ v, t: String(v) })),
  }}
  serie={[
    { tipo: 'line', punti: misura, colore: '#4fd07f', spessore: 1.8, legenda: t.misuraInCampo },
    { tipo: 'line', punti: riferimento, colore: '#bcd6e8', spessore: 1.6, legenda: t.impronta },
  ]}
  banda={{ da: 1e5, a: 2e6, etichetta: t.scostamento }}
  didascalia={t.caption}
  didascaliaSub={t.captionSub}
/>
