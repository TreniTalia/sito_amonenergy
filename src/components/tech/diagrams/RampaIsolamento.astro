---
/**
 * Diagramma della prova di isolamento in alta tensione a rampa controllata.
 *
 * Ora sul telaio condiviso `ChartFrame`, su due assi: la tensione di prova
 * (asse sinistro, kV) e la corrente di fuga (asse destro, µA), che prima
 * condividevano lo stesso asse in kV, un errore di lettura perché le due
 * grandezze non sono comparabili. Il contenuto è quello che restituisce
 * davvero il modello di `charts/models/isolamento.ts`: la corrente letta
 * dallo strumento è la somma della carica della capacità del componente,
 * costante finché la tensione sale, e della conduzione attraverso
 * l'isolante, V/R. Un isolamento sano ha R costante e la corrente resta
 * bassa e piatta; uno compromesso ha una R che crolla oltre una soglia di
 * tensione, e la corrente si impenna prima di arrivare al valore di prova:
 * è quella la firma che la prova deve cogliere.
 */
import type { Lingua } from '../../../i18n/routes.ts';
import ChartFrame from '../charts/ChartFrame.astro';
import { tensione, correnteFuga, PROVA_ESEMPIO } from '../charts/models/isolamento.ts';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;

const TESTI = {
  it: {
    ariaLabel:
      'Grafico della prova di isolamento su due assi: tensione di prova in kV a sinistra, corrente di fuga in microampere a destra. La tensione sale in rampa da 0 a 80 kV nei primi 8 minuti e poi tiene il valore di prova. La corrente di un isolamento sano resta bassa e piatta per tutta la prova; quella di un isolamento compromesso segue lo stesso andamento fino a circa 45 kV, poi si impenna e resta alta anche in tenuta, prima ancora di raggiungere il valore di prova.',
    legendaTensione: 'Tensione di prova',
    legendaSano: 'Fuga, isolamento sano',
    legendaCompromesso: 'Fuga, isolamento compromesso',
    caption: 'Rampa di tensione e corrente di fuga',
    captionSub: 'Curva calcolata da modello · rampa a 80 kV, carica C·dV/dt più conduzione V/R',
  },
  en: {
    ariaLabel:
      'Insulation test chart on two axes: test voltage in kV on the left, leakage current in microamps on the right. Voltage ramps from 0 to 80 kV over the first 8 minutes, then holds the test value. The current of healthy insulation stays low and flat throughout the test; that of compromised insulation follows the same path up to about 45 kV, then spikes and stays high even at withstand, before reaching the test value.',
    legendaTensione: 'Test voltage',
    legendaSano: 'Leakage, healthy insulation',
    legendaCompromesso: 'Leakage, degraded insulation',
    caption: 'Voltage ramp and leakage current',
    captionSub: 'Computed from a model · ramp to 80 kV, C·dV/dt charging plus V/R conduction',
  },
} as const;

const t = TESTI[lingua];

// 241 campioni su 12 minuti (passo 0,05 min): rampa di 8 minuti più 4 minuti
// di tenuta, abbastanza fitti da disegnare senza spigoli l'impennata del
// compromesso attorno alla soglia.
const tt = Array.from({ length: 241 }, (_, i) => i * (12 / 240));
const kv = tt.map((m) => [m, tensione(m, PROVA_ESEMPIO)] as [number, number]);
const sano = tt.map((m) => [m, correnteFuga(m, PROVA_ESEMPIO, 'sano')] as [number, number]);
const comp = tt.map((m) => [m, Math.min(40, correnteFuga(m, PROVA_ESEMPIO, 'compromesso'))] as [number, number]);
---

<ChartFrame
  uid="ins"
  ariaLabel={t.ariaLabel}
  x={{
    scala: { tipo: 'lin', min: 0, max: 12 },
    unita: 'min',
    tacche: [0, 2, 4, 6, 8, 10, 12].map((v) => ({ v, t: String(v) })),
  }}
  y={{
    scala: { tipo: 'lin', min: 0, max: 80 },
    unita: 'kV',
    tacche: [0, 20, 40, 60, 80].map((v) => ({ v, t: String(v) })),
  }}
  y2={{
    scala: { tipo: 'lin', min: 0, max: 40 },
    unita: 'µA',
    tacche: [0, 10, 20, 30, 40].map((v) => ({ v, t: String(v) })),
  }}
  serie={[
    { tipo: 'line', punti: kv, colore: '#bcd6e8', spessore: 1.8, legenda: t.legendaTensione },
    { tipo: 'line', punti: sano, colore: '#4fd07f', spessore: 1.8, asse: 'y2', legenda: t.legendaSano },
    { tipo: 'line', punti: comp, colore: '#e05a3d', spessore: 1.8, asse: 'y2', legenda: t.legendaCompromesso },
  ]}
  didascalia={t.caption}
  didascaliaSub={t.captionSub}
/>
