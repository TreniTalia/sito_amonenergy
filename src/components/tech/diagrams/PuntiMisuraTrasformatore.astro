---
/**
 * Diagramma dei punti di misura sulle verifiche di trasformatori di potenza.
 *
 * A differenza degli altri disegni tecnici non è una catena a blocchi ma una
 * sagoma schematica del trasformatore — cassone, radiatori, terne di
 * isolatori AT e BT, commutatore e neutro — con i punti dove si aggancia la
 * strumentazione (ISA T2000 per rapporto e resistenze, ISA STS5000 + TD500
 * per tan delta e capacità) numerati. Resta un disegno tecnico, quindi resta
 * SVG; l'elenco laterale invece è HTML reale, che va a capo da solo e non ha
 * bisogno di una riga di richiamo calcolata a mano per restare nella propria
 * colonna. Il numero sul disegno e il numero nell'elenco sono lo stesso
 * indice: non serve una linea a gomito per collegarli, basta l'ordine.
 */
import type { Lingua } from '../../../i18n/routes.ts';
import SchemaFrame from './SchemaFrame.astro';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;

const TESTI = {
  it: {
    ariaLabel:
      'Sagoma schematica di un trasformatore di potenza con cinque punti di misura numerati: terna isolatori AT, terna isolatori BT, commutatore sotto carico, neutro e messa a terra, cassone e nucleo. Ogni punto corrisponde alla voce con lo stesso numero nell\'elenco a fianco.',
    legenda: [
      { t: 'Terna isolatori AT', d: 'Rapporto, isolamento' },
      { t: 'Terna isolatori BT', d: 'Rapporto, avvolgimenti' },
      { t: 'Commutatore sotto carico', d: 'Resistenza di contatto' },
      { t: 'Neutro e messa a terra', d: 'Continuità, resistenza' },
      { t: 'Cassone e nucleo', d: 'Tan delta, eccitazione' },
    ],
    caption: 'Cinque punti, cinque misure diverse',
    captionSub: 'Sagoma esemplificativa · terne AT/BT, commutatore, neutro e cassone',
  },
  en: {
    ariaLabel:
      "Schematic outline of a power transformer with five numbered measurement points: HV bushing set, LV bushing set, on-load tap changer, neutral and earthing, tank and core. Each point matches the entry with the same number in the side list.",
    legenda: [
      { t: 'HV bushing set', d: 'Ratio, insulation' },
      { t: 'LV bushing set', d: 'Ratio, windings' },
      { t: 'On-load tap changer', d: 'Contact resistance' },
      { t: 'Neutral and earthing', d: 'Continuity, resistance' },
      { t: 'Tank and core', d: 'Tan delta, excitation' },
    ],
    caption: 'Five points, five different measurements',
    captionSub: 'Sample outline · HV/LV bushing sets, tap changer, neutral and tank',
  },
} as const;

const t = TESTI[lingua];

// Sagoma del cassone: rettangolo centrale con radiatori a lamelle sui due
// fianchi. Le terne di isolatori sono icone semplificate — dischi impilati
// su uno stelo — non una geometria realistica: bastano a farsi leggere come
// "bushing" al primo sguardo. Coordinate invariate rispetto al disegno
// originale: questo SVG ha ora una tela tutta sua, ritagliata sulla sagoma
// (non condivide più il canvas 640×440 con l'elenco, che è HTML a fianco).
const cassone = { x: 130, y: 148, w: 190, h: 104 };
const radL = { x: cassone.x - 22, y: cassone.y + 12, w: 16, h: cassone.h - 24 };
const radR = { x: cassone.x + cassone.w + 6, y: cassone.y + 12, w: 16, h: cassone.h - 24 };

function bushing(cx: number, topY: number, baseY: number, dischi: number) {
  const step = (baseY - topY) / (dischi + 1);
  const raggi = Array.from({ length: dischi }, (_, i) => ({
    y: topY + step * (i + 1),
    r: 9 - i * 0.6,
  }));
  return { cx, topY, baseY, raggi };
}

const bushingAT = bushing(165, 66, cassone.y, 4);
const bushingBT = bushing(245, 92, cassone.y, 3);

// Marker numerati sulla sagoma: stesso numero della voce corrispondente
// nell'elenco HTML, nessuna linea di richiamo a collegarli via coordinate.
const punti = [
  { n: 1, mx: 165, my: 60 },
  { n: 2, mx: 245, my: 86 },
  { n: 3, mx: 340, my: 176 },
  { n: 4, mx: 175, my: 268 },
  { n: 5, mx: 225, my: 210 },
];

const n = (v: number) => Math.round(v * 10) / 10;
---

<SchemaFrame ariaLabel={t.ariaLabel} didascalia={t.caption} didascaliaSub={t.captionSub}>
  <div class="txm">
    <!-- Il gruppo che porta il telaio (`role="group"` in FrameChrome) annuncia
         già questa `ariaLabel`: se anche l'SVG la ripetesse con `role="img"`,
         chi usa uno screen reader la sentirebbe due volte. L'elenco qui sotto
         resta comunque leggibile, è testo HTML normale. -->
    <svg class="txm__outline" viewBox="30 40 360 260" aria-hidden="true">
      <!-- Linea di base, come un piano d'appoggio da disegno tecnico. -->
      <line x1="40" y1={cassone.y + cassone.h + 4} x2="380" y2={cassone.y + cassone.h + 4} stroke="#3f7fb0" stroke-opacity="0.35" stroke-width="1"></line>

      <!-- Radiatori: lamelle verticali sui due fianchi del cassone. -->
      <g stroke="#6ba7d2" stroke-opacity="0.55" stroke-width="1" fill="none">
        <rect x={radL.x} y={radL.y} width={radL.w} height={radL.h} rx="2"></rect>
        <rect x={radR.x} y={radR.y} width={radR.w} height={radR.h} rx="2"></rect>
        {Array.from({ length: 4 }, (_, i) => (
          <line x1={radL.x + 4 + i * 3} y1={radL.y + 3} x2={radL.x + 4 + i * 3} y2={radL.y + radL.h - 3} stroke-opacity="0.3" />
        ))}
        {Array.from({ length: 4 }, (_, i) => (
          <line x1={radR.x + 4 + i * 3} y1={radR.y + 3} x2={radR.x + 4 + i * 3} y2={radR.y + radR.h - 3} stroke-opacity="0.3" />
        ))}
      </g>

      <!-- Cassone. -->
      <rect x={cassone.x} y={cassone.y} width={cassone.w} height={cassone.h} rx="8" fill="#0e3457" stroke="#6ba7d2" stroke-opacity="0.6" stroke-width="1.4"></rect>

      <!-- Commutatore sotto carico: piccolo corpo agganciato al fianco. -->
      <rect x={cassone.x + cassone.w + 26} y="160" width="26" height="46" rx="4" fill="#0e3457" stroke="#6ba7d2" stroke-opacity="0.6" stroke-width="1.4"></rect>
      <line x1={cassone.x + cassone.w + 6} y1="183" x2={cassone.x + cassone.w + 26} y2="183" stroke="#6ba7d2" stroke-opacity="0.6" stroke-width="1.4"></line>

      <!-- Neutro: presa a terra sul fianco basso del cassone. -->
      <line x1={cassone.x + 30} y1={cassone.y + cassone.h} x2={cassone.x + 30} y2={cassone.y + cassone.h + 22} stroke="#6ba7d2" stroke-opacity="0.6" stroke-width="1.4"></line>
      <g stroke="#6ba7d2" stroke-opacity="0.6" stroke-width="1.4">
        <line x1={cassone.x + 18} y1={cassone.y + cassone.h + 22} x2={cassone.x + 42} y2={cassone.y + cassone.h + 22}></line>
        <line x1={cassone.x + 22} y1={cassone.y + cassone.h + 27} x2={cassone.x + 38} y2={cassone.y + cassone.h + 27}></line>
        <line x1={cassone.x + 26} y1={cassone.y + cassone.h + 32} x2={cassone.x + 34} y2={cassone.y + cassone.h + 32}></line>
      </g>

      <!-- Terne di isolatori: stelo con dischi impilati, tre steli ravvicinati
           per fase ridotti a uno solo con dischi più larghi per leggibilità
           alla scala del disegno. -->
      {
        [bushingAT, bushingBT].map((b) => (
          <g stroke="#bcd6e8" stroke-opacity="0.7" stroke-width="1.3" fill="none">
            <line x1={b.cx} y1={b.topY} x2={b.cx} y2={b.baseY} />
            {b.raggi.map((d) => <line x1={b.cx - d.r} y1={d.y} x2={b.cx + d.r} y2={d.y} />)}
          </g>
        ))
      }

      <!-- Marker numerati: cerchio e cifra più grandi di quanto sembri
           necessario alla scala del disegno, perché l'SVG è vincolato a una
           larghezza reale ridotta (`.txm__outline`) e un font-size pensato
           per la tela intera finirebbe sotto la soglia leggibile a schermo. -->
      {
        punti.map((p) => (
          <g>
            <circle cx={n(p.mx)} cy={n(p.my)} r="13" fill="#0a2a44" stroke="#4fd07f" stroke-width="1.8"></circle>
            <text class="txm__marker-num" x={n(p.mx)} y={n(p.my) + 5} text-anchor="middle" font-weight="700" fill="#8fd9ab">
              {p.n}
            </text>
          </g>
        ))
      }
    </svg>

    <ol class="txm__legend">
      {
        t.legenda.map((v, i) => (
          <li class="txm__legend-item" data-schema-box>
            <span class="txm__legend-num" aria-hidden="true">{i + 1}</span>
            <span class="txm__legend-text">
              <strong class="txm__legend-title">{v.t}</strong>
              <span class="txm__legend-desc">{v.d}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</SchemaFrame>

<style>
  /* Di partenza la sagoma sta sopra e l'elenco sotto: affiancati in una
     figura stretta, come quella nella colonna accanto al testo da 1024px, la
     sagoma scenderebbe sotto i 200px reali e i suoi marker sotto la soglia
     leggibile. Le regole dipendono dalla larghezza della figura (contenitore
     `telaio` di `FrameChrome`), non della finestra. */
  .txm {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.75rem;
  }
  /* Impilata, la sagoma non supera i 22rem: più larga allungherebbe la
     figura senza rendere nulla più leggibile. */
  .txm__outline {
    width: 100%;
    max-width: 22rem;
    margin-inline: auto;
    color: #e7f0f7;
  }
  /* Il valore del font-size è in unità di viewBox, non in px reali: viene
     scalato insieme a tutto il resto del disegno dalla trasformazione
     viewBox-verso-viewport. Con la sagoma larga almeno 264px reali (360
     unità di viewBox) 15 unità valgono almeno 11px; sotto, il valore sale. */
  .txm__marker-num {
    font-family: var(--font-display);
    font-size: 15px;
  }
  .txm__legend {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .txm__legend-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }
  .txm__legend-num {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    border: 1.4px solid #4fd07f;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--fs-micro);
    color: #8fd9ab;
  }
  .txm__legend-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .txm__legend-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-small);
    line-height: 1.3;
    color: #e7f0f7;
    /* Spezza una parola solo se da sola non sta nella riga. */
    overflow-wrap: break-word;
  }
  .txm__legend-desc {
    font-size: var(--fs-micro);
    color: #bcd6e8;
    opacity: 0.85;
    overflow-wrap: break-word;
  }

  /* Figura da telefono (sotto i 22rem): la sagoma occupa tutta la
     larghezza utile, poco più di 230px reali a 320px di finestra, e la
     cifra dei marker sale per restare sopra gli 11px effettivi. */
  @container telaio (width < 22rem) {
    .txm__marker-num {
      font-size: 19px;
    }
  }

  /* Da 37rem sagoma ed elenco si affiancano: la sagoma, più larga della
     lista perché è un disegno tecnico e non una didascalia, resta sopra i
     270px reali, e i marker a 15 unità sopra gli 11px effettivi. */
  @container telaio (width >= 37rem) {
    .txm {
      flex-direction: row;
      align-items: center;
      gap: 2.5rem;
    }
    .txm__outline {
      flex: 1.4 1 320px;
      max-width: 460px;
      margin-inline: 0;
    }
    .txm__legend {
      flex: 1 1 240px;
    }
  }
</style>
