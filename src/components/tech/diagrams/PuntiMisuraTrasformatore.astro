---
/**
 * Diagramma dei punti di misura sulle verifiche di trasformatori di potenza.
 *
 * A differenza degli altri quattro disegni non è una catena a blocchi ma una
 * sagoma schematica del trasformatore — cassone, radiatori, terne di
 * isolatori AT e BT, commutatore e neutro — con i punti dove si aggancia la
 * strumentazione (ISA T2000 per rapporto e resistenze, ISA STS5000 + TD500
 * per tan delta e capacità) numerati e collegati con una linea di richiamo a
 * un elenco laterale. Disegnata dentro il telaio condiviso `SchemaFrame`,
 * come gli schemi a blocchi delle altre pagine tecniche: solo il telaio e gli
 * allineamenti cambiano, la sagoma resta la stessa.
 */
import type { Lingua } from '../../../i18n/routes.ts';
import SchemaFrame from './SchemaFrame.astro';
import { righe } from './righe.ts';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;

const TESTI = {
  it: {
    ariaLabel:
      'Sagoma schematica di un trasformatore di potenza con cinque punti di misura numerati: terna isolatori AT, terna isolatori BT, commutatore sotto carico, neutro e messa a terra, cassone e nucleo. Ogni punto è collegato da una linea di richiamo alla voce corrispondente nell\'elenco laterale.',
    // Descrizioni tenute a una sola parola apposta: il titolo va già a capo
    // su due righe (misurato nel browser), e una descrizione di due parole
    // andrebbe anch'essa su due righe, toccando la riga precedente a 390px.
    legenda: [
      { t: 'Terna isolatori AT', d: 'Isolamento' },
      { t: 'Terna isolatori BT', d: 'Avvolgimenti' },
      { t: 'Commutatore sotto carico', d: 'Resistenza' },
      { t: 'Neutro e messa a terra', d: 'Continuità' },
      { t: 'Cassone e nucleo', d: 'Tan delta' },
    ],
    caption: 'Cinque punti, cinque misure diverse',
    captionSub: 'Sagoma esemplificativa · terne AT/BT, commutatore, neutro e cassone',
  },
  en: {
    ariaLabel:
      "Schematic outline of a power transformer with five numbered measurement points: HV bushing set, MV/LV bushing set, on-load tap changer, neutral and earthing, tank and core. Each point is linked by a lead line to the matching entry in the side list.",
    legenda: [
      { t: 'HV bushing set', d: 'Insulation' },
      { t: 'LV bushing set', d: 'Windings' },
      { t: 'On-load tap changer', d: 'Contact' },
      { t: 'Neutral and earthing', d: 'Continuity' },
      { t: 'Tank and core', d: 'Tan delta' },
    ],
    caption: 'Five points, five different measurements',
    captionSub: 'Sample outline · HV/LV bushing sets, tap changer, neutral and tank',
  },
} as const;

const t = TESTI[lingua];
const uid = 'txm';

// Sagoma del cassone: rettangolo centrale con radiatori a lamelle sui due
// fianchi. Le terne di isolatori sono icone semplificate — dischi impilati
// su uno stelo — non una geometria realistica: bastano a farsi leggere come
// "bushing" al primo sguardo.
//
// Tutte le y qui sotto sono spostate di +60 rispetto al disegno originale
// (che stava in un telaio alto 320): il telaio condiviso `SchemaFrame` è alto
// 440 come `ChartFrame`, e +60 è esattamente lo scarto che serve a
// ricentrare verticalmente la sagoma nella nuova tela, metà per lato.
const cassone = { x: 130, y: 208, w: 190, h: 104 };
const radL = { x: cassone.x - 22, y: cassone.y + 12, w: 16, h: cassone.h - 24 };
const radR = { x: cassone.x + cassone.w + 6, y: cassone.y + 12, w: 16, h: cassone.h - 24 };

function bushing(cx: number, topY: number, baseY: number, dischi: number) {
  const step = (baseY - topY) / (dischi + 1);
  const raggi = Array.from({ length: dischi }, (_, i) => ({
    y: topY + step * (i + 1),
    r: 9 - i * 0.6,
  }));
  return { cx, topY, baseY, raggi };
}

const bushingAT = bushing(165, 126, cassone.y, 4);
const bushingBT = bushing(245, 152, cassone.y, 3);

// Collettore verticale comune delle linee di richiamo: ogni punto piega qui
// prima di raggiungere la propria riga in elenco, così le linee non
// attraversano la sagoma del trasformatore.
const collettoreX = 396;

const punti = [
  { n: 1, mx: 165, my: 120, riga: 0 },
  { n: 2, mx: 245, my: 146, riga: 1 },
  { n: 3, mx: 340, my: 236, riga: 2 },
  { n: 4, mx: 175, my: 328, riga: 3 },
  { n: 5, mx: 225, my: 270, riga: 4 },
];

// La colonna dell'elenco va da x = 408 a x = 612 (204 unità, verificate dal
// test su `[data-schema-box]`); il testo comincia dopo il pallino numerato,
// a x = 438. Titolo e descrizione vanno a capo con `righe()` come i box
// delle catene: se una voce eccede comunque le due righe, si accorcia il
// testo in TESTI (IT e EN), non la griglia.
const legenda = t.legenda;

const legendX = 420;
const legendTestoX = legendX + 18;
const legendColX0 = 408;
const legendColW = 204; // fino a x = 612, a 14 unità dalla cornice interna
const MAX_TESTO_LEGENDA = legendColX0 + legendColW - legendTestoX; // 174
const n = (v: number) => Math.round(v * 10) / 10;

// Sotto i 768px tutto il testo di questo file sale a 22px (vedi <style> più
// sotto): righe() usa la stessa dimensione per stimare dove va a capo, così
// il numero di righe resta corretto sia a 1440 sia a 390px.
const EM_MOBILE = 22;
const LH_TITOLO = 15; // interlinea del titolo alla dimensione desktop (12px)
const LH_DESC = 13; // interlinea della descrizione alla dimensione desktop (10.5px)
// Margine ampio fra titolo e descrizione: sotto i 768px il font sale a
// 22px (molto più dei 12/10.5 desktop), e senza questo margine la seconda
// riga del titolo (quasi sempre due righe) toccherebbe la descrizione.
const GAP_LEGENDA = 24;
function layoutLegenda(v: { t: string; d: string }, rowY: number) {
  const linee1 = righe(v.t, EM_MOBILE, MAX_TESTO_LEGENDA);
  const linee2 = righe(v.d, EM_MOBILE, MAX_TESTO_LEGENDA);
  const totale = linee1.length * LH_TITOLO + GAP_LEGENDA + linee2.length * LH_DESC;
  const top = rowY - totale / 2;
  const y1 = n(top + LH_TITOLO * 0.78);
  const y2 = n(top + linee1.length * LH_TITOLO + GAP_LEGENDA + LH_DESC * 0.85);
  return { linee1, linee2, y1, y2 };
}

// Passo di riga più largo di prima (era 42, senza andare a capo): fino a due
// righe di titolo più due di descrizione devono stare fra una riga e la
// successiva senza toccarsi.
const legendY0 = 90;
const legendStep = 76;
---

<SchemaFrame uid={uid} ariaLabel={t.ariaLabel} didascalia={t.caption} didascaliaSub={t.captionSub}>
  <!-- Linea di base, come un piano d'appoggio da disegno tecnico. -->
  <line x1="40" y1={cassone.y + cassone.h + 4} x2="380" y2={cassone.y + cassone.h + 4} stroke="#3f7fb0" stroke-opacity="0.35" stroke-width="1"></line>

  <!-- Radiatori: lamelle verticali sui due fianchi del cassone. -->
  <g stroke="#6ba7d2" stroke-opacity="0.55" stroke-width="1" fill="none">
    <rect x={radL.x} y={radL.y} width={radL.w} height={radL.h} rx="2"></rect>
    <rect x={radR.x} y={radR.y} width={radR.w} height={radR.h} rx="2"></rect>
    {Array.from({ length: 4 }, (_, i) => (
      <line x1={radL.x + 4 + i * 3} y1={radL.y + 3} x2={radL.x + 4 + i * 3} y2={radL.y + radL.h - 3} stroke-opacity="0.3" />
    ))}
    {Array.from({ length: 4 }, (_, i) => (
      <line x1={radR.x + 4 + i * 3} y1={radR.y + 3} x2={radR.x + 4 + i * 3} y2={radR.y + radR.h - 3} stroke-opacity="0.3" />
    ))}
  </g>

  <!-- Cassone. -->
  <rect x={cassone.x} y={cassone.y} width={cassone.w} height={cassone.h} rx="8" fill="#0e3457" stroke="#6ba7d2" stroke-opacity="0.6" stroke-width="1.4"></rect>

  <!-- Commutatore sotto carico: piccolo corpo agganciato al fianco. -->
  <rect x={cassone.x + cassone.w + 26} y="220" width="26" height="46" rx="4" fill="#0e3457" stroke="#6ba7d2" stroke-opacity="0.6" stroke-width="1.4"></rect>
  <line x1={cassone.x + cassone.w + 6} y1="243" x2={cassone.x + cassone.w + 26} y2="243" stroke="#6ba7d2" stroke-opacity="0.6" stroke-width="1.4"></line>

  <!-- Neutro: presa a terra sul fianco basso del cassone. -->
  <line x1={cassone.x + 30} y1={cassone.y + cassone.h} x2={cassone.x + 30} y2={cassone.y + cassone.h + 22} stroke="#6ba7d2" stroke-opacity="0.6" stroke-width="1.4"></line>
  <g stroke="#6ba7d2" stroke-opacity="0.6" stroke-width="1.4">
    <line x1={cassone.x + 18} y1={cassone.y + cassone.h + 22} x2={cassone.x + 42} y2={cassone.y + cassone.h + 22}></line>
    <line x1={cassone.x + 22} y1={cassone.y + cassone.h + 27} x2={cassone.x + 38} y2={cassone.y + cassone.h + 27}></line>
    <line x1={cassone.x + 26} y1={cassone.y + cassone.h + 32} x2={cassone.x + 34} y2={cassone.y + cassone.h + 32}></line>
  </g>

  <!-- Terne di isolatori: stelo con dischi impilati, tre steli ravvicinati
       per fase ridotti a uno solo con dischi più larghi per leggibilità
       alla scala del disegno. -->
  {
    [bushingAT, bushingBT].map((b) => (
      <g stroke="#bcd6e8" stroke-opacity="0.7" stroke-width="1.3" fill="none">
        <line x1={b.cx} y1={b.topY} x2={b.cx} y2={b.baseY} />
        {b.raggi.map((d) => <line x1={b.cx - d.r} y1={d.y} x2={b.cx + d.r} y2={d.y} />)}
      </g>
    ))
  }

  <!-- Marker numerati e linee di richiamo a gomito verso l'elenco. -->
  {
    punti.map((p) => {
      const rowY = legendY0 + p.riga * legendStep;
      return (
        <g>
          <polyline
            points={`${n(p.mx)},${n(p.my)} ${n(collettoreX)},${n(p.my)} ${n(collettoreX)},${n(rowY)} ${n(legendX - 14)},${n(rowY)}`}
            fill="none"
            stroke="#4fd07f"
            stroke-opacity="0.5"
            stroke-width="1"
            stroke-dasharray="2 3"
          />
          <circle cx={n(p.mx)} cy={n(p.my)} r="10" fill="#0a2a44" stroke="#4fd07f" stroke-width="1.6"></circle>
          <text
            x={n(p.mx)}
            y={n(p.my) + 4}
            text-anchor="middle"
            font-family="Sora, Inter Variable, Inter, sans-serif"
            font-size="11"
            font-weight="700"
            fill="#8fd9ab"
          >
            {p.n}
          </text>
        </g>
      );
    })
  }

  <!-- Elenco laterale: numero, titolo, che cosa si misura in quel punto.
       Ogni voce è un `data-schema-box` con un riquadro trasparente largo
       quanto la colonna (408-612): il test di layout verifica così che le
       descrizioni non escano a destra, esattamente come i box degli schemi
       a catena. -->
  <g font-family="Inter Variable, Inter, sans-serif">
    {
      legenda.map((v, i) => {
        const rowY = legendY0 + i * legendStep;
        const { linee1, linee2, y1, y2 } = layoutLegenda(v, rowY);
        return (
          <g data-schema-box>
            <rect x={legendColX0} y={n(rowY - legendStep / 2)} width={legendColW} height={legendStep} fill="none" stroke="none"></rect>
            <circle cx={legendX} cy={rowY} r="9" fill="none" stroke="#4fd07f" stroke-width="1.4"></circle>
            <text x={legendX} y={rowY + 3.5} text-anchor="middle" font-size="10.5" font-weight="700" fill="#8fd9ab">
              {i + 1}
            </text>
            <text x={legendTestoX} y={y1} font-size="12" font-weight="700" fill="#e7f0f7">
              {linee1.map((riga, r) => <tspan x={legendTestoX} dy={r === 0 ? '0' : '1.2em'}>{riga}</tspan>)}
            </text>
            <text x={legendTestoX} y={y2} font-size="10.5" fill="#bcd6e8" fill-opacity="0.85">
              {linee2.map((riga, r) => <tspan x={legendTestoX} dy={r === 0 ? '0' : '1.2em'}>{riga}</tspan>)}
            </text>
          </g>
        );
      })
    }
  </g>
</SchemaFrame>

<style>
  /* Sotto i 768px la tela reale è ~350px per 640 unità di viewBox: senza
     ingrandire i font qui, il testo dell'elenco scenderebbe sotto gli 11px
     effettivi su schermo (15px non bastava: 15 × ~0,54 ≈ 8px reali). Il
     selettore è `text`, non `svg text`: lo scoping di Astro aggiunge il suo
     attributo a OGNI passo della catena, quindi un antenato `svg` (disegnato
     da `FrameChrome`, un altro file) non lo porterebbe mai e la regola non
     scatterebbe più. Un selettore piatto resta comunque confinato a questo
     file: non tocca il testo degli altri schemi, anche se condividono lo
     stesso telaio `SchemaFrame`. */
  @media (max-width: 767px) {
    text {
      font-size: 22px;
    }
  }
</style>
