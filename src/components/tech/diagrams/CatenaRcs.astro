---
/**
 * Diagramma a catena per il monitoraggio di cabina MT con RCS.
 *
 * Non è una misura ma un sistema, quindi non un grafico bensì una catena a
 * blocchi: cabina MT, unità RCS in campo, collegamento dati, Control Room.
 * Due frecce percorrono la catena in versi opposti — lo stato che risale
 * dalla cabina alla Control Room, il comando che ridiscende — con la
 * richiusura automatica evidenziata come l'unico evento che l'algoritmo RCS
 * decide da solo, senza attendere l'operatore. Stessa lingua grafica delle
 * altre pagine tecniche: fondo navy, reticolo a puntini, cornice con tacche
 * d'angolo, verde come unico accento.
 */
import type { Lingua } from '../../../i18n/routes.ts';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;

const TESTI = {
  it: {
    ariaLabel:
      "Catena a quattro blocchi: cabina MT, unità RCS in campo, collegamento dati, Control Room. Una freccia superiore porta lo stato dell'impianto dalla cabina alla Control Room, una freccia inferiore riporta il comando dalla Control Room alla cabina. La richiusura automatica dopo un guasto estinto, decisa dall'unità RCS senza attesa dell'operatore, è evidenziata in verde sulla corsia di comando.",
    blocchi: [
      { t1: 'Cabina MT', t2: 'Interruttore, sensori' },
      { t1: 'Unità RCS', t2: 'Analisi guasto in campo' },
      { t1: 'Collegamento dati', t2: 'Rete cellulare' },
      { t1: 'Control Room', t2: 'Amon Energy, 24/7' },
    ],
    stato: 'STATO',
    comando: 'COMANDO',
    richiusura: 'RICHIUSURA AUTOMATICA',
    caption: 'Stato che risale, comando che ridiscende',
    captionSub: 'Catena esemplificativa · cabina MT, unità RCS, collegamento dati, Control Room',
  },
  en: {
    ariaLabel:
      'Four-block chain: MV substation, field RCS unit, data link, Control Room. An upper arrow carries the plant status from the substation up to the Control Room, a lower arrow carries the command from the Control Room down to the substation. The automatic reclosing after a cleared fault, decided by the RCS unit without waiting for an operator, is highlighted in green on the command lane.',
    blocchi: [
      { t1: 'MV substation', t2: 'Breaker, sensors' },
      { t1: 'RCS unit', t2: 'On-site fault analysis' },
      { t1: 'Data link', t2: 'Cellular network' },
      { t1: 'Control Room', t2: 'Amon Energy, 24/7' },
    ],
    stato: 'STATUS',
    comando: 'COMMAND',
    richiusura: 'AUTOMATIC RECLOSING',
    caption: 'Status goes up, command comes down',
    captionSub: 'Sample chain · MV substation, RCS unit, data link, Control Room',
  },
} as const;

const t = TESTI[lingua];

const W = 640;
const H = 320;
const uid = 'rcs';

// Quattro blocchi in fila, centrati sull'asse orizzontale della catena.
const blocchi = [
  { cx: 108, t1: t.blocchi[0].t1, t2: t.blocchi[0].t2 },
  { cx: 268, t1: t.blocchi[1].t1, t2: t.blocchi[1].t2 },
  { cx: 428, t1: t.blocchi[2].t1, t2: t.blocchi[2].t2 },
  { cx: 555, t1: t.blocchi[3].t1, t2: t.blocchi[3].t2 },
];
const boxW = 128;
const boxH = 76;
const boxY = 118;
const laneY1 = 96; // corsia superiore: lo stato che risale
const laneY2 = 216; // corsia inferiore: il comando che ridiscende
const n = (v: number) => Math.round(v * 10) / 10;
---

<figure class="rcs-plot">
  <div class="rcs-plot__frame rounded-[var(--radius-card)] border border-navy-100 shadow-[var(--shadow-md)]">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label={t.ariaLabel}
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="0.35" y2="1">
          <stop offset="0" stop-color="#0c3151"></stop>
          <stop offset="1" stop-color="#081f36"></stop>
        </linearGradient>
        <pattern id={`${uid}-dots`} width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="1.1" cy="1.1" r="1.1" fill="#4f93c4" fill-opacity="0.16"></circle>
        </pattern>
        <marker id={`${uid}-arrow-up`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 Z" fill="#6ba7d2"></path>
        </marker>
        <marker id={`${uid}-arrow-down`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 Z" fill="#4fd07f"></path>
        </marker>
      </defs>

      <rect width={W} height={H} fill={`url(#${uid}-bg)`}></rect>
      <rect width={W} height={H} fill={`url(#${uid}-dots)`}></rect>

      <!-- Corsia dello stato: dalla cabina alla Control Room. -->
      <line
        x1={blocchi[0].cx}
        y1={laneY1}
        x2={blocchi[3].cx}
        y2={laneY1}
        stroke="#6ba7d2"
        stroke-width="1.6"
        marker-end={`url(#${uid}-arrow-up)`}
      ></line>

      <!-- Corsia del comando: dalla Control Room alla cabina, con la
           richiusura automatica in evidenza fra RCS e cabina. -->
      <line x1={blocchi[3].cx} y1={laneY2} x2={blocchi[1].cx} y2={laneY2} stroke="#4fd07f" stroke-opacity="0.55" stroke-width="1.6"></line>
      <line
        x1={blocchi[1].cx}
        y1={laneY2}
        x2={blocchi[0].cx}
        y2={laneY2}
        stroke="#4fd07f"
        stroke-width="2.2"
        marker-end={`url(#${uid}-arrow-down)`}
      ></line>

      <!-- Blocchi. -->
      {
        blocchi.map((b) => (
          <g>
            <rect
              x={n(b.cx - boxW / 2)}
              y={boxY}
              width={boxW}
              height={boxH}
              rx="8"
              fill="#0e3457"
              stroke="#6ba7d2"
              stroke-opacity="0.6"
              stroke-width="1.4"
            />
            <text
              x={n(b.cx)}
              y={boxY + 27}
              text-anchor="middle"
              font-family="Sora, Inter Variable, Inter, sans-serif"
              font-size="13"
              font-weight="700"
              fill="#e7f0f7"
            >
              {b.t1}
            </text>
            <text
              x={n(b.cx)}
              y={boxY + 52}
              text-anchor="middle"
              font-family="Inter Variable, Inter, sans-serif"
              font-size="10.5"
              fill="#bcd6e8"
              fill-opacity="0.85"
            >
              {b.t2}
            </text>
          </g>
        ))
      }

      <!-- Collegamenti verticali fra blocco e corsia, brevi e discreti. -->
      <g stroke="#3f7fb0" stroke-opacity="0.45" stroke-width="1">
        {blocchi.map((b) => <line x1={n(b.cx)} y1={laneY1} x2={n(b.cx)} y2={boxY} />)}
        {blocchi.map((b) => <line x1={n(b.cx)} y1={boxY + boxH} x2={n(b.cx)} y2={laneY2} />)}
      </g>

      <!-- Etichette delle due corsie. -->
      <g font-family="Inter Variable, Inter, sans-serif" font-size="10.5" font-weight="700" letter-spacing="0.06em">
        <text x={blocchi[0].cx} y={laneY1 - 12} fill="#8fbfe0">{t.stato}</text>
        <text x={blocchi[3].cx} y={laneY2 + 22} text-anchor="end" fill="#8fd9ab">{t.comando}</text>
        <text x={n((blocchi[0].cx + blocchi[1].cx) / 2)} y={laneY2 + 22} text-anchor="middle" fill="#8fd9ab">
          {t.richiusura}
        </text>
      </g>

      <!-- Cornice con tacche d'angolo. -->
      <rect x="14" y="14" width={W - 28} height={H - 28} rx="6" fill="none" stroke="#6ba7d2" stroke-opacity="0.26" stroke-width="1"></rect>
      <g stroke="#8fd9ab" stroke-opacity="0.5" stroke-width="1.4" stroke-linecap="square">
        <line x1="14" y1="38" x2="14" y2="14"></line>
        <line x1="14" y1="14" x2="38" y2="14"></line>
        <line x1={W - 38} y1="14" x2={W - 14} y2="14"></line>
        <line x1={W - 14} y1="14" x2={W - 14} y2="38"></line>
        <line x1="14" y1={H - 38} x2="14" y2={H - 14}></line>
        <line x1="14" y1={H - 14} x2="38" y2={H - 14}></line>
        <line x1={W - 38} y1={H - 14} x2={W - 14} y2={H - 14}></line>
        <line x1={W - 14} y1={H - 14} x2={W - 14} y2={H - 38}></line>
      </g>
    </svg>
  </div>

  <figcaption class="rcs-plot__caption">
    <span class="rcs-plot__dot" aria-hidden="true"></span>
    <span>
      <strong>{t.caption}</strong>
      <span class="rcs-plot__caption-sub">
        {t.captionSub}
      </span>
    </span>
  </figcaption>
</figure>

<style>
  .rcs-plot__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 2 / 1;
    background: #0a2a44;
  }

  .rcs-plot__frame svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 767px) {
    .rcs-plot__frame svg text {
      font-size: 15px;
    }
  }

  .rcs-plot__caption {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.85rem;
    padding-left: 0.15rem;
    color: currentColor;
    font-size: var(--fs-small);
    line-height: 1.35;
  }

  .rcs-plot__caption strong {
    display: block;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .rcs-plot__caption-sub {
    display: block;
    color: color-mix(in srgb, currentColor 62%, transparent);
    font-size: var(--fs-micro);
  }

  .rcs-plot__dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    border-radius: 999px;
    background: #2fa85f;
    box-shadow: 0 0 0 4px rgb(79 208 127 / 0.22);
  }
</style>
