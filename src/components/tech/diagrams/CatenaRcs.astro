---
/**
 * Diagramma a catena per il monitoraggio di cabina MT con RCS.
 *
 * Non è una misura ma un sistema, quindi non un grafico bensì una catena a
 * blocchi: cabina MT, unità RCS in campo, collegamento dati, Control Room.
 * Due frecce percorrono la catena in versi opposti — lo stato che risale
 * dalla cabina alla Control Room, il comando che ridiscende — con la
 * richiusura automatica evidenziata come l'unico evento che l'algoritmo RCS
 * decide da solo, senza attendere l'operatore. Disegnata sulla griglia
 * condivisa `SchemaFrame`/`BlockChain`, come le altre catene delle pagine
 * tecniche.
 */
import type { Lingua } from '../../../i18n/routes.ts';
import SchemaFrame from './SchemaFrame.astro';
import BlockChain from './BlockChain.astro';

interface Props {
  lingua: Lingua;
}

const { lingua } = Astro.props;

const TESTI = {
  it: {
    ariaLabel:
      "Catena a quattro blocchi: cabina MT, unità RCS in campo, collegamento dati, Control Room. Una freccia superiore porta lo stato dell'impianto dalla cabina alla Control Room, una freccia inferiore riporta il comando dalla Control Room alla cabina. La richiusura automatica dopo un guasto estinto, decisa dall'unità RCS senza attesa dell'operatore, è evidenziata in verde sulla corsia di comando.",
    blocchi: [
      { t1: 'Cabina MT', t2: 'Interruttore, sensori' },
      // "Analisi guasto in campo" e "Amon Energy, 24/7" andrebbero a capo su
      // tre righe nel box: righe() ne tiene solo due e perderebbe una parola.
      { t1: 'Unità RCS', t2: 'Analisi in campo' },
      // "Collegamento dati" esce dal box a 390px (misurato nel browser, non
      // stimato): "Collegamento" da solo è troppo largo al font mobile.
      { t1: 'Link dati', t2: 'Rete cellulare' },
      { t1: 'Control Room', t2: 'Assistenza 24/7' },
    ],
    stato: 'STATO',
    comando: 'COMANDO',
    richiusura: 'RICHIUSURA AUTOMATICA',
    caption: 'Stato che risale, comando che ridiscende',
    captionSub: 'Catena esemplificativa · cabina MT, unità RCS, collegamento dati, Control Room',
  },
  en: {
    ariaLabel:
      'Four-block chain: MV substation, field RCS unit, data link, Control Room. An upper arrow carries the plant status from the substation up to the Control Room, a lower arrow carries the command from the Control Room down to the substation. The automatic reclosing after a cleared fault, decided by the RCS unit without waiting for an operator, is highlighted in green on the command lane.',
    blocchi: [
      { t1: 'MV substation', t2: 'Breaker, sensors' },
      { t1: 'RCS unit', t2: 'On-site analysis' },
      { t1: 'Data link', t2: 'Cellular network' },
      { t1: 'Control Room', t2: 'Support 24/7' },
    ],
    stato: 'STATUS',
    comando: 'COMMAND',
    richiusura: 'AUTOMATIC RECLOSING',
    caption: 'Status goes up, command comes down',
    captionSub: 'Sample chain · MV substation, RCS unit, data link, Control Room',
  },
} as const;

const t = TESTI[lingua];
---

<SchemaFrame uid="rcs" ariaLabel={t.ariaLabel} didascalia={t.caption} didascaliaSub={t.captionSub}>
  <BlockChain
    uid="rcs"
    blocchi={t.blocchi.map((b, i) => ({ ...b, accento: i === 1 }))}
    sopra={{ etichetta: t.stato }}
    sotto={{ etichetta: t.comando, evidenza: t.richiusura }}
  />
</SchemaFrame>
