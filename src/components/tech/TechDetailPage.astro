---
// Corpo condiviso delle pagine tecniche di dettaglio (SFRA, scariche
// parziali, RCS...): tutto ciò che in `src/pages/servizi/[slug].astro` non
// era già delegato a un sotto-componente. Estratto qui perché la gemella
// inglese (`src/pages/en/services/[slug].astro`) ha la stessa struttura e le
// stesse regole (stesso ordine di sezioni, foto di cover presa dal
// frontmatter: la gemella EN usa lo stesso jpg, cambia solo l'alt): senza
// questo componente le due route dovrebbero ricopiare lo stesso markup, e
// sarebbe solo questione di tempo prima che divergessero.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SpecPanel from '../../components/tech/SpecPanel.astro';
import ProcessSteps from '../../components/tech/ProcessSteps.astro';
import ParamGrid from '../../components/tech/ParamGrid.astro';
import TechFaq from '../../components/tech/TechFaq.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { DIAGRAMMI } from '../../components/tech/diagrams/index.ts';
import { contatti } from '../../data/contatti.ts';
import type { Lingua } from '../../i18n/routes.ts';

interface Correlato {
  href: string;
  titolo: string;
  lead?: string;
  area?: 'diagnostica' | 'controllo';
}

interface Props {
  voce: CollectionEntry<'serviziDettaglio'>;
  correlati: Correlato[];
  progetto?: CollectionEntry<'progetti'>;
  lingua: Lingua;
  hrefLavori: string;
}

const TESTI = {
  it: {
    eyebrowHero: 'Verifiche strumentali',
    cheCosaRivela: 'Che cosa rivela',
    cheCosaRivelaTitolo: 'Che cosa misura, e perché conta.',
    parametriProva: 'Parametri di prova',
    parametriTitolo: 'I numeri che definiscono la misura.',
    comeSiSvolge: 'Come si svolge',
    comeSiSvolgeTitolo: 'Dalla messa in sicurezza al referto.',
    normaRiferimento: 'Norma di riferimento',
    strumentazione: 'Strumentazione',
    assettoMisura: 'Assetto di misura',
    inCampo: 'In campo',
    casoRealeFallback: 'Un caso reale',
    guardaOpere: 'Guarda le opere realizzate',
    domandeFrequenti: 'Domande frequenti',
    domandeFrequentiTitolo: 'Quello che ci chiedono prima di chiamarci.',
    faqTesto: 'Se la tua domanda non è qui, chiamaci: risponde un tecnico, non un centralino.',
    chiamaci: 'Chiamaci',
    verificheCollegate: 'Verifiche collegate',
    verificheCollegateTitolo: 'Spesso si eseguono nella stessa campagna.',
    approfondisci: 'Approfondisci',
  },
  en: {
    eyebrowHero: 'Instrumental testing',
    cheCosaRivela: 'What it reveals',
    cheCosaRivelaTitolo: 'What it measures, and why it matters.',
    parametriProva: 'Test parameters',
    parametriTitolo: 'The numbers that define the measurement.',
    comeSiSvolge: 'How it works',
    comeSiSvolgeTitolo: 'From lock-out/tag-out to the report.',
    normaRiferimento: 'Reference standard',
    strumentazione: 'Instrumentation',
    assettoMisura: 'Test setup',
    inCampo: 'In the field',
    casoRealeFallback: 'A real case',
    guardaOpere: 'See our completed projects',
    domandeFrequenti: 'Frequently asked questions',
    domandeFrequentiTitolo: "What clients ask us before they call.",
    faqTesto: 'If your question is not here, call us: a technician answers, not a switchboard.',
    chiamaci: 'Call us',
    verificheCollegate: 'Related tests',
    verificheCollegateTitolo: 'Often run in the same campaign.',
    approfondisci: 'Learn more',
  },
} as const;

const { voce, correlati, progetto, lingua, hrefLavori } = Astro.props;
const d = voce.data;
const t = TESTI[lingua];

const Diagramma = DIAGRAMMI[d.diagramma as keyof typeof DIAGRAMMI];
if (!Diagramma) throw new Error(`servizi/${voce.id}: diagramma "${d.diagramma}" non in DIAGRAMMI`);

// Icona delle card "Verifiche collegate": la stessa dispatch di ServiceCard,
// scelta dall'area della pagina sorella (`diagnostica`/`controllo`) invece che
// da un'icona per pagina, così le sorelle non ancora scritte restano coerenti.
const ICONA_AREA = { diagnostica: 'fa6-solid:wave-square', controllo: 'fa6-solid:tower-broadcast' } as const;

// Dalla fascia "Norma" in poi i fondi si alternano per posizione, sulle sole
// fasce presenti: senza caso reale la FAQ sale di un posto e cambia colore,
// così due fasce uguali non si toccano mai.
const coda = ['norma', ...(d.caso ? ['caso'] : []), 'faq', 'correlati'] as const;
const FONDI = ['bg-paper', 'bg-navy-100'] as const;
const fondo = (k: (typeof coda)[number]) => FONDI[coda.indexOf(k) % 2];

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: d.titolo,
  serviceType: d.titolo,
  description: d.seoDescription,
  areaServed: { '@type': 'Place', name: 'Centro-Sud Italia' },
  provider: { '@type': 'Organization', name: contatti.ragioneSociale, url: Astro.site?.toString() },
};

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.map((f) => ({
    '@type': 'Question',
    name: f.d,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};
---

<Base title={d.seoTitle} description={d.seoDescription} structuredData={[service, faqPage]} breadcrumbName={d.titolo}>
  <PageHero eyebrow={t.eyebrowHero} h1={d.titolo} sub={d.lead} image={d.copertina} imageAlt={d.copertinaAlt} />

  <!-- Il problema, e accanto il grafico che lo mostra -->
  <section class="bg-paper">
    <div class="wrap-wide py-20 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-start lg:gap-16">
        <div>
          <div class="ds-eyebrow" data-reveal>
            <span class="ds-eyebrow-dash"></span>
            <span class="ds-eyebrow-label">{t.cheCosaRivela}</span>
          </div>
          <h2 class="text-headline max-w-[22ch]" data-reveal style="--reveal-delay:60ms">{t.cheCosaRivelaTitolo}</h2>
          <div class="mt-6 flex flex-col gap-5" data-reveal style="--reveal-delay:100ms">
            {d.problema.map((p) => <p class="measure text-body text-ink/75">{p}</p>)}
          </div>
        </div>
        <div class="lg:sticky lg:top-28" data-reveal style="--reveal-delay:160ms">
          <Diagramma lingua={lingua} />
        </div>
      </div>
    </div>
  </section>

  <!-- Parametri di prova -->
  <section class="bg-navy-100">
    <div class="wrap-wide py-20 lg:py-28">
      <div class="ds-eyebrow" data-reveal>
        <span class="ds-eyebrow-dash"></span>
        <span class="ds-eyebrow-label">{t.parametriProva}</span>
      </div>
      <h2 class="text-headline max-w-[24ch]" data-reveal style="--reveal-delay:80ms">
        {t.parametriTitolo}
      </h2>
      <div class="mt-10" data-reveal style="--reveal-delay:140ms">
        <ParamGrid voci={d.parametri} />
      </div>
    </div>
  </section>

  <!-- Come si svolge. ProcessSteps eredita il colore dal contesto: su navy la
       sezione deve portare `text-paper`, altrimenti il testo sparisce. -->
  <section class="bg-navy-950 text-paper">
    <div class="wrap-wide py-20 lg:py-28">
      <div class="ds-eyebrow" data-reveal>
        <span class="ds-eyebrow-dash"></span>
        <span class="ds-eyebrow-label ds-eyebrow-label--signal">{t.comeSiSvolge}</span>
      </div>
      <h2 class="text-control max-w-[24ch]" data-reveal style="--reveal-delay:80ms">
        {t.comeSiSvolgeTitolo}
      </h2>
      <div class="mt-12" data-reveal style="--reveal-delay:140ms">
        <ProcessSteps fasi={d.fasi} />
      </div>
    </div>
  </section>

  <!-- Norma di riferimento e strumentazione -->
  <section class={fondo('norma')}>
    <div class="wrap-wide py-20 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-start lg:gap-14">
        <div>
          <div class="ds-eyebrow" data-reveal>
            <span class="ds-eyebrow-dash"></span>
            <span class="ds-eyebrow-label">{t.normaRiferimento}</span>
          </div>
          <h2 class="text-headline mt-1" data-reveal style="--reveal-delay:80ms">{d.norma.codice}</h2>
          {/* Il titolo ufficiale della norma si cita come è pubblicato, lineetta
            compresa: è un nome proprio, non una pausa del nostro testo. */}
        <p class="text-title mt-2 text-ink/70" data-reveal style="--reveal-delay:110ms"><cite class="not-italic" data-titolo-norma>{d.norma.titolo}</cite></p>
          <p class="measure text-body mt-5 text-ink/75" data-reveal style="--reveal-delay:150ms">{d.norma.note}</p>
        </div>
        <div class="flex flex-col gap-5" data-reveal style="--reveal-delay:200ms">
          <SpecPanel
            titolo={t.strumentazione}
            voci={d.strumentazione.map((s) => ({ etichetta: s.modello, valore: s.nota }))}
          />
          {d.assettoMisura && <SpecPanel titolo={t.assettoMisura} voci={d.assettoMisura} />}
        </div>
      </div>
    </div>
  </section>

  {
    d.caso && (
      <section class={fondo('caso')}>
        <div class="wrap-wide py-20 lg:py-28">
          <div class:list={['grid items-center gap-12 lg:gap-16', progetto?.data.immagine && 'lg:grid-cols-[1.05fr_0.95fr]']}>
            <div>
              <div class="ds-eyebrow" data-reveal>
                <span class="ds-eyebrow-dash" />
                <span class="ds-eyebrow-label">{t.inCampo}</span>
              </div>
              <h2 class="text-headline max-w-[22ch]" data-reveal style="--reveal-delay:80ms">
                {(lingua === 'en' ? (progetto?.data.titoloEn ?? progetto?.data.titolo) : progetto?.data.titolo) ?? t.casoRealeFallback}
              </h2>
              <p class="measure text-body mt-5 text-ink/75" data-reveal style="--reveal-delay:130ms">{d.caso.testo}</p>
              <a href={hrefLavori} class="ds-btn-secondary mt-8 inline-flex" data-reveal style="--reveal-delay:180ms">
                {t.guardaOpere}
              </a>
            </div>
            {progetto?.data.immagine && (
              <figure class="tech-figure" data-reveal style="--reveal-delay:120ms">
                <Image
                  src={progetto.data.immagine}
                  alt={lingua === 'en' ? (progetto.data.immagineAltEn ?? progetto.data.immagineAlt) : progetto.data.immagineAlt}
                  class="tech-figure__img"
                  widths={[600, 900, 1200]}
                  sizes="(min-width: 1024px) 44vw, 100vw"
                />
              </figure>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- Domande frequenti. Il JSON-LD FAQPage lo emette questa pagina, non il
       componente: qui ci sono tutte le domande in un posto solo. -->
  <section class={fondo('faq')}>
    <div class="wrap-wide py-20 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:gap-16">
        <div class="lg:sticky lg:top-28" data-faq-intro>
          <div class="ds-eyebrow" data-reveal>
            <span class="ds-eyebrow-dash"></span>
            <span class="ds-eyebrow-label">{t.domandeFrequenti}</span>
          </div>
          <h2 class="text-headline max-w-[18ch]" data-reveal style="--reveal-delay:80ms">{t.domandeFrequentiTitolo}</h2>
          <p class="measure text-body mt-5 text-ink/75" data-reveal style="--reveal-delay:120ms">{t.faqTesto}</p>
          <a href={contatti.telefonoHref} class="ds-btn-primary mt-8 inline-flex" data-reveal style="--reveal-delay:160ms">
            {t.chiamaci}: {contatti.telefono}
          </a>
        </div>
        <div data-reveal style="--reveal-delay:140ms">
          <TechFaq domande={d.faq} />
        </div>
      </div>
    </div>
  </section>

  <!-- Pagine sorelle: senza questi link ogni pagina tecnica sarebbe un vicolo
       cieco, per il lettore e per il crawler. Stesse ServiceCard della
       griglia /servizi/, non più un box bianco a sé: le pagine tecniche non
       hanno bisogno di un terzo linguaggio di card. -->
  <section class={fondo('correlati')}>
    <div class="wrap-wide py-20 lg:py-28">
      <div class="ds-eyebrow" data-reveal>
        <span class="ds-eyebrow-dash"></span>
        <span class="ds-eyebrow-label">{t.verificheCollegate}</span>
      </div>
      <h2 class="text-headline max-w-[24ch]" data-reveal style="--reveal-delay:80ms">
        {t.verificheCollegateTitolo}
      </h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6" data-correlati>
        {correlati.map((c, i) => (
          <div data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <ServiceCard
              titolo={c.titolo}
              excerpt={c.lead ?? ''}
              icona={ICONA_AREA[c.area ?? 'diagnostica']}
              href={c.href}
              index={i + 1}
              accent="signal"
              elevated
              ctaLabel={t.approfondisci}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pre-footer classico: la stessa CtaBand della home, con fotografia, così
       le pagine tecniche chiudono come il resto del sito. -->
  <CtaBand lingua={lingua} />
</Base>

<style>
  .tech-figure {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
    border: 1px solid color-mix(in srgb, var(--color-navy-900) 10%, transparent);
    box-shadow: var(--shadow-md);
  }
  .tech-figure__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.05);
  }
</style>
