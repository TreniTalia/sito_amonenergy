---
// Pannello di specifiche tecniche (norme, soglie, portata di prova...) per le
// pagine diagnostica. Vetro navy come ControlPillar/StatBar — la superficie
// del pannello (`.ds-panel`, tinta navy-800 all'82%) porta il proprio
// contrasto: il componente resta leggibile sia su una pagina a fondo chiaro
// sia su una fascia navy scura, senza bisogno di una variante.
interface Props {
  titolo: string;
  voci: { etichetta: string; valore: string }[];
}

const { titolo, voci } = Astro.props;
---

<div class="spec-panel ds-panel">
  <div class="spec-panel__eyebrow">
    <span class="spec-panel__dash" aria-hidden="true"></span>
    <span class="spec-panel__title">{titolo}</span>
  </div>
  <dl class="spec-panel__list">
    {
      voci.map((v) => (
        <div class="spec-panel__row">
          <dt class="spec-panel__label">{v.etichetta}</dt>
          <dd class="spec-panel__value">{v.valore}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .spec-panel {
    padding: 28px 26px;
  }

  .spec-panel__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
  }

  /* Tacca verde: stessa logica micro-accento della mira di CoverageMap — un
     segno, non una superficie. */
  .spec-panel__dash {
    width: 22px;
    height: 2px;
    flex: none;
    background: var(--color-green-400);
  }

  .spec-panel__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 110%;
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy-100);
  }

  .spec-panel__list {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .spec-panel__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 13px 0;
    /* Linea sottile richiesta dal brief: 12% di paper, non un bordo pieno. */
    border-bottom: 1px solid color-mix(in srgb, var(--color-paper) 12%, transparent);
  }

  .spec-panel__row:last-child {
    border-bottom: none;
    padding-bottom: 2px;
  }

  .spec-panel__row:first-child {
    padding-top: 2px;
  }

  .spec-panel__label {
    margin: 0;
    font-size: var(--fs-small);
    line-height: var(--lh-small, 1.4);
    color: color-mix(in srgb, var(--color-navy-100) 78%, transparent);
  }

  /* Sono misure: cifre tabulari perché la colonna dei valori deve restare
     allineata riga dopo riga, non "ballare" con cifre di larghezza diversa. */
  .spec-panel__value {
    margin: 0;
    flex: none;
    text-align: right;
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    font-size: var(--fs-small);
    color: var(--color-paper);
  }
</style>
