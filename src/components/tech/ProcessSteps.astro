---
// Sequenza di fasi (es. "come si esegue la prova SFRA"), numerate e collegate
// da una linea di processo: verticale impilata su mobile, orizzontale da
// 768px. Il cerchio del numero ha solo un bordo verde sottile — mai un
// riempimento — così il verde resta il micro-accento prescritto da DESIGN.md.
interface Props {
  fasi: { titolo: string; testo: string }[];
}

const { fasi } = Astro.props;
---

<ol class="process-steps">
  {
    fasi.map((f, i) => (
      <li class="process-steps__item">
        <div class="process-steps__marker" aria-hidden="true">
          <span class="process-steps__num">{i + 1}</span>
        </div>
        <div class="process-steps__body">
          <h3 class="process-steps__title">{f.titolo}</h3>
          <p class="process-steps__text">{f.testo}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .process-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .process-steps__item {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    position: relative;
  }

  .process-steps__marker {
    display: flex;
    justify-content: center;
  }

  /* Segmento di linea sotto ogni marker tranne l'ultimo: colonna verticale su
     mobile. Neutra (hairline chiaro), non verde: il verde resta sul bordo del
     cerchio, non si spande lungo tutta la sequenza. */
  .process-steps__item:not(:last-child) .process-steps__marker::after {
    content: '';
    position: absolute;
    top: 40px;
    left: 20px;
    width: 1px;
    /* Copre tutto lo spazio fino al marker successivo, gap incluso. */
    height: calc(100% - 40px + 28px);
    background: color-mix(in srgb, var(--color-navy-100, #e8eff5) 22%, transparent);
  }

  .process-steps__num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 999px;
    border: 1.4px solid var(--color-green-400);
    background: transparent;
    font-family: var(--font-display);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    font-size: 0.95rem;
    color: var(--color-green-400);
  }

  .process-steps__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-title, 1.375rem);
    line-height: 1.25;
    margin: 0 0 6px;
  }

  .process-steps__text {
    margin: 0;
    font-size: var(--fs-small);
    line-height: var(--lh-body, 1.65);
    color: color-mix(in srgb, currentColor 78%, transparent);
    max-width: 52ch;
  }

  /* Da 768px: sequenza orizzontale, linea che corre sopra i cerchi invece che
     sotto — la lettura in questa direzione parte dall'alto. */
  @media (min-width: 768px) {
    .process-steps {
      flex-direction: row;
      align-items: flex-start;
      gap: 0;
    }

    .process-steps__item {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      flex: 1;
      padding: 0 14px;
    }

    .process-steps__item:not(:last-child) .process-steps__marker::after {
      top: 19px;
      /* Il marker segue il centro dell'item (`justify-items: center`): dal suo
         centro al centro dell'item successivo corre esattamente una larghezza
         di item, dato che tutti gli item hanno la stessa larghezza (`flex: 1`). */
      left: 50%;
      width: 100%;
      height: 1px;
    }

    .process-steps__text {
      max-width: 32ch;
      margin-inline: auto;
    }
  }
</style>
