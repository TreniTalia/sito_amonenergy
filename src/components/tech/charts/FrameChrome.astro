---
/**
 * Telaio condiviso dai disegni tecnici del sito: i grafici a dati
 * (`ChartFrame`) e gli schemi a blocchi (`SchemaFrame`). È la parte che non
 * cambia mai da un disegno all'altro — fondo navy sfumato, trama a puntini,
 * cornice con tacche d'angolo da strumento, didascalia con il pallino verde.
 *
 * Due modalità, dietro `mode`:
 * - 'svg' (default, usata da `ChartFrame`): il contenuto è SVG a coordinate
 *   fisse 640×440, la tela su cui assi e serie si posizionano per numero.
 * - 'html' (usata da `SchemaFrame`): il contenuto è HTML/CSS reale, che va a
 *   capo da solo e decide da sé quanto spazio occupare — un telaio a misura
 *   del contenuto, non una tela fissa. Fondo, trama e tacche d'angolo
 *   diventano proprietà CSS invece di rect/line SVG, con gli stessi colori.
 *
 * Il nome BEM dei pezzi (`${figureClass}__frame` ecc.) tiene i selettori
 * `figure.chart`/`.chart__legend`/… di `ChartFrame` invariati: qui dentro
 * serve solo a comporre la classe, la resa nel DOM non cambia.
 */
interface Props {
  /** ID univoco per i riferimenti SVG (gradiente, trama): solo in modalità 'svg'. */
  uid?: string;
  ariaLabel: string;
  didascalia: string;
  didascaliaSub: string;
  /** Prefisso BEM del disegno chiamante: 'chart' o 'schema'. */
  figureClass: string;
  /** 'svg' (default) = tela fissa 640×440; 'html' = contenuto reale, telaio a misura. */
  mode?: 'svg' | 'html';
}
const { uid, ariaLabel, didascalia, didascaliaSub, figureClass, mode = 'svg' } = Astro.props;

const W = 640;
const H = 440;
---

<figure class={figureClass}>
  {mode === 'html' ? (
    <div
      class={`${figureClass}__frame fc-frame fc-frame--html rounded-[var(--radius-card)] border border-navy-100 shadow-[var(--shadow-md)]`}
      role="group"
      aria-label={ariaLabel}
    >
      <span class="fc-corner fc-corner--tl" aria-hidden="true"></span>
      <span class="fc-corner fc-corner--tr" aria-hidden="true"></span>
      <span class="fc-corner fc-corner--bl" aria-hidden="true"></span>
      <span class="fc-corner fc-corner--br" aria-hidden="true"></span>
      <div class="fc-html-content">
        <slot />
      </div>
    </div>
  ) : (
    <div class={`${figureClass}__frame fc-frame rounded-[var(--radius-card)] border border-navy-100 shadow-[var(--shadow-md)]`}>
      <slot name="legend" />
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={ariaLabel} preserveAspectRatio="xMidYMid meet">
        <defs>
          <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="0.35" y2="1">
            <stop offset="0" stop-color="#0c3151"></stop>
            <stop offset="1" stop-color="#081f36"></stop>
          </linearGradient>
          <pattern id={`${uid}-dots`} width="24" height="24" patternUnits="userSpaceOnUse">
            <circle cx="1.1" cy="1.1" r="1.1" fill="#4f93c4" fill-opacity="0.16"></circle>
          </pattern>
          <slot name="defs" />
        </defs>
        <rect width={W} height={H} fill={`url(#${uid}-bg)`}></rect>
        <rect width={W} height={H} fill={`url(#${uid}-dots)`}></rect>

        <slot />

        <rect x="14" y="14" width={W - 28} height={H - 28} rx="6" fill="none" stroke="#6ba7d2" stroke-opacity="0.26"></rect>
        <g stroke="#8fd9ab" stroke-opacity="0.5" stroke-width="1.4" stroke-linecap="square">
          <line x1="14" y1="38" x2="14" y2="14"></line>
          <line x1="14" y1="14" x2="38" y2="14"></line>
          <line x1={W - 38} y1="14" x2={W - 14} y2="14"></line>
          <line x1={W - 14} y1="14" x2={W - 14} y2="38"></line>
          <line x1="14" y1={H - 38} x2="14" y2={H - 14}></line>
          <line x1="14" y1={H - 14} x2="38" y2={H - 14}></line>
          <line x1={W - 38} y1={H - 14} x2={W - 14} y2={H - 14}></line>
          <line x1={W - 14} y1={H - 14} x2={W - 14} y2={H - 38}></line>
        </g>
      </svg>
    </div>
  )}
  <figcaption class={`${figureClass}__caption fc-caption`}>
    <span class={`${figureClass}__dot fc-dot`} aria-hidden="true"></span>
    <span>
      <strong>{didascalia}</strong>
      <span class={`${figureClass}__caption-sub fc-caption-sub`}>{didascaliaSub}</span>
    </span>
  </figcaption>
</figure>

<style>
  /* Stesse regole di sempre (erano in ChartFrame): l'SVG non ha più un
     aspect-ratio fisso in CSS, è il viewBox 640×440 a decidere la propria
     proporzione, come farebbe un'immagine responsive. */
  .fc-frame {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #0a2a44;
  }
  .fc-frame svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Variante 'html': niente più viewBox 640×440, il telaio si dimensiona sul
     proprio contenuto. Fondo e trama diventano proprietà CSS invece di
     rect/pattern SVG, stessi colori e stessa scala (24px di passo, cerchi da
     ~1.1px) della variante SVG. */
  .fc-frame--html {
    position: relative;
    padding: 2.5rem 2rem;
    /* Stessa sfumatura del fondo SVG (`#0c3151` → `#081f36`), qui in CSS. */
    background: linear-gradient(155deg, #0c3151, #081f36);
  }
  .fc-frame--html::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(79, 147, 196, 0.16) 1.1px, transparent 0);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .fc-frame--html::after {
    content: '';
    position: absolute;
    inset: 14px;
    border: 1px solid rgba(107, 167, 210, 0.26);
    border-radius: 6px;
    pointer-events: none;
  }
  /* Tacche d'angolo: un bordo a L da 24px per angolo, stessa lunghezza e
     stesso colore delle tacche SVG (`#8fd9ab`, opacità 0,5, spessore 1.4). */
  .fc-corner {
    position: absolute;
    width: 24px;
    height: 24px;
    pointer-events: none;
  }
  .fc-corner--tl {
    top: 14px;
    left: 14px;
    border-top: 1.4px solid rgba(143, 217, 171, 0.5);
    border-left: 1.4px solid rgba(143, 217, 171, 0.5);
  }
  .fc-corner--tr {
    top: 14px;
    right: 14px;
    border-top: 1.4px solid rgba(143, 217, 171, 0.5);
    border-right: 1.4px solid rgba(143, 217, 171, 0.5);
  }
  .fc-corner--bl {
    bottom: 14px;
    left: 14px;
    border-bottom: 1.4px solid rgba(143, 217, 171, 0.5);
    border-left: 1.4px solid rgba(143, 217, 171, 0.5);
  }
  .fc-corner--br {
    bottom: 14px;
    right: 14px;
    border-bottom: 1.4px solid rgba(143, 217, 171, 0.5);
    border-right: 1.4px solid rgba(143, 217, 171, 0.5);
  }
  .fc-html-content {
    position: relative;
    z-index: 1;
    color: #e7f0f7;
  }

  .fc-caption {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.85rem;
    padding-left: 0.15rem;
    font-size: var(--fs-small);
    line-height: 1.35;
  }
  .fc-caption strong {
    display: block;
    font-weight: 700;
  }
  .fc-caption-sub {
    display: block;
    color: color-mix(in srgb, currentColor 62%, transparent);
    font-size: var(--fs-micro);
  }
  .fc-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    border-radius: 999px;
    background: #2fa85f;
    box-shadow: 0 0 0 4px rgb(79 208 127 / 0.22);
  }
</style>
