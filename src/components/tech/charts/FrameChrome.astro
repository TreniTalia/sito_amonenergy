---
/**
 * Telaio condiviso dai disegni tecnici del sito: i grafici a dati
 * (`ChartFrame`) e gli schemi a blocchi (`SchemaFrame`). È la parte che non
 * cambia mai da un disegno all'altro — fondo navy sfumato, trama a puntini,
 * cornice con tacche d'angolo da strumento, didascalia con il pallino verde.
 *
 * Due modalità, dietro `mode`:
 * - 'svg' (default, usata da `ChartFrame`): il contenuto è SVG a coordinate
 *   fisse 640×440, la tela su cui assi e serie si posizionano per numero.
 *   Sopra la tela c'è la legenda HTML: fondo, trama, cornice interna e
 *   tacche d'angolo sono CSS sul telaio intero, così circondano legenda e
 *   grafico insieme invece di lasciare la legenda fuori dalla cornice.
 *   Cornice e tacche sono misurate in unità della figura (`cqw`), nella
 *   stessa proporzione delle 14 e 24 unità di viewBox del disegno: cadono
 *   sempre nello stesso punto della tela, a qualunque larghezza.
 * - 'html' (usata da `SchemaFrame`): il contenuto è HTML/CSS reale, che va a
 *   capo da solo e decide da sé quanto spazio occupare, un telaio a misura
 *   del contenuto e non una tela fissa. Cornice a 14px e tacche da 24px.
 *
 * Il nome BEM dei pezzi (`${figureClass}__frame` ecc.) tiene i selettori
 * `figure.chart`/`.chart__legend`/… di `ChartFrame` invariati: qui dentro
 * serve solo a comporre la classe, la resa nel DOM non cambia.
 */
interface Props {
  ariaLabel: string;
  didascalia: string;
  didascaliaSub: string;
  /** Prefisso BEM del disegno chiamante: 'chart' o 'schema'. */
  figureClass: string;
  /** 'svg' (default) = tela fissa 640×440; 'html' = contenuto reale, telaio a misura. */
  mode?: 'svg' | 'html';
}
const { ariaLabel, didascalia, didascaliaSub, figureClass, mode = 'svg' } = Astro.props;

const W = 640;
const H = 440;
const angoli = ['tl', 'tr', 'bl', 'br'] as const;
---

<figure class={`${figureClass} fc-figure`}>
  {mode === 'html' ? (
    <div
      class={`${figureClass}__frame fc-frame fc-frame--html rounded-[var(--radius-card)] border border-navy-100 shadow-[var(--shadow-md)]`}
      role="group"
      aria-label={ariaLabel}
    >
      {angoli.map((a) => <span class={`fc-corner fc-corner--${a}`} aria-hidden="true"></span>)}
      <div class="fc-html-content">
        <slot />
      </div>
    </div>
  ) : (
    <div class={`${figureClass}__frame fc-frame fc-frame--svg rounded-[var(--radius-card)] border border-navy-100 shadow-[var(--shadow-md)]`}>
      {angoli.map((a) => <span class={`fc-corner fc-corner--${a}`} aria-hidden="true"></span>)}
      <slot name="legend" />
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={ariaLabel} preserveAspectRatio="xMidYMid meet">
        <defs>
          <slot name="defs" />
        </defs>
        <slot />
      </svg>
    </div>
  )}
  <figcaption class={`${figureClass}__caption fc-caption`}>
    <span class={`${figureClass}__dot fc-dot`} aria-hidden="true"></span>
    <span>
      <strong>{didascalia}</strong>
      <span class={`${figureClass}__caption-sub fc-caption-sub`}>{didascaliaSub}</span>
    </span>
  </figcaption>
</figure>

<style>
  /* La figura è il contenitore di riferimento (`telaio`) per le regole di
     disposizione dei disegni: da 1024px sta in una colonna stretta accanto
     al testo, più stretta che su un tablet in verticale, quindi la larghezza
     della finestra non dice quanto spazio ha davvero il disegno. Il
     contenimento in larghezza impedisce anche al contenuto di allargare la
     colonna della griglia di pagina oltre la sua quota. */
  .fc-figure {
    container: telaio / inline-size;
  }

  /* Telaio comune alle due modalità: sfumatura navy (`#0c3151` → `#081f36`),
     trama a puntini con passo di 24px, cornice interna e tacche d'angolo.
     `--fc-inset` e `--fc-arm` sono la distanza della cornice dal bordo e la
     lunghezza delle tacche, diverse per modalità. */
  .fc-frame {
    --fc-inset: 14px;
    --fc-arm: 24px;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: linear-gradient(155deg, #0c3151, #081f36);
  }
  /* Con la tela SVG cornice e tacche seguono la scala del disegno: 14 e 24
     unità su 640 di larghezza, espresse in larghezza della figura. */
  .fc-frame--svg {
    --fc-inset: calc(14 / 640 * 100cqw);
    --fc-arm: calc(24 / 640 * 100cqw);
  }
  /* L'SVG non ha un aspect-ratio fisso in CSS, è il viewBox 640×440 a
     decidere la propria proporzione, come farebbe un'immagine responsive.
     Sta sopra la trama a puntini del telaio. */
  .fc-frame svg {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
  }

  /* Variante 'html': il telaio si dimensiona sul proprio contenuto. */
  .fc-frame--html {
    padding: 2.5rem 2rem;
  }
  /* Figura stretta (telefoni sotto i 400px): meno margine laterale, così il
     contenuto guadagna una ventina di px senza toccare il bordo interno a
     14px né le tacche d'angolo. */
  @container telaio (width < 22rem) {
    .fc-frame--html {
      padding: 2.25rem 1.4rem;
    }
  }
  .fc-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(79, 147, 196, 0.16) 1.1px, transparent 0);
    background-size: 24px 24px;
    pointer-events: none;
  }
  .fc-frame::after {
    content: '';
    position: absolute;
    inset: var(--fc-inset);
    border: 1px solid rgba(107, 167, 210, 0.26);
    border-radius: 6px;
    pointer-events: none;
  }
  /* Tacche d'angolo: un bordo a L per angolo (`#8fd9ab`, opacità 0,5,
     spessore 1.4), sopra la tela. */
  .fc-corner {
    position: absolute;
    z-index: 2;
    width: var(--fc-arm);
    height: var(--fc-arm);
    pointer-events: none;
  }
  .fc-corner--tl {
    top: var(--fc-inset);
    left: var(--fc-inset);
    border-top: 1.4px solid rgba(143, 217, 171, 0.5);
    border-left: 1.4px solid rgba(143, 217, 171, 0.5);
  }
  .fc-corner--tr {
    top: var(--fc-inset);
    right: var(--fc-inset);
    border-top: 1.4px solid rgba(143, 217, 171, 0.5);
    border-right: 1.4px solid rgba(143, 217, 171, 0.5);
  }
  .fc-corner--bl {
    bottom: var(--fc-inset);
    left: var(--fc-inset);
    border-bottom: 1.4px solid rgba(143, 217, 171, 0.5);
    border-left: 1.4px solid rgba(143, 217, 171, 0.5);
  }
  .fc-corner--br {
    bottom: var(--fc-inset);
    right: var(--fc-inset);
    border-bottom: 1.4px solid rgba(143, 217, 171, 0.5);
    border-right: 1.4px solid rgba(143, 217, 171, 0.5);
  }
  .fc-html-content {
    position: relative;
    z-index: 1;
    color: #e7f0f7;
  }

  .fc-caption {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.85rem;
    padding-left: 0.15rem;
    font-size: var(--fs-small);
    line-height: 1.35;
  }
  .fc-caption strong {
    display: block;
    font-weight: 700;
  }
  .fc-caption-sub {
    display: block;
    color: color-mix(in srgb, currentColor 62%, transparent);
    font-size: var(--fs-micro);
  }
  .fc-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    border-radius: 999px;
    background: #2fa85f;
    box-shadow: 0 0 0 4px rgb(79 208 127 / 0.22);
  }
</style>
