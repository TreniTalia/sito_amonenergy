---
import { proietta, type Scala } from './models/scale.ts';
import FrameChrome from './FrameChrome.astro';

export interface Asse {
  scala: Scala;
  tacche: { v: number; t: string; minore?: boolean }[];
  unita: string;
}
export interface Serie {
  tipo: 'line' | 'scatter';
  punti: [number, number][];
  colore: string;
  spessore?: number;
  raggio?: number;
  opacita?: number;
  /** Asse y di riferimento: 'y' (default) o 'y2'. */
  asse?: 'y' | 'y2';
  legenda?: string;
}
interface Props {
  uid: string;
  ariaLabel: string;
  x: Asse;
  y: Asse;
  y2?: Asse;
  serie: Serie[];
  banda?: { da: number; a: number; etichetta: string };
  didascalia: string;
  didascaliaSub: string;
}
const { uid, ariaLabel, x, y, y2, serie, banda, didascalia, didascaliaSub } = Astro.props;

// Fondo, trama, cornice con tacche e didascalia sono il telaio condiviso
// `FrameChrome` (anche da `SchemaFrame`, Task 8): qui restano solo gli assi e
// le serie, disegnati nello `<slot />` del telaio. W e H devono combaciare con
// le costanti dentro FrameChrome (640×440): la tela non ha un aspect-ratio
// fisso in CSS, è l'SVG stesso (via viewBox) a decidere la propria
// proporzione, ed è un rettangolo un po' meno largo di prima (640×440 invece
// di 640×400) per dare più altezza reale al grafico sugli schermi stretti.
const W = 640, H = 440;
const X0 = 78, X1 = y2 ? 566 : 608, Y0 = 46, Y1 = 370;
const n = (v: number) => Math.round(v * 10) / 10;
const px = (v: number) => n(proietta(x.scala, v, X0, X1));
const py = (v: number, a: 'y' | 'y2' = 'y') => n(proietta((a === 'y2' ? y2! : y).scala, v, Y1, Y0));
const linea = (s: Serie) => s.punti.map(([a, b]) => `${px(a)},${py(b, s.asse)}`).join(' ');
const conLegenda = serie.filter((s) => s.legenda);
---

<FrameChrome uid={uid} ariaLabel={ariaLabel} didascalia={didascalia} didascaliaSub={didascaliaSub} figureClass="chart">
  {conLegenda.length > 0 && (
    <Fragment slot="legend">
      <ul class="chart__legend">
        {conLegenda.map((s) => (
          <li>
            <span class="chart__legend-swatch" aria-hidden="true">
              {s.tipo === 'scatter' ? (
                <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="4.5" fill={s.colore}></circle></svg>
              ) : (
                <svg viewBox="0 0 20 8"><line x1="0" y1="4" x2="20" y2="4" stroke={s.colore} stroke-width="2.6" stroke-linecap="round"></line></svg>
              )}
            </span>
            <span>{s.legenda}</span>
          </li>
        ))}
      </ul>
    </Fragment>
  )}

  <Fragment slot="defs">
    <clipPath id={`${uid}-clip`}><rect x={X0} y={Y0} width={X1 - X0} height={Y1 - Y0}></rect></clipPath>
  </Fragment>

  {banda && (
    <g>
      <rect x={px(banda.da)} y={Y0} width={n(px(banda.a) - px(banda.da))} height={Y1 - Y0} fill="#4fd07f" fill-opacity="0.07" />
      <line x1={px(banda.da)} y1={Y0} x2={px(banda.da)} y2={Y1} stroke="#4fd07f" stroke-opacity="0.45" stroke-dasharray="3 4" />
    </g>
  )}

  <g stroke="#3f7fb0" stroke-width="0.8" opacity="0.22">
    {x.tacche.map((k) => <line x1={px(k.v)} y1={Y0} x2={px(k.v)} y2={Y1} />)}
    {y.tacche.map((k) => <line x1={X0} y1={py(k.v)} x2={X1} y2={py(k.v)} />)}
  </g>
  <g class="chart-axis" stroke="#6ba7d2" stroke-opacity="0.55" stroke-width="1">
    <line x1={X0} y1={Y0} x2={X0} y2={Y1} />
    <line x1={X0} y1={Y1} x2={X1} y2={Y1} />
    {y2 && <line x1={X1} y1={Y0} x2={X1} y2={Y1} />}
  </g>

  <g clip-path={`url(#${uid}-clip)`}>
    {serie.map((s) =>
      s.tipo === 'line' ? (
        <polyline points={linea(s)} fill="none" stroke={s.colore} stroke-width={s.spessore ?? 1.8} stroke-linejoin="round" stroke-linecap="round" opacity={s.opacita ?? 1} />
      ) : (
        <g fill={s.colore} fill-opacity={s.opacita ?? 0.55}>
          {s.punti.map(([a, b]) => <circle cx={px(a)} cy={py(b, s.asse)} r={s.raggio ?? 1.6} />)}
        </g>
      ),
    )}
  </g>

  <g class="chart-label" font-family="Inter Variable, Inter, sans-serif" font-size="12" font-weight="600" letter-spacing="0.06em" fill="#bcd6e8" paint-order="stroke" stroke="#081f36" stroke-width="3.5" stroke-opacity="0.85">
    {x.tacche.map((k, i) => (
      <text class={k.minore ? 'chart-label--minor' : ''} x={px(k.v)} y={Y1 + 22} text-anchor={i === 0 ? 'start' : i === x.tacche.length - 1 ? 'end' : 'middle'}>{k.t}</text>
    ))}
    {y.tacche.map((k) => <text x={X0 - 10} y={py(k.v) + 4} text-anchor="end">{k.t}</text>)}
    {/* Scostamento maggiore di prima (-14): a 390px il font delle tacche
        raddoppia (22 invece di 12) ma questo restava fisso, e il testo
        dell'unità finiva incollato alla prima tacca. */}
    {y.unita && <text x={X0 - 10} y={Y0 - 24} text-anchor="end">{y.unita}</text>}
    {x.unita && <text x={X1} y={Y1 + 54} text-anchor="end">{x.unita}</text>}
    {y2 && y2.tacche.map((k) => <text x={X1 + 10} y={py(k.v, 'y2') + 4} text-anchor="start">{k.t}</text>)}
    {y2 && y2.unita && <text x={X1 + 10} y={Y0 - 24} text-anchor="start">{y2.unita}</text>}
    {banda && <text x={n(px(banda.a) - 8)} y={Y0 + 17} text-anchor="end" fill="#8fd9ab" letter-spacing="0.12em">{banda.etichetta}</text>}
  </g>
</FrameChrome>

<style>
  /* Su 390px la tela è larga ~350px reali: 12 unità di viewBox varrebbero
     meno di 7px. Le etichette crescono nello spazio del disegno. */
  @media (max-width: 767px) {
    .chart-label { font-size: 22px; }
    .chart-label--minor { display: none; }
  }
  /* Legenda in HTML, non più nell'SVG (il testo SVG segue la larghezza del
     viewBox: con tre voci italiane più lunghe si sovrapponeva, sia a 1440 sia
     a 390px, perché la colonna calcolata non teneva conto della larghezza
     reale del testo). In flusso normale, non sovrapposta alla tela: prende
     lo spazio che le serve sopra l'SVG invece di doverlo riservare dentro il
     viewBox. Il padding sinistro allinea la prima voce con l'asse Y del
     grafico (X0/W del viewBox). */
  .chart__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0.6rem 0.9rem 0.4rem 12.2%;
  }
  .chart__legend li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: #bcd6e8;
    white-space: nowrap;
  }
  .chart__legend-swatch { display: flex; width: 1.15rem; height: 0.7rem; flex: none; }
  .chart__legend-swatch svg { width: 100%; height: 100%; overflow: visible; }
</style>
