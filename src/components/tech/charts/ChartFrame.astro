---
import { proietta, type Scala } from './models/scale.ts';
import FrameChrome from './FrameChrome.astro';

export interface Asse {
  scala: Scala;
  tacche: { v: number; t: string; minore?: boolean }[];
  unita: string;
}
export interface Serie {
  tipo: 'line' | 'scatter';
  punti: [number, number][];
  colore: string;
  spessore?: number;
  raggio?: number;
  opacita?: number;
  /** Asse y di riferimento: 'y' (default) o 'y2'. */
  asse?: 'y' | 'y2';
  legenda?: string;
}
interface Props {
  uid: string;
  ariaLabel: string;
  x: Asse;
  y: Asse;
  y2?: Asse;
  serie: Serie[];
  banda?: { da: number; a: number; etichetta: string };
  didascalia: string;
  didascaliaSub: string;
}
const { uid, ariaLabel, x, y, y2, serie, banda, didascalia, didascaliaSub } = Astro.props;

// Fondo, trama, cornice con tacche e didascalia sono il telaio condiviso
// `FrameChrome` (usato anche da `SchemaFrame` per gli schemi a blocchi): qui
// restano solo gli assi e le serie, disegnati nello `<slot />` del telaio.
// La tela non ha un aspect-ratio fisso in CSS, è l'SVG stesso (via viewBox) a
// decidere la propria proporzione, un rettangolo un po' meno largo che alto
// per dare più altezza reale al grafico sugli schermi stretti.
const W = 640, H = 440;

// Le etichette crescono fino a 22 unità nelle figure più strette (v. lo
// stile in fondo): i margini sinistro e destro si calcolano sulla tacca più
// lunga a quella dimensione, così nessuna esce dalla cornice interna (14
// unità dal bordo) qualunque sia la larghezza. Larghezze dei glifi di Inter
// 600 in em, arrotondate per eccesso, più lo 0,06em di spaziatura.
const FS_MAX = 22;
const CORNICE = 14;
const glifo = (c: string) => (c === ' ' || c === ',' || c === '.' ? 0.3 : c === '-' ? 0.4 : c === '°' ? 0.42 : 0.66) + 0.06;
const larghezza = (t: string) => [...t].reduce((s, c) => s + glifo(c), 0) * FS_MAX;
const piuLunga = (a: Asse | undefined) => Math.max(0, ...(a?.tacche ?? []).map((k) => larghezza(k.t)), larghezza(a?.unita ?? ''));
const X0 = Math.max(64, Math.ceil(CORNICE + 6 + piuLunga(y) + 10));
const X1 = y2 ? Math.min(608, Math.floor(W - CORNICE - 6 - piuLunga(y2) - 10)) : 608;
const Y0 = 46, Y1 = 370;

const n = (v: number) => Math.round(v * 10) / 10;
const px = (v: number) => n(proietta(x.scala, v, X0, X1));
const py = (v: number, a: 'y' | 'y2' = 'y') => n(proietta((a === 'y2' ? y2! : y).scala, v, Y1, Y0));
const linea = (s: Serie) => s.punti.map(([a, b]) => `${px(a)},${py(b, s.asse)}`).join(' ');
const conLegenda = serie.filter((s) => s.legenda);

// Una nuvola di punti è un solo `<path>` di segmenti lunghi zero con estremità
// tonde (un cerchio per punto, di diametro pari allo spessore del tratto),
// non un `<circle>` per punto: il PRPD ne ha 900, e in cerchi pesava 65 KB di
// HTML. I punti vanno su quattro tracciati alternati perché dentro un solo
// tracciato le sovrapposizioni non si sommano: i grumi più densi della
// nuvola resterebbero chiari quanto i punti isolati.
const TRACCIATI = 4;
const nuvola = (s: Serie) =>
  Array.from({ length: TRACCIATI }, (_, k) =>
    s.punti
      .filter((_, i) => i % TRACCIATI === k)
      .map(([a, b]) => `M${px(a)} ${py(b, s.asse)}h0`)
      .join(''),
  ).filter(Boolean);

// L'unità dell'asse X non si ripete se l'ultima tacca la porta già ("2 MHz"
// con unità "Hz"): due righe con la stessa unità una sotto l'altra.
const ultimaX = x.tacche[x.tacche.length - 1]?.t ?? '';
const unitaX = x.unita && !ultimaX.endsWith(x.unita) ? x.unita : '';
---

<FrameChrome ariaLabel={ariaLabel} didascalia={didascalia} didascaliaSub={didascaliaSub} figureClass="chart">
  {conLegenda.length > 0 && (
    <Fragment slot="legend">
      <ul class="chart__legend" style={`padding-left: ${n((X0 / W) * 100)}%`}>
        {conLegenda.map((s) => (
          <li>
            <span class="chart__legend-swatch" aria-hidden="true">
              {s.tipo === 'scatter' ? (
                <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="4.5" fill={s.colore}></circle></svg>
              ) : (
                <svg viewBox="0 0 20 8"><line x1="0" y1="4" x2="20" y2="4" stroke={s.colore} stroke-width="2.6" stroke-linecap="round"></line></svg>
              )}
            </span>
            <span>{s.legenda}</span>
          </li>
        ))}
      </ul>
    </Fragment>
  )}

  <Fragment slot="defs">
    <clipPath id={`${uid}-clip`}><rect x={X0} y={Y0} width={X1 - X0} height={Y1 - Y0}></rect></clipPath>
  </Fragment>

  {banda && (
    <g>
      <rect x={px(banda.da)} y={Y0} width={n(px(banda.a) - px(banda.da))} height={Y1 - Y0} fill="#4fd07f" fill-opacity="0.07" />
      <line x1={px(banda.da)} y1={Y0} x2={px(banda.da)} y2={Y1} stroke="#4fd07f" stroke-opacity="0.45" stroke-dasharray="3 4" />
    </g>
  )}

  <g stroke="#3f7fb0" stroke-width="0.8" opacity="0.22">
    {x.tacche.map((k) => <line x1={px(k.v)} y1={Y0} x2={px(k.v)} y2={Y1} />)}
    {y.tacche.map((k) => <line x1={X0} y1={py(k.v)} x2={X1} y2={py(k.v)} />)}
  </g>
  <g class="chart-axis" stroke="#6ba7d2" stroke-opacity="0.55" stroke-width="1">
    <line x1={X0} y1={Y0} x2={X0} y2={Y1} />
    <line x1={X0} y1={Y1} x2={X1} y2={Y1} />
    {y2 && <line x1={X1} y1={Y0} x2={X1} y2={Y1} />}
  </g>

  <g clip-path={`url(#${uid}-clip)`}>
    {serie.map((s) =>
      s.tipo === 'line' ? (
        <polyline points={linea(s)} fill="none" stroke={s.colore} stroke-width={s.spessore ?? 1.8} stroke-linejoin="round" stroke-linecap="round" opacity={s.opacita ?? 1} />
      ) : (
        <g fill="none" stroke={s.colore} stroke-opacity={s.opacita ?? 0.55} stroke-width={n(2 * (s.raggio ?? 1.6))} stroke-linecap="round">
          {nuvola(s).map((d) => <path d={d} />)}
        </g>
      ),
    )}
  </g>

  <g class="chart-label" font-family="Inter Variable, Inter, sans-serif" font-size="12" font-weight="600" letter-spacing="0.06em" fill="#bcd6e8" paint-order="stroke" stroke="#081f36" stroke-width="3.5" stroke-opacity="0.85">
    {x.tacche.map((k, i) => (
      <text class={k.minore ? 'chart-label--minor' : ''} data-asse="x" x={px(k.v)} y={Y1 + 22} text-anchor={i === 0 ? 'start' : i === x.tacche.length - 1 ? 'end' : 'middle'}>{k.t}</text>
    ))}
    {y.tacche.map((k) => <text data-asse="y" x={X0 - 10} y={py(k.v) + 4} text-anchor="end">{k.t}</text>)}
    {/* Le unità stanno fuori dall'area del grafico: quella dell'asse Y sopra
        la prima tacca, con uno scostamento che regge anche le etichette a 22
        unità; quella dell'asse X sotto l'ultima tacca, abbastanza in alto da
        restare dentro la cornice e fuori dalla tacca d'angolo. */}
    {y.unita && <text class="chart-label__unit" data-asse="y" x={X0 - 10} y={Y0 - 24} text-anchor="end">{y.unita}</text>}
    {unitaX && <text class="chart-label__unit" data-asse="x" x={Math.min(X1, 596)} y={Y1 + 48} text-anchor="end">{unitaX}</text>}
    {y2 && y2.tacche.map((k) => <text data-asse="y2" x={X1 + 10} y={py(k.v, 'y2') + 4} text-anchor="start">{k.t}</text>)}
    {y2 && y2.unita && <text class="chart-label__unit" data-asse="y2" x={X1 + 10} y={Y0 - 24} text-anchor="start">{y2.unita}</text>}
    {banda && <text class="chart-label__band" x={n(px(banda.a) - 8)} y={Y0 + 17} text-anchor="end" fill="#8fd9ab" letter-spacing="0.12em">{banda.etichetta}</text>}
  </g>
</FrameChrome>

<style>
  /* Le etichette sono testo SVG: il loro font-size è in unità di viewBox, e
     in px reali vale font-size × larghezza della figura / 640. La figura non
     segue la finestra (da 1024px sta nella colonna accanto al testo, circa
     400px), quindi le soglie guardano la figura stessa (contenitore
     `telaio` di `FrameChrome`). A ogni gradino il valore è scelto perché al
     limite inferiore del gradino l'etichetta valga ancora almeno 11px. */
  @container telaio (width < 37.5rem) {
    .chart-label { font-size: 15px; }
    .chart-label--minor { display: none; }
  }
  @container telaio (width < 30rem) {
    .chart-label { font-size: 18px; }
  }
  @container telaio (width < 25rem) {
    .chart-label { font-size: 21px; }
  }
  @container telaio (width < 21.25rem) {
    .chart-label { font-size: 22px; }
  }
  /* Legenda in HTML, non nell'SVG: il testo SVG segue la larghezza del
     viewBox, e con tre voci italiane più lunghe si sovrapponeva, perché una
     colonna calcolata non tiene conto della larghezza reale del testo. In
     flusso normale, non sovrapposta alla tela: prende lo spazio che le serve
     sopra l'SVG invece di doverlo riservare dentro il viewBox. Sta dentro la
     cornice interna del telaio (`--fc-inset`): il margine alto la porta sotto
     la cornice, quello destro lontano dalla tacca d'angolo. Il padding
     sinistro, in linea, allinea la prima voce con l'asse Y del grafico. */
  .chart__legend {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: calc(var(--fc-inset) + 0.55rem) calc(var(--fc-inset) + var(--fc-arm) + 0.4rem) 0.4rem 12%;
  }
  .chart__legend li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: #bcd6e8;
    white-space: nowrap;
  }
  .chart__legend-swatch { display: flex; width: 1.15rem; height: 0.7rem; flex: none; }
  .chart__legend-swatch svg { width: 100%; height: 100%; overflow: visible; }
</style>
