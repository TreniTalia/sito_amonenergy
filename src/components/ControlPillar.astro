---
import { Image } from 'astro:assets';
// The real RCS platform. Shown whole (16:9, uncropped) — the dashboard is the
// proof, so cropping it to fit a panel would throw away the argument.
import controlRoom from '../assets/img/rcs/rcs-dashboard.png';
// Traliccio AT reale in controluce (Pexels), stesso trattamento duotone di
// `servizi-controllo-pattern.jpg` in servizi/index.astro: desaturato +
// tinta navy in `mix-blend-mode: color`, non un'illustrazione a sé.
import pattern from '../assets/img/rcs/pattern-grid-twilight.jpg';
import type { Lingua } from '../i18n/routes.ts';

interface Props {
  eyebrow: string;
  titolo: string;
  testo: string;
  /** Link target for the section CTA. */
  href?: string;
  lingua?: Lingua;
}

const SISTEMI = {
  it: [
    {
      tag: 'Control Room',
      titolo: 'Sorveglianza 24/7/365',
      testo:
        '5 tecnici e 1 supervisore dedicati. Tripla ridondanza internet e infrastruttura su cloud AWS: gli impianti restano sorvegliati anche in caso di doppio guasto.',
      specs: ['24/7/365', '3 linee internet', 'Cloud AWS'],
    },
    {
      tag: 'RCS',
      titolo: 'Remote Control System',
      testo:
        'Sistema proprietario di monitoraggio e controllo: analisi guasti in tempo reale, richiusura automatica, reset protezioni da remoto, storicizzazione dati e sistema ticket integrato.',
      specs: ['Richiusura automatica', 'Web App', 'Integrazione SCADA'],
    },
    {
      tag: 'CCI',
      titolo: "Controllore Centrale d'Impianto",
      testo:
        'Conforme a CEI 0-16 V5 e alla Delibera ARERA 564/2025/R/eel. Lettura contatori e gestione del teledistacco A72 inclusi.',
      specs: ['CEI 0-16 V5', 'ARERA 564/2025', 'Teledistacco A72'],
    },
  ],
  en: [
    {
      tag: 'Control Room',
      titolo: '24/7/365 surveillance',
      testo:
        '5 technicians and 1 dedicated supervisor. Triple internet redundancy and AWS cloud infrastructure: plants stay supervised even in the event of a double failure.',
      specs: ['24/7/365', '3 internet lines', 'AWS cloud'],
    },
    {
      tag: 'RCS',
      titolo: 'Remote Control System',
      testo:
        'Our proprietary monitoring and control system: real-time fault analysis, automatic reclosing, remote protection reset, data logging and an integrated ticketing system.',
      specs: ['Automatic reclosing', 'Web App', 'SCADA integration'],
    },
    {
      tag: 'CCI',
      titolo: 'Central Plant Controller',
      testo:
        'Compliant with CEI 0-16 V5 and ARERA Resolution 564/2025/R/eel. Meter reading and A72 remote-tripping management included.',
      specs: ['CEI 0-16 V5', 'ARERA 564/2025', 'A72 remote tripping'],
    },
  ],
} as const;

const CTA_LABEL = {
  it: 'Scopri monitoraggio e controllo',
  en: 'Discover control and monitoring',
} as const;

const { eyebrow, titolo, testo, href = '/servizi/#controllo-e-monitoraggio', lingua = 'it' } = Astro.props;
const sistemi = SISTEMI[lingua];
const ctaLabel = CTA_LABEL[lingua];
---

<section class="control relative isolate overflow-hidden bg-navy-950 text-paper">
  <div class="control-pattern" aria-hidden="true">
    <Image
      src={pattern}
      alt=""
      class="control-pattern-img"
      data-parallax
      widths={[480, 768, 1100, 1800, 2400]}
      sizes="100vw"
    />
    <div class="control-pattern-tint" aria-hidden="true"></div>
  </div>
  <div class="control-glow" aria-hidden="true"></div>

  <div class="wrap-wide relative z-10 py-24 lg:py-32">
    <!-- Intro + live monitor -->
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div>
        <div class="ds-eyebrow" data-reveal>
          <span class="ds-live-dot" aria-hidden="true"></span>
          <span class="ds-eyebrow-label ds-eyebrow-label--signal">{eyebrow}</span>
        </div>
        <h2 class="text-control max-w-[22ch]" data-reveal style="--reveal-delay:80ms">{titolo}</h2>
        <p class="measure text-lead mt-6 text-navy-100" data-reveal style="--reveal-delay:160ms">{testo}</p>
        <a
          href={href}
          class="ds-btn-signal mt-9 inline-flex"
          data-reveal
          style="--reveal-delay:240ms"
        >
          {ctaLabel}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>

      <!-- Live monitor panel -->
      <figure class="monitor ds-panel overflow-hidden" data-reveal style="--reveal-delay:120ms">
        <div class="flex items-center gap-2 border-b border-white/18 px-4 py-3">
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-tier-pro/80"></span>
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-tier-advance/80"></span>
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-tier-basic/80"></span>
          <span class="text-micro ml-3 truncate font-display font-semibold uppercase tracking-[0.12em] text-navy-100/75">
            Amon · Control Room — Castelluccio dei Sauri (FG)
          </span>
          <span class="ml-auto flex shrink-0 items-center gap-2 pl-3">
            <span class="ds-live-dot" aria-hidden="true"></span>
            <span class="text-micro font-display font-bold uppercase tracking-[0.14em] text-navy-100">Live · 24/7</span>
          </span>
        </div>
        <Image
          src={controlRoom}
          alt={
            lingua === 'en'
              ? "Amon Energy's RCS dashboard: 55 plants monitored, 51 online, 2 offline, 8 active alarms, 1,253 MW of instantaneous power, with a plant map and recent alarms"
              : 'La dashboard RCS di Amon Energy: 55 impianti sorvegliati, 51 online, 2 offline, 8 allarmi attivi, 1.253 MW di potenza istantanea, con mappa degli impianti e allarmi recenti'
          }
          class="aspect-[16/9] w-full object-cover"
          widths={[600, 900, 1200, 1672]}
          sizes="(min-width: 1024px) 46vw, 100vw"
        />
      </figure>
    </div>

    <!-- Three systems -->
    <div class="mt-20 grid gap-5 md:grid-cols-3 lg:mt-24 lg:gap-6">
      {
        sistemi.map((s, i) => (
          <article class="ds-panel flex flex-col p-7 lg:p-8" data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <span class="ds-pill self-start">{s.tag}</span>
            <h3 class="text-title mt-5">{s.titolo}</h3>
            <p class="text-small mt-3 text-navy-100/95">{s.testo}</p>
            <ul class="mt-6 flex flex-wrap gap-2 border-t border-white/12 pt-5">
              {s.specs.map((spec) => (
                <li class="text-micro rounded-full border border-white/18 bg-white/8 px-3 py-1 font-display font-medium tracking-wide text-navy-100">
                  {spec}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Pattern di sfondo — traliccio AT reale in controluce, non un'illustrazione
     da mettere in mostra: desaturato e scurito, poi un layer navy in
     `mix-blend-mode: color` (`.control-pattern-tint`, stesso trucco duotone
     di `servizi-controllo-pattern.jpg`) gli impone la tinta del sistema
     invece del blu naturale della foto. La `.control-glow` (sotto) resta
     sopra il pattern e sotto il contenuto, così i suoi bagliori signal/verde
     restano leggibili invariati. Il layer è più alto del contenitore
     (`height: 150%`) per lasciare spazio al traslare verticale della
     parallasse senza scoprire un bordo vuoto. */
  .control-pattern {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .control-pattern-img {
    position: absolute;
    left: 50%;
    top: -25%;
    width: 100%;
    height: 150%;
    max-width: none;
    object-fit: cover;
    object-position: center 30%;
    filter: grayscale(1) brightness(0.85) contrast(1.15);
    opacity: 0.9;
    transform: translate3d(-50%, 0, 0) scale(1);
    will-change: transform;
  }
  .control-pattern-tint {
    position: absolute;
    inset: 0;
    background: var(--color-navy-700);
    mix-blend-mode: color;
  }
  .control-pattern::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--color-navy-950) 0%, transparent 18%, transparent 78%, var(--color-navy-950) 100%),
      linear-gradient(
        100deg,
        color-mix(in srgb, var(--color-navy-950) 95%, transparent) 0%,
        color-mix(in srgb, var(--color-navy-950) 92%, transparent) 22%,
        color-mix(in srgb, var(--color-navy-950) 45%, transparent) 38%,
        transparent 52%
      );
  }

  /* Su telefono la sezione è alta oltre 2000px (i tre pannelli si impilano) e
     una foto in orizzontale, tirata a coprirla tutta, veniva ingrandita fino a
     ~4000px di larghezza: se ne vedeva un decimo, un reticolo di tralicci
     illeggibile e molliccio. Qui il pattern smette di coprire tutta la fascia e
     resta dove serve — l'apertura, sotto occhiello, titolo e monitor — poi
     sfuma nel navy pieno della sezione, che è lo stesso colore con cui il
     gradiente chiude. Il resto della fascia è navy, non un'immagine sgranata.
     Il velo orizzontale del desktop qui non serve: il testo prende tutta la
     larghezza, quindi comanda il solo velo verticale. */
  @media (max-width: 767px) {
    .control-pattern {
      bottom: auto;
      /* L'altezza della fascia decide quanto della foto si vede: `cover` su un
         riquadro più alto che largo scala sull'altezza e taglia ai fianchi,
         quindi più la fascia è alta, più stretta è la fetta di traliccio che
         resta. A ~46svh il riquadro è quasi quadrato e in quadro ci sta il
         traliccio intero, bracci compresi, invece di un dettaglio di reticolo. */
      height: clamp(300px, 46svh, 440px);
    }
    .control-pattern::after {
      background: linear-gradient(
        180deg,
        var(--color-navy-950) 0%,
        color-mix(in srgb, var(--color-navy-950) 35%, transparent) 22%,
        color-mix(in srgb, var(--color-navy-950) 55%, transparent) 62%,
        var(--color-navy-950) 100%
      );
    }
  }
  .control-glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(60% 55% at 78% 8%, color-mix(in srgb, var(--color-navy-700) 55%, transparent), transparent 70%),
      radial-gradient(50% 60% at 0% 100%, color-mix(in srgb, var(--color-navy-800) 60%, transparent), transparent 70%);
  }
  .monitor {
    box-shadow: 0 40px 80px -40px color-mix(in srgb, var(--color-signal-400) 30%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .control-pattern-img {
      transform: translate3d(-50%, 0, 0) scale(1) !important;
    }
  }

  /* `.control` è `overflow-hidden` per tagliare `.control-pattern-img`
     (150% di altezza, posizionato assoluto): questo lo rende un vero scroll
     container per lo scroll-timeline della sezione "Scroll reveal — congedo"
     di global.css, e la `view()` timeline dei suoi `[data-reveal]` si risolve
     contro quel container invece che contro il documento. Ne segue un
     progress sballato, indipendente dallo scroll reale della pagina, che può
     bloccare gli elementi a un'opacità intermedia per sempre (visto su
     mobile). L'hero ha lo stesso problema e lo disattiva già così — qui si
     applica la stessa cura: niente congedo, resta la sola transizione
     d'ingresso via `.is-visible`. */
  .control :global([data-reveal]) {
    animation: none;
  }
</style>

<script>
  // Parallasse reale via transform (mai `background-attachment: fixed`: su
  // iOS Safari ridipinge a ogni frame ed è pessimo per battery/scroll fluido).
  // rAF-throttled, attivo solo mentre la sezione è in viewport
  // (IntersectionObserver), spento del tutto se l'utente preferisce meno
  // movimento — a quel punto il layer resta fermo alla sua posizione base.
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.querySelector<HTMLElement>('.control');
  const layers = document.querySelectorAll<HTMLElement>('.control-pattern-img');

  if (section && layers.length && !prefersReduced) {
    let inView = false;
    let ticking = false;
    const depth = 0.32; // frazione della sezione percorsa che il layer trasla

    const apply = () => {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      const progress = (vh - rect.top) / (vh + rect.height); // 0 all'ingresso, 1 all'uscita
      const raw = (progress - 0.5) * rect.height * depth;
      const scale = 1 + Math.abs(progress - 0.5) * 0.08; // leggero respiro 3D ai bordi
      layers.forEach((layer) => {
        // Il layer è alto 150% del suo contenitore con -25% di top: il margine
        // per lato vale un sesto della sua altezza, ed è tutto quello che la
        // traslata ha a disposizione prima di scoprire un bordo vuoto. Sul
        // desktop la corsa ci sta comodamente dentro; su mobile no — lì il
        // contenitore è una fascia corta ma la sezione è altissima, e senza
        // questo limite l'offset varrebbe il doppio del margine.
        const travel = (layer.offsetHeight / 6) * 0.9;
        const offset = Math.max(-travel, Math.min(travel, raw));
        layer.style.transform = `translate3d(-50%, ${offset.toFixed(1)}px, 0) scale(${scale.toFixed(3)})`;
      });
    };

    const onScroll = () => {
      if (!inView || ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    };

    const io = new IntersectionObserver(
      (entries) => {
        inView = entries[0]?.isIntersecting ?? false;
        if (inView) onScroll();
      },
      { rootMargin: '20% 0px' },
    );
    io.observe(section);
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
