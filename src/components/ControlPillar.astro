---
import { Image } from 'astro:assets';
// The real RCS platform. Shown whole (16:9, uncropped) — the dashboard is the
// proof, so cropping it to fit a panel would throw away the argument.
import controlRoom from '../assets/img/rcs/rcs-dashboard.png';
import patternDesktop from '../assets/img/rcs/pattern-rcs.jpg';
import patternMobile from '../assets/img/rcs/pattern-rcs-mobile.jpg';

interface Props {
  eyebrow: string;
  titolo: string;
  testo: string;
  /** Link target for the section CTA. */
  href?: string;
}

const { eyebrow, titolo, testo, href = '/servizi/#controllo-e-monitoraggio' } = Astro.props;

const sistemi = [
  {
    tag: 'Control Room',
    titolo: 'Sorveglianza 24/7/365',
    testo:
      '5 tecnici e 1 supervisore dedicati. Tripla ridondanza internet e infrastruttura su cloud AWS: gli impianti restano sorvegliati anche in caso di doppio guasto.',
    specs: ['24/7/365', '3 linee internet', 'Cloud AWS'],
  },
  {
    tag: 'RCS',
    titolo: 'Remote Control System',
    testo:
      'Sistema proprietario di monitoraggio e controllo: analisi guasti in tempo reale, richiusura automatica, reset protezioni da remoto, storicizzazione dati e sistema ticket integrato.',
    specs: ['Richiusura automatica', 'Web App', 'Integrazione SCADA'],
  },
  {
    tag: 'CCI',
    titolo: "Controllore Centrale d'Impianto",
    testo:
      'Conforme a CEI 0-16 V5 e alla Delibera ARERA 564/2025/R/eel. Lettura contatori e gestione del teledistacco A72 inclusi.',
    specs: ['CEI 0-16 V5', 'ARERA 564/2025', 'Teledistacco A72'],
  },
];

const tiers = [
  { nome: 'Basic', desc: 'Monitoraggio di base e richiusura automatica.', accent: 'var(--color-signal-400)' },
  { nome: 'Advance', desc: 'In più: acquisizione dati da campo e reset protezioni da remoto.', accent: 'var(--color-green-500)' },
  { nome: 'Pro', desc: 'In più: analisi performance, integrazione SCADA e interfaccia grafica personalizzata.', accent: 'var(--color-green-400)' },
];
---

<section class="control relative isolate overflow-hidden bg-navy-950 text-paper">
  <div class="control-pattern" aria-hidden="true">
    <Image
      src={patternDesktop}
      alt=""
      class="control-pattern-img hidden md:block"
      data-parallax
      widths={[900, 1325, 1800, 2400]}
      sizes="100vw"
      quality={92}
    />
    <Image
      src={patternMobile}
      alt=""
      class="control-pattern-img md:hidden"
      data-parallax
      widths={[480, 768, 1100]}
      sizes="100vw"
      quality={92}
    />
  </div>
  <div class="control-glow" aria-hidden="true"></div>

  <div class="wrap-wide relative z-10 py-24 lg:py-32">
    <!-- Intro + live monitor -->
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div>
        <div class="ds-eyebrow" data-reveal>
          <span class="ds-live-dot" aria-hidden="true"></span>
          <span class="ds-eyebrow-label ds-eyebrow-label--signal">{eyebrow}</span>
        </div>
        <h2 class="text-control max-w-[18ch]" data-reveal style="--reveal-delay:80ms">{titolo}</h2>
        <p class="measure mt-6 text-lg text-navy-100" data-reveal style="--reveal-delay:160ms">{testo}</p>
        <a
          href={href}
          class="ds-btn-signal mt-9 inline-flex"
          data-reveal
          style="--reveal-delay:240ms"
        >
          Scopri monitoraggio e controllo
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>

      <!-- Live monitor panel -->
      <figure class="monitor ds-panel overflow-hidden" data-reveal style="--reveal-delay:120ms">
        <div class="flex items-center gap-2 border-b border-white/18 px-4 py-3">
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-tier-pro/80"></span>
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-tier-advance/80"></span>
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-tier-basic/80"></span>
          <span class="ml-3 truncate font-display text-xs font-semibold uppercase tracking-[0.12em] text-navy-100/75">
            Amon · Control Room — Castelluccio dei Sauri (FG)
          </span>
          <span class="ml-auto flex shrink-0 items-center gap-2 pl-3">
            <span class="ds-live-dot" aria-hidden="true"></span>
            <span class="font-display text-[0.7rem] font-bold uppercase tracking-[0.14em] text-navy-100">Live · 24/7</span>
          </span>
        </div>
        <Image
          src={controlRoom}
          alt="La dashboard RCS di Amon Energy: 55 impianti sorvegliati, 51 online, 2 offline, 8 allarmi attivi, 1.253 MW di potenza istantanea, con mappa degli impianti e allarmi recenti"
          class="aspect-[16/9] w-full object-cover"
          widths={[600, 900, 1200, 1672]}
          sizes="(min-width: 1024px) 46vw, 100vw"
        />
      </figure>
    </div>

    <!-- Three systems -->
    <div class="mt-20 grid gap-5 md:grid-cols-3 lg:mt-24 lg:gap-6">
      {
        sistemi.map((s, i) => (
          <article class="ds-panel flex flex-col p-7 lg:p-8" data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <span class="ds-pill self-start">{s.tag}</span>
            <h3 class="mt-5 font-display text-xl font-bold tracking-tight">{s.titolo}</h3>
            <p class="mt-3 text-sm leading-relaxed text-navy-100/95">{s.testo}</p>
            <ul class="mt-6 flex flex-wrap gap-2 border-t border-white/12 pt-5">
              {s.specs.map((spec) => (
                <li class="rounded-full border border-white/18 bg-white/8 px-3 py-1 font-display text-[0.72rem] font-medium tracking-wide text-navy-100">
                  {spec}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <!-- RCS tiers -->
    <div class="mt-16 lg:mt-20" data-reveal>
      <div class="ds-eyebrow">
        <span class="ds-eyebrow-dash"></span>
        <span class="ds-eyebrow-label">Piattaforma RCS — tre versioni</span>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {
          tiers.map((t) => (
            <div class="ds-panel flex flex-col p-6">
              <span
                class="ds-pill self-start"
                style={`color:${t.accent}; border-color: color-mix(in srgb, ${t.accent} 50%, transparent); background: color-mix(in srgb, ${t.accent} 16%, transparent);`}
              >
                {t.nome}
              </span>
              <p class="mt-4 text-sm leading-relaxed text-navy-100/95">{t.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Pattern di sfondo (turbine/skyline wireframe) — texture atmosferica, non
     un'illustrazione da mettere in mostra: opacità bassa + gradiente navy
     sopra tengono il contrasto del testo e dei pannelli in primo piano. La
     `.control-glow` (sotto) resta sopra il pattern e sotto il contenuto,
     così i suoi bagliori signal/verde restano leggibili invariati. Il layer
     è più alto del contenitore (`height: 130%`) per lasciare spazio al
     traslare verticale della parallasse senza scoprire un bordo vuoto. */
  .control-pattern {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .control-pattern-img {
    position: absolute;
    left: 50%;
    top: -25%;
    width: 100%;
    height: 150%;
    max-width: none;
    object-fit: cover;
    opacity: 0.52;
    transform: translate3d(-50%, 0, 0) scale(1);
    will-change: transform;
  }
  .control-pattern::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--color-navy-950) 0%, transparent 18%, transparent 78%, var(--color-navy-950) 100%),
      linear-gradient(
        100deg,
        color-mix(in srgb, var(--color-navy-950) 95%, transparent) 0%,
        color-mix(in srgb, var(--color-navy-950) 92%, transparent) 22%,
        color-mix(in srgb, var(--color-navy-950) 45%, transparent) 38%,
        transparent 52%
      );
  }
  .control-glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(60% 55% at 78% 8%, color-mix(in srgb, var(--color-navy-700) 55%, transparent), transparent 70%),
      radial-gradient(50% 60% at 0% 100%, color-mix(in srgb, var(--color-navy-800) 60%, transparent), transparent 70%);
  }
  .monitor {
    box-shadow: 0 40px 80px -40px color-mix(in srgb, var(--color-signal-400) 30%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .control-pattern-img {
      transform: translate3d(-50%, 0, 0) scale(1) !important;
    }
  }
</style>

<script>
  // Parallasse reale via transform (mai `background-attachment: fixed`: su
  // iOS Safari ridipinge a ogni frame ed è pessimo per battery/scroll fluido).
  // rAF-throttled, attivo solo mentre la sezione è in viewport
  // (IntersectionObserver), spento del tutto se l'utente preferisce meno
  // movimento — a quel punto il layer resta fermo alla sua posizione base.
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.querySelector<HTMLElement>('.control');
  const layers = document.querySelectorAll<HTMLElement>('.control-pattern-img');

  if (section && layers.length && !prefersReduced) {
    let inView = false;
    let ticking = false;
    const depth = 0.32; // frazione della sezione percorsa che il layer trasla
    // Il layer è alto 150% con -25% di top: 25% di margine per lato, la
    // depth qui sopra resta abbondantemente dentro quel margine (vedi commento
    // su .control-pattern-img più sotto per i numeri).

    const apply = () => {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      const progress = (vh - rect.top) / (vh + rect.height); // 0 all'ingresso, 1 all'uscita
      const offset = (progress - 0.5) * rect.height * depth;
      const scale = 1 + Math.abs(progress - 0.5) * 0.08; // leggero respiro 3D ai bordi
      layers.forEach((layer) => {
        layer.style.transform = `translate3d(-50%, ${offset.toFixed(1)}px, 0) scale(${scale.toFixed(3)})`;
      });
    };

    const onScroll = () => {
      if (!inView || ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    };

    const io = new IntersectionObserver(
      (entries) => {
        inView = entries[0]?.isIntersecting ?? false;
        if (inView) onScroll();
      },
      { rootMargin: '20% 0px' },
    );
    io.observe(section);
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
