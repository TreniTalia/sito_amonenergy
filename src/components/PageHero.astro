---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  h1: string;
  sub?: string;
  /**
   * Surface is always the navy of the brand; `control` only swaps the eyebrow
   * for the live 24/7 dot, the one place the signal green still shows.
   */
  tone?: 'navy' | 'control';
  /** Optional full-bleed background photo. */
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, h1, sub, tone = 'navy', image, imageAlt = '' } = Astro.props;

const isControl = tone === 'control';
const labelClass = isControl ? 'ds-eyebrow-label--signal' : '';
---

<section class="relative isolate overflow-hidden bg-navy-950 text-paper">
  {
    image && (
      <>
        <Image
          src={image}
          alt={imageAlt}
          class="pagehero-photo absolute inset-0 h-full w-full object-cover"
          widths={[768, 1280, 1600]}
          sizes="100vw"
          loading="eager"
        />
        <div class="pagehero-scrim absolute inset-0" />
      </>
    )
  }

  <div class="wrap-wide relative z-10 pb-16 pt-32 lg:pb-24 lg:pt-40">
    <div class="ds-eyebrow" data-reveal>
      {isControl && <span class="ds-live-dot" aria-hidden="true" />}
      {!isControl && <span class="ds-eyebrow-dash"></span>}
      <span class:list={['ds-eyebrow-label', labelClass]}>{eyebrow}</span>
    </div>
    <h1 class="text-display max-w-[20ch]" data-reveal style="--reveal-delay:80ms">{h1}</h1>
    {sub && <p class="measure mt-5 text-lg text-paper/80 whitespace-pre-line" data-reveal style="--reveal-delay:160ms">{sub}</p>}
  </div>
</section>

<style>
  /* The photo itself is darkened and taken down a register — a real filter,
     not just a translucent layer on top — so it reads as moody brochure
     photography graded onto the navy system rather than a raw stock shot.
     No video layers over this element (unlike the home hero), so promoting
     it to its own compositing layer here is not the risk it is there. */
  .pagehero-photo {
    filter: brightness(0.55) saturate(0.85);
  }

  /* Heavier, directional legibility scrim: darkest at the foot, where the
     text cluster actually sits (PageHero's large top padding pushes the
     eyebrow/h1/sub block toward the bottom of the section), fading out
     toward the top where it's photo-only. */
  .pagehero-scrim {
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-navy-950) 88%, transparent) 0%,
      color-mix(in srgb, var(--color-navy-950) 68%, transparent) 30%,
      color-mix(in srgb, var(--color-navy-950) 38%, transparent) 60%,
      color-mix(in srgb, var(--color-navy-950) 18%, transparent) 100%
    );
  }
</style>
