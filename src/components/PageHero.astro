---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import WaveDivider from './WaveDivider.astro';

interface Props {
  eyebrow: string;
  h1: string;
  sub?: string;
  /**
   * Surface is always the navy of the brand; `control` only swaps the eyebrow
   * for the live 24/7 dot, the one place the signal green still shows.
   */
  tone?: 'navy' | 'control';
  /** Optional full-bleed background photo. */
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, h1, sub, tone = 'navy', image, imageAlt = '' } = Astro.props;

const isControl = tone === 'control';
const labelClass = isControl ? 'ds-eyebrow-label--signal' : '';
---

<section class="relative isolate overflow-hidden bg-navy-950 text-paper">
  {
    image && (
      <>
        <Image
          src={image}
          alt={imageAlt}
          class="absolute inset-0 h-full w-full object-cover"
          widths={[768, 1280, 1600]}
          sizes="100vw"
          loading="eager"
        />
        <div class="absolute inset-0 bg-navy-950/82" />
      </>
    )
  }

  <div class="wrap-wide relative z-10 pb-16 pt-32 lg:pb-24 lg:pt-40">
    <div class="ds-eyebrow" data-reveal>
      {isControl && <span class="ds-live-dot" aria-hidden="true" />}
      {!isControl && <span class="ds-eyebrow-dash"></span>}
      <span class:list={['ds-eyebrow-label', labelClass]}>{eyebrow}</span>
    </div>
    <h1 class="text-display max-w-[20ch]" data-reveal style="--reveal-delay:80ms">{h1}</h1>
    {sub && <p class="measure mt-5 text-lg text-paper/80" data-reveal style="--reveal-delay:160ms">{sub}</p>}
  </div>

  <div class="relative z-10">
    <WaveDivider tone="signal" />
  </div>
</section>
