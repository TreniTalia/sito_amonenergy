---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CoverageMap from '../components/CoverageMap.astro';
import StatBar from '../components/StatBar.astro';
import ClientMarquee from '../components/ClientMarquee.astro';
import CtaBand from '../components/CtaBand.astro';
import storiaImg from '../assets/img/photos/tecnico-fotovoltaico.jpg';
import vanImg from '../assets/img/photos/van-laboratorio-aperto.jpg';
// Foto Pexels, Mr Dr3igeteilt (https://www.pexels.com/photo/36137497/) — apparecchiature
// di una sottostazione AT/MT in controluce, luce dorata: stesso trattamento navy via
// duotone/scrim di PageHero delle altre pagine (servizi, lavori, contatti). Nessuna
// persona, nessun marchio di terzi leggibile.
import heroAzienda from '../assets/img/photos/azienda-hero-substation.jpg';

const azienda = await getEntry('pagine', 'azienda');
if (!azienda || azienda.data.pagina !== 'azienda') throw new Error('pagine/azienda.yaml missing or malformed');
const { eyebrow, h1, storia, missione, raggioAzione, strumentazione, marqueeTitolo } = azienda.data;

// Stessi numeri operativi della home (home.yaml → statbar): unica fonte, per
// non tenere due copie dello stesso dato che potrebbero disallinearsi.
const home = await getEntry('pagine', 'home');
if (!home || home.data.pagina !== 'home') throw new Error('pagine/home.yaml missing or malformed');
const { statbar } = home.data;
---

<Base
  title="Azienda"
  description="Amon Energy: oltre vent'anni di esperienza su impianti elettrici AT/MT e rinnovabili nel Centro-Sud Italia, da un'unica sede in Puglia."
>
  <PageHero
    eyebrow={eyebrow}
    h1={h1}
    image={heroAzienda}
    imageAlt="Apparecchiature di una sottostazione elettrica AT/MT in controluce, al tramonto"
  />

  <section class="wrap-wide grid items-center gap-12 py-20 lg:grid-cols-2 lg:gap-16 lg:py-28">
    <div data-reveal>
      <div class="ds-eyebrow">
        <span class="ds-eyebrow-dash"></span>
        <span class="ds-eyebrow-label">La nostra storia</span>
      </div>
      <p class="measure text-lg leading-relaxed text-ink/90">{storia}</p>
      <!-- NOTA: testo redatto a partire dai soli fatti presenti nello spec (fondazione 2020,
           soci, Energy System Services, 20+ anni di esperienza, focus rinnovabile Centro-Sud).
           Da far rivedere/validare dal cliente prima del go-live — non è testo brochure verbatim. -->
    </div>
    <figure class="overflow-hidden rounded-[var(--radius-card)] border border-navy-100 shadow-[var(--shadow-md)]" data-reveal style="--reveal-delay:120ms">
      <Image
        src={storiaImg}
        alt="Tecnico Amon Energy durante una misura strumentale in un impianto fotovoltaico"
        class="aspect-[4/5] w-full object-cover"
        widths={[500, 800, 1100]}
        sizes="(min-width: 1024px) 46vw, 100vw"
      />
    </figure>
  </section>

  <section class="bg-navy-950 text-paper">
    <div class="wrap-wide py-20 lg:py-28">
      <div class="ds-eyebrow" data-reveal>
        <span class="ds-eyebrow-dash"></span>
        <span class="ds-eyebrow-label">La nostra missione</span>
      </div>
      <p class="max-w-[24ch] text-control text-paper" data-reveal style="--reveal-delay:80ms">
        Al fianco di chi produce energia, in ogni fase della vita di un impianto.
      </p>
      <p class="measure mt-6 text-lg leading-relaxed text-paper/80" data-reveal style="--reveal-delay:160ms">
        {missione}
      </p>
    </div>
  </section>

  <StatBar items={statbar} nota="Numeri dell'operatività Amon Energy" />

  <section class="wrap-wide grid items-center gap-12 py-20 lg:grid-cols-2 lg:gap-16 lg:py-28">
    <div data-reveal>
      <div class="ds-eyebrow">
        <span class="ds-eyebrow-dash"></span>
        <span class="ds-eyebrow-label">Tempestività d'intervento</span>
      </div>
      <p class="measure text-lg leading-relaxed text-ink/90">{raggioAzione}</p>
    </div>
    <div class="relative" data-reveal style="--reveal-delay:120ms">
      <CoverageMap />
    </div>
  </section>

  <section class="bg-navy-100">
    <div class="wrap-wide py-20 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
        <div data-reveal>
          <div class="ds-eyebrow">
            <span class="ds-eyebrow-dash ds-eyebrow-dash--leaf"></span>
            <span class="ds-eyebrow-label ds-eyebrow-label--leaf">Strumentazione</span>
          </div>
          <h2 class="text-headline">La nostra dotazione tecnica.</h2>
          <p class="measure mt-4 text-ink/70">
            Tutti i dispositivi sono certificati e calibrati: la specificità tecnica è il nostro
            badge di fiducia.
          </p>
          <div class="mt-8 flex flex-wrap gap-2.5">
            {
              strumentazione.map((s) => (
                <span class="rounded-full border border-navy-900/12 bg-paper/80 px-4 py-2 font-display text-sm font-medium text-navy-900 shadow-[var(--shadow-sm)] backdrop-blur">
                  {s}
                </span>
              ))
            }
          </div>
        </div>
        <figure class="overflow-hidden rounded-[var(--radius-card)] border border-navy-900/10 shadow-[var(--shadow-md)]" data-reveal style="--reveal-delay:120ms">
          <Image
            src={vanImg}
            alt="Il laboratorio mobile di Amon Energy con la strumentazione di prova a bordo, in campo durante un intervento"
            class="w-full object-cover"
            widths={[400, 800]}
            sizes="(min-width: 1024px) 46vw, 100vw"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- Roster clienti: destinazione dell'ancora #clienti, il redirect 301 da
       /i-nostri-clienti/, un URL del vecchio sito con autorità propria. -->
  <div id="clienti">
    <ClientMarquee titolo={marqueeTitolo} />
  </div>

  <CtaBand headline="Vuoi sapere se possiamo intervenire sul tuo impianto?" />
</Base>
