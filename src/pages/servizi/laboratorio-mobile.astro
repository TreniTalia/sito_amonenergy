---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ServizioBody from '../../components/ServizioBody.astro';
import heroImage from '../../assets/img/photos/laboratorio-van-cabina.jpg';
import vanImage from '../../assets/img/photos/laboratorio-operatore.jpg';

const entry = await getEntry('servizi', 'laboratorio-mobile');
if (!entry) throw new Error('servizi/laboratorio-mobile.md missing');

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: entry.data.titolo,
    description: entry.data.excerpt,
    provider: { '@type': 'Organization', name: 'Amon Energy S.r.l.' },
    areaServed: 'Centro-Sud Italia',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://amonenergy.it/' },
      { '@type': 'ListItem', position: 2, name: 'Servizi', item: 'https://amonenergy.it/servizi/' },
      { '@type': 'ListItem', position: 3, name: entry.data.titolo, item: 'https://amonenergy.it/servizi/laboratorio-mobile/' },
    ],
  },
];
---

<Base title={entry.data.titolo} description={entry.data.excerpt} structuredData={structuredData}>
  <ServizioBody
    entry={entry}
    heroImage={heroImage}
    heroImageAlt="Il laboratorio mobile di Amon Energy in campo durante un intervento di ricerca guasti su una cabina MT"
    bodyImage={vanImage}
    bodyImageAlt="Tecnico Amon Energy al lavoro sulla consolle Megger Centrix 2.0 all'interno del laboratorio mobile"
  />
</Base>
