---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ServizioBody from '../../components/ServizioBody.astro';
import instrImage from '../../assets/img/photos/instr-drts.png';

const entry = await getEntry('servizi', 'verifiche-strumentali');
if (!entry) throw new Error('servizi/verifiche-strumentali.md missing');

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: entry.data.titolo,
    description: entry.data.excerpt,
    provider: { '@type': 'Organization', name: 'Amon Energy S.r.l.' },
    areaServed: 'Centro-Sud Italia',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://amonenergy.it/' },
      { '@type': 'ListItem', position: 2, name: 'Servizi', item: 'https://amonenergy.it/servizi/' },
      { '@type': 'ListItem', position: 3, name: entry.data.titolo, item: 'https://amonenergy.it/servizi/verifiche-strumentali/' },
    ],
  },
];
---

<Base title={entry.data.titolo} description={entry.data.excerpt} structuredData={structuredData}>
  <ServizioBody
    entry={entry}
    bodyImage={instrImage}
    bodyImageAlt="Sistema di prova relè DRTS/64 usato da Amon Energy per le verifiche sulle protezioni AT/MT"
    bodyImageContain
  />
</Base>
