---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';

const hub = await getEntry('pagine', 'servizi');
if (!hub || hub.data.pagina !== 'servizi') throw new Error('pagine/servizi.yaml missing or malformed');
const { eyebrow, h1, sub } = hub.data;

const servizi = (await getCollection('servizi')).sort((a, b) => a.data.ordine - b.data.ordine);

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://amonenergy.it/' },
    { '@type': 'ListItem', position: 2, name: 'Servizi', item: 'https://amonenergy.it/servizi/' },
  ],
};
---

<Base
  title="Servizi"
  description="Laboratorio mobile ricerca guasti, verifiche strumentali, monitoraggio e controllo, costruzioni, gestione e manutenzione per impianti AT/MT e rinnovabili."
  structuredData={[breadcrumb]}
>
  <PageHero eyebrow={eyebrow} h1={h1} sub={sub} />

  <section class="wrap-wide py-20 lg:py-28">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {
        servizi.map((s, i) => (
          <div data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <ServiceCard
              titolo={s.data.titolo}
              excerpt={s.data.excerpt}
              icona={s.data.icona}
              href={`/servizi/${s.id}/`}
              index={i + 1}
              accent={s.id === 'monitoraggio-e-controllo' ? 'signal' : 'leaf'}
            />
          </div>
        ))
      }
    </div>
  </section>

  <CtaBand />
</Base>
