---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import IconCloud from '../../components/IconCloud.astro';
import teamwareLogo from '../../assets/img/brand/partners/teamware-logo.png';
import heroServizi from '../../assets/img/photos/servizi-hero-substation.jpg';
// Stanza buia, monitor accesi con grafici in serie: la sezione parla di
// supervisione continua e analisi dati, e questo è quel mestiere visto da
// dietro le spalle di nessuno. Niente persone al computer — il soggetto è il
// dato, non chi lo guarda. Sotto il duotone navy le candele del grafico
// leggono come tracciati di telemetria. Foto Pexels, Rafael Minguet Delgado.
import controlloPattern from '../../assets/img/photos/servizi-controllo-telemetria.jpg';
import modbusSvg from '../../assets/img/tech/modbus.svg?raw';
import opcuaSvg from '../../assets/img/tech/opcua.svg?raw';
import mqttSvg from '../../assets/img/tech/mqtt.svg?raw';
import sparkplugbSvg from '../../assets/img/tech/sparkplugb.svg?raw';
import iecSvg from '../../assets/img/tech/iec.svg?raw';
import zigbeeSvg from '../../assets/img/tech/zigbee.svg?raw';
import phoenixcontactSvg from '../../assets/img/tech/phoenixcontact.svg?raw';
import inductiveautomationSvg from '../../assets/img/tech/inductiveautomation.svg?raw';
import teltonikaSvg from '../../assets/img/tech/teltonika.svg?raw';
import pythonSvg from '../../assets/img/tech/python.svg?raw';
import cplusplusSvg from '../../assets/img/tech/cplusplus.svg?raw';
import gitSvg from '../../assets/img/tech/git.svg?raw';
import githubSvg from '../../assets/img/tech/github.svg?raw';
import javascriptSvg from '../../assets/img/tech/javascript.svg?raw';
import html5Svg from '../../assets/img/tech/html5.svg?raw';
import mysqlSvg from '../../assets/img/tech/mysql.svg?raw';
import dockerSvg from '../../assets/img/tech/docker.svg?raw';
import googlecloudSvg from '../../assets/img/tech/googlecloud.svg?raw';
import awsservicesSvg from '../../assets/img/tech/awsservices.svg?raw';

const hub = await getEntry('pagine', 'servizi');
if (!hub || hub.data.pagina !== 'servizi') throw new Error('pagine/servizi.yaml missing or malformed');
const { eyebrow, h1, sub, controllo, ingegneriaElettrica, costruzioneGestione, tecnologie } = hub.data;

const costruzioni = await getEntry('servizi', 'costruzioni');
const gestione = await getEntry('servizi', 'gestione-e-manutenzione');
if (!costruzioni || !gestione) throw new Error('content/servizi: costruzioni o gestione-e-manutenzione mancante');

// Sorgente unica per la icon cloud: ogni voce di `tecnologie.voci` in
// servizi.yaml ha un `logo` che punta a uno di questi slug.
const techLogos: Record<string, string> = {
  modbus: modbusSvg,
  opcua: opcuaSvg,
  mqtt: mqttSvg,
  sparkplugb: sparkplugbSvg,
  iec: iecSvg,
  zigbee: zigbeeSvg,
  phoenixcontact: phoenixcontactSvg,
  inductiveautomation: inductiveautomationSvg,
  teltonika: teltonikaSvg,
  python: pythonSvg,
  cplusplus: cplusplusSvg,
  git: gitSvg,
  github: githubSvg,
  javascript: javascriptSvg,
  html5: html5Svg,
  mysql: mysqlSvg,
  docker: dockerSvg,
  googlecloud: googlecloudSvg,
  awsservices: awsservicesSvg,
};

// Marchi troppo fini per leggersi alla dimensione base della cloud (dettagli
// sottili che si perdono sotto una certa scala) — un moltiplicatore in più
// oltre alla profondità 3D, non al posto di essa.
const techSizeBoost: Record<string, number> = {
  mysql: 1.35,
  teltonika: 1.3,
};

const tecnologieIcons = tecnologie.voci
  .filter((v) => v.logo && techLogos[v.logo])
  .map((v) => ({
    name: v.nome,
    svg: techLogos[v.logo as string],
    sizeBoost: techSizeBoost[v.logo as string],
  }));

---

<Base
  title="Servizi"
  description="RCS, CCI, ricerca guasti AT/MT, diagnostica su cavi e trasformatori, costruzione e gestione di impianti elettrici AT/MT."
>
  <PageHero
    eyebrow={eyebrow}
    h1={h1}
    sub={sub}
    image={heroServizi}
    imageAlt="Due tecnici in dispositivi di protezione individuale ispezionano una cabina di trasformazione AT/MT all'alba"
  />

  <!-- Ingegneria elettrica -->
  <section id="ingegneria-elettrica" class="wrap-wide py-20 lg:py-28">
    <div class="ds-eyebrow" data-reveal>
      <span class="ds-eyebrow-dash"></span>
      <span class="ds-eyebrow-label">{ingegneriaElettrica.eyebrow}</span>
    </div>
    <h2 class="text-headline max-w-[22ch]" data-reveal style="--reveal-delay:80ms">{ingegneriaElettrica.titolo}</h2>
    <p class="measure text-body mt-3 text-ink/70" data-reveal style="--reveal-delay:120ms">{ingegneriaElettrica.sub}</p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {
        ingegneriaElettrica.voci.map((v, i) => (
          <div data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <ServiceCard
              titolo={v.titolo}
              excerpt={v.testo}
              icona={v.icona}
              href="/contatti/"
              index={i + 1}
              accent="signal"
              elevated
              ctaLabel="Richiedi informazioni"
            />
          </div>
        ))
      }
    </div>
  </section>

  <!-- Controllo e monitoraggio: RCS + CCI -->
  <section id="controllo-e-monitoraggio" class="control relative isolate overflow-hidden bg-navy-950 text-paper">
    <div class="control-pattern" aria-hidden="true">
      <Image
        src={controlloPattern}
        alt=""
        class="control-pattern-img"
        data-parallax
        widths={[900, 1325, 1800, 2400]}
        sizes="100vw"
        quality={92}
      />
      <div class="control-pattern-tint" aria-hidden="true"></div>
    </div>
    <div class="control-weave" aria-hidden="true"></div>
    <div class="control-glow" aria-hidden="true"></div>
    <div class="wrap-wide relative z-10 py-20 lg:py-28">
      <div class="ds-eyebrow" data-reveal>
        <span class="ds-live-dot" aria-hidden="true"></span>
        <span class="ds-eyebrow-label ds-eyebrow-label--signal">{controllo.eyebrow}</span>
      </div>
      <h2 class="text-control max-w-[22ch]" data-reveal style="--reveal-delay:80ms">{controllo.titolo}</h2>
      <p class="measure text-lead mt-6 text-navy-100" data-reveal style="--reveal-delay:160ms">{controllo.testo}</p>

      <div class="control-cards mt-14 grid gap-5 md:grid-cols-2 lg:gap-6">
        <article class="ds-panel flex flex-col p-7 lg:p-8" data-reveal>
          <span class="ds-pill self-start">RCS</span>
          <h3 class="text-title mt-5">{controllo.rcs.titolo}</h3>
          <p class="text-small measure mt-3 text-navy-100/85">{controllo.rcs.testo}</p>
          <ul class="mt-6 flex flex-wrap gap-2 border-t border-white/12 pt-5">
            {controllo.rcs.specs.map((spec) => (
              <li class="text-micro rounded-full border border-white/18 bg-white/8 px-3 py-1 font-display font-medium tracking-wide text-navy-100">
                {spec}
              </li>
            ))}
          </ul>
        </article>

        <article class="ds-panel flex flex-col p-7 lg:p-8" data-reveal style="--reveal-delay:100ms">
          <span class="ds-pill self-start">CCI</span>
          <h3 class="text-title mt-5">{controllo.cci.titolo}</h3>
          <p class="text-small measure mt-3 text-navy-100/85">{controllo.cci.testo}</p>
          <ul class="mt-6 flex flex-wrap gap-2 border-t border-white/12 pt-5">
            {controllo.cci.specs.map((spec) => (
              <li class="text-micro rounded-full border border-white/18 bg-white/8 px-3 py-1 font-display font-medium tracking-wide text-navy-100">
                {spec}
              </li>
            ))}
          </ul>
          <div class="mt-6 flex items-center gap-3 border-t border-white/12 pt-5">
            <span class="text-micro font-medium uppercase tracking-wide text-navy-100/60">In partnership con</span>
            <!-- Il logo Teamware è blu istituzionale su trasparente: sul navy
                 del pannello non si vedeva affatto. Invece di schiarirlo e
                 perderne il colore, sta su una piastrina chiara — è così che un
                 marchio di terzi va ospitato su fondo scuro. -->
            <a
              href={controllo.cci.partnerUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={controllo.cci.partnerNome}
              class="partner-chip"
            >
              <Image src={teamwareLogo} alt={controllo.cci.partnerNome} width={90} style="height: auto; width: 90px;" />
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Costruzione e gestione impianti -->
  <section id="costruzione-e-gestione" class="bg-navy-100">
    <div class="wrap-wide py-20 lg:py-28">
      <div class="ds-eyebrow" data-reveal>
        <span class="ds-eyebrow-dash"></span>
        <span class="ds-eyebrow-label">{costruzioneGestione.eyebrow}</span>
      </div>
      <h2 class="text-headline max-w-[22ch]" data-reveal style="--reveal-delay:80ms">{costruzioneGestione.titolo}</h2>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:gap-6">
        <div data-reveal style="--reveal-delay:90ms">
          <ServiceCard
            titolo={costruzioni.data.titolo}
            excerpt={costruzioni.data.excerpt}
            icona={costruzioni.data.icona}
            href="/lavori/"
            index={1}
            accent="signal"
            elevated
            ctaLabel="Guarda le opere realizzate"
          />
        </div>
        <div data-reveal style="--reveal-delay:180ms">
          <ServiceCard
            titolo={gestione.data.titolo}
            excerpt={gestione.data.excerpt}
            icona={gestione.data.icona}
            href="/lavori/"
            index={2}
            accent="signal"
            elevated
            ctaLabel="Guarda le opere realizzate"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Tecnologie -->
  <section id="tecnologie" class="wrap-wide py-20 lg:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div>
        <div class="ds-eyebrow" data-reveal>
          <span class="ds-eyebrow-dash"></span>
          <span class="ds-eyebrow-label">{tecnologie.eyebrow}</span>
        </div>
        <h2 class="text-headline max-w-[22ch]" data-reveal style="--reveal-delay:80ms">{tecnologie.titolo}</h2>
        <p class="measure text-body mt-3 text-ink/70" data-reveal style="--reveal-delay:120ms">{tecnologie.sub}</p>

        <noscript>
          <ul class="mt-8 flex flex-wrap gap-3">
            {
              tecnologie.voci.map((v) => (
                <li class="text-small rounded-full border border-navy-100 bg-navy-100/40 px-4 py-2.5 font-display font-medium text-navy-900">
                  {v.nome}
                </li>
              ))
            }
          </ul>
        </noscript>
      </div>

      <IconCloud icons={tecnologieIcons} color="#1D5585" />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Quadro elettrico / switchgear reale (Pexels) come pattern astratto —
     stesso trattamento di `.control-pattern` in ControlPillar.astro
     (pattern-rcs): texture atmosferica, non un'illustrazione in mostra.
     Desaturata e scurita, poi un layer navy in `mix-blend-mode: color` le
     impone la tinta del sistema (tono/saturazione dal layer navy, luminosità
     dal quadro sottostante — il trucco duotone).

     Niente maschera pesante sopra il testo: due tentativi con un velo
     artificiale (radiale, poi lineare a percentuale/pixel) o rendevano il
     pattern invisibile o lo lasciavano trasparire dietro le lettere. La foto
     scelta è già scura sul lato sinistro per composizione naturale — verificato
     che lì il contrasto testo-su-pattern è forte quanto testo-su-navy-piatto,
     senza alcun velo. Resta solo una sfumatura leggerissima ai due bordi, per
     il raccordo con l'header sopra e la sezione chiara sotto. */
  .control-pattern {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .control-pattern-img {
    /* Extra height + negative top, same margin CtaBand's `.cta-bg-img` gives
       itself: room for the parallax translate to travel through scroll
       without ever uncovering an empty edge top or bottom. */
    position: absolute;
    left: 0;
    top: -18%;
    width: 100%;
    height: 136%;
    max-width: none;
    object-fit: cover;
    object-position: center 30%;
    /* La control room è già scura, ma i monitor accesi sono le uniche zone
       chiare della foto e finivano proprio dietro ai pannelli: 0,78 di
       luminosità li riporta al rango di fondale. */
    filter: grayscale(1) brightness(0.78) contrast(1.12);
    opacity: 0.88;
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }
  /* Su telefono la fascia è alta quanto tre schermi e larga 390px: con `cover`
     la foto viene ingrandita quasi cinque volte e di tutto il monitor resta una
     fetta sfocata. Qui smette di fare da fondale a tutta la sezione e diventa
     una banda in cima, alta quanto basta perché il grafico si legga per intero
     (540px su 390 di larghezza: la finestra prende metà della foto, il monitor
     grande per intero), che sfuma nel navy prima dei pannelli. I pannelli
     guadagnano il fondo pieno, e con esso il contrasto che su una foto sgranata
     non avevano.

     Il parallasse qui va spento: trasla di ±15% dell'altezza della sezione, che
     su mobile vale più della banda intera e la porterebbe fuori posto. */
  @media (max-width: 767px) {
    .control-pattern-img {
      /* Scesa di 124px: l'occhiello e il titolo tornano su navy pieno, dove si
         leggono senza dover combattere con il reticolo del grafico. */
      top: 124px;
      height: 520px;
      object-position: 60% 46%;
      filter: grayscale(1) brightness(0.9) contrast(1.12);
      opacity: 0.95;
      transform: translate3d(0, 0, 0) !important;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 60%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 60%, transparent 100%);
    }
    /* La sfumatura in basso la fa già la maschera: il velo pieno qui sotto
       raddoppierebbe lo scuro proprio dove la foto sta finendo. */
    .control-pattern::after {
      background: linear-gradient(180deg, var(--color-navy-950) 0%, transparent 14%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .control-pattern-img {
      transform: translate3d(0, 0, 0) !important;
    }
  }
  .control-pattern-tint {
    position: absolute;
    inset: 0;
    background: var(--color-navy-700);
    mix-blend-mode: color;
  }
  .control-pattern::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--color-navy-950) 0%,
      transparent 10%,
      transparent 92%,
      var(--color-navy-950) 100%
    );
  }

  /* Le due card hanno testi di lunghezza diversa, quindi le righe di tag
     partivano ad altezze diverse e la fascia leggeva storta. Con `subgrid` le
     righe sono le stesse per tutte e due — pill, titolo, testo elastico, tag,
     partner — e i tag si allineano da soli qualunque cosa ci sia scritta sopra.
     La quinta riga in RCS resta vuota: è il posto della riga partner della CCI.
     Dove `subgrid` non c'è, restano le card a flex di prima: disallineate, ma
     integre. */
  @supports (grid-template-rows: subgrid) {
    @media (min-width: 768px) {
      .control-cards {
        grid-template-rows: auto auto 1fr auto auto;
      }
      .control-cards > article {
        display: grid;
        grid-row: span 5;
        grid-template-rows: subgrid;
        /* Una subgrid eredita gli spazi del genitore: senza questo, il `gap-5`
           fra le due card si infilava anche fra le righe dentro ciascuna. Le
           distanze le fanno i margini di riga, come prima. */
        row-gap: 0;
      }
      /* In flex la pill stava a `self-start`; in griglia ogni cella si allarga
         per default e la pill diventava una barra da un bordo all'altro. */
      .control-cards > article > .ds-pill {
        justify-self: start;
      }
    }
  }

  .partner-chip {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
    padding: 0.4rem 0.7rem;
    transition: background-color 0.25s var(--ease-signature, ease);
  }
  .partner-chip:hover {
    background: var(--color-paper);
  }

  .control-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 55% at 78% 8%, color-mix(in srgb, var(--color-navy-700) 55%, transparent), transparent 70%),
      radial-gradient(50% 60% at 0% 100%, color-mix(in srgb, var(--color-navy-800) 60%, transparent), transparent 70%);
    z-index: 1;
  }

  /* Sotto la banda fotografica, su mobile, restavano due terzi di navy piatto.
     Qui ci va la stessa lingua grafica della mappa di copertura: un reticolo
     fine a passo fisso e due aloni navy che lo attraversano — la carta tecnica
     su cui i pannelli si appoggiano, non un colore di riempimento. Il reticolo
     entra solo dove la foto è finita (maschera sfumata) e sta sotto i pannelli,
     che sono in vetro e lo lasciano intravedere. */
  .control-weave {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: none;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .control-weave {
      display: block;
      background-image:
        radial-gradient(70% 38% at 82% 34%, color-mix(in srgb, var(--color-navy-700) 62%, transparent), transparent 72%),
        radial-gradient(60% 34% at 6% 74%, color-mix(in srgb, var(--color-navy-800) 58%, transparent), transparent 70%),
        linear-gradient(to right, color-mix(in srgb, #5aa3d4 10%, transparent) 1px, transparent 1px),
        linear-gradient(to bottom, color-mix(in srgb, #5aa3d4 10%, transparent) 1px, transparent 1px);
      background-size:
        100% 100%,
        100% 100%,
        48px 48px,
        48px 48px;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, transparent 18%, #000 34%, #000 100%);
      mask-image: linear-gradient(180deg, transparent 0%, transparent 18%, #000 34%, #000 100%);
    }
  }

  #controllo-e-monitoraggio,
  #ingegneria-elettrica,
  #costruzione-e-gestione,
  #tecnologie {
    scroll-margin-top: var(--header-h, 4.875rem);
  }
</style>

<script>
  // Stesso parallasse (via transform, mai `background-attachment: fixed`)
  // e stessa struttura di CtaBand.astro, sulla fascia Controllo e monitoraggio.
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.querySelector<HTMLElement>('.control');
  const layer = section?.querySelector<HTMLElement>('[data-parallax]');

  if (section && layer && !prefersReduced) {
    let inView = false;
    let ticking = false;
    const depth = 0.3;

    const apply = () => {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      const progress = (vh - rect.top) / (vh + rect.height);
      const offset = (progress - 0.5) * rect.height * depth;
      layer.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
    };

    const onScroll = () => {
      if (!inView || ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    };

    const io = new IntersectionObserver(
      (entries) => {
        inView = entries[0]?.isIntersecting ?? false;
        if (inView) onScroll();
      },
      { rootMargin: '20% 0px' },
    );
    io.observe(section);
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
