---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import turbines from '../../assets/img/photos/traliccio-tramonto.webp';
import campoImg from '../../assets/img/photos/van-parco-eolico.jpg';

const entry = await getEntry('servizi', 'monitoraggio-e-controllo');
if (!entry) throw new Error('servizi/monitoraggio-e-controllo.md missing');
const { Content } = await render(entry);

const infra = [
  {
    titolo: 'Sede fisica',
    testo:
      'Control Room a Castelluccio dei Sauri (FG), baricentrica sul Centro-Sud Italia per garantire tempi di reazione minimi.',
  },
  {
    titolo: 'Tripla ridondanza internet',
    testo:
      '3 linee indipendenti con operatori e tecnologie diverse: continuità di servizio anche in caso di doppio guasto.',
  },
  {
    titolo: 'Infrastruttura cloud AWS',
    testo:
      "Postazioni e sistemi di monitoraggio su server AWS: l'infrastruttura resta raggiungibile da qualsiasi PC, ovunque.",
  },
];

const rcsFeatures = [
  'Analisi guasti in tempo reale e algoritmo di richiusura automatica',
  'Monitoraggio completo: tensioni, correnti, UPS, protezioni in campo',
  'Gestione allarmi e notifiche email automatiche',
  'Reset protezioni da remoto (versioni Advance e Pro)',
  'Storicizzazione dati e report di analisi delle performance',
  'Sistema ticket integrato per l’assistenza tecnica',
  'Web App accessibile da qualsiasi dispositivo, desktop e mobile',
  'Integrazione SCADA e personalizzazione grafica dell’interfaccia',
];

const tiers = [
  {
    nome: 'Basic',
    desc: 'Monitoraggio di base e richiusura automatica.',
    voci: ['Monitoraggio in campo', 'Richiusura automatica', 'Allarmi e notifiche'],
    color: 'var(--color-tier-basic)',
  },
  {
    nome: 'Advance',
    desc: 'Tutto il Basic, più acquisizione dati da campo e reset da remoto.',
    voci: ['Acquisizione da campo', 'Reset protezioni da remoto', 'Storicizzazione dati'],
    color: 'var(--color-tier-advance)',
  },
  {
    nome: 'Pro',
    desc: 'Tutto l’Advance, più analisi avanzate e SCADA.',
    voci: ['Analisi avanzate', 'Integrazione SCADA', 'Interfaccia grafica custom'],
    color: 'var(--color-tier-pro)',
  },
];

const flusso = [
  { n: '01', t: 'Evento / Allarme', d: 'La Control Room rileva l’evento in tempo reale via monitoraggio SCADA + RCS, 24 ore su 24.' },
  { n: '02', t: 'Risoluzione remota', d: 'Tentativo immediato di risoluzione da remoto e notifica al proprietario dell’impianto.' },
  { n: '03', t: 'Tecnico in sito', d: 'Se serve, parte il team con il laboratorio mobile da Castelluccio dei Sauri per l’intervento in stazione.' },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: entry.data.titolo,
    description: entry.data.excerpt,
    provider: { '@type': 'Organization', name: 'Amon Energy S.r.l.' },
    areaServed: 'Centro-Sud Italia',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://amonenergy.it/' },
      { '@type': 'ListItem', position: 2, name: 'Servizi', item: 'https://amonenergy.it/servizi/' },
      { '@type': 'ListItem', position: 3, name: entry.data.titolo, item: 'https://amonenergy.it/servizi/monitoraggio-e-controllo/' },
    ],
  },
];
---

<Base title={entry.data.titolo} description={entry.data.excerpt} structuredData={structuredData}>
  <PageHero
    eyebrow="Control Room · RCS · CCI"
    h1={entry.data.titolo}
    sub={entry.data.frase}
    tone="green"
    image={turbines}
    imageAlt="Traliccio dell'alta tensione al tramonto: gli impianti sorvegliati 24/7 dalla Control Room di Amon Energy"
  />

  <!-- Intro -->
  <section class="bg-green-950 text-paper">
    <div class="wrap-wide grid items-center gap-12 py-20 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:py-28">
      <div class="measure text-lg leading-relaxed text-green-200 prose-green" data-reveal>
        <Content />
      </div>
      <div class="ds-panel overflow-hidden" data-reveal style="--reveal-delay:120ms">
        <Image
          src={campoImg}
          alt="Il laboratorio mobile di Amon Energy in un parco eolico durante un intervento su segnalazione della Control Room"
          class="aspect-[16/11] w-full object-cover"
          widths={[500, 800, 1100]}
          sizes="(min-width: 1024px) 44vw, 100vw"
        />
      </div>
    </div>
  </section>

  <!-- Control Room infrastructure -->
  <section class="bg-green-900 text-paper">
    <div class="wrap-wide py-20 lg:py-28">
      <div class="ds-eyebrow" data-reveal>
        <span class="ds-live-dot" aria-hidden="true"></span>
        <span class="ds-eyebrow-label ds-eyebrow-label--signal">La Control Room</span>
      </div>
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between" data-reveal>
        <h2 class="text-control max-w-[16ch]">5 tecnici, 1 supervisore, zero pause.</h2>
        <p class="ds-pill self-start md:self-end">24/7/365</p>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-3 lg:gap-6">
        {
          infra.map((c, i) => (
            <article class="ds-panel p-7 lg:p-8" data-reveal style={`--reveal-delay:${i * 100}ms`}>
              <h3 class="font-display text-lg font-bold tracking-tight">{c.titolo}</h3>
              <p class="mt-3 text-sm leading-relaxed text-green-200/90">{c.testo}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- RCS platform -->
  <section class="bg-green-950 text-paper">
    <div class="wrap-wide py-20 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div data-reveal>
          <div class="ds-eyebrow">
            <span class="ds-eyebrow-dash ds-eyebrow-dash--signal"></span>
            <span class="ds-eyebrow-label ds-eyebrow-label--signal">Piattaforma RCS</span>
          </div>
          <h2 class="text-control max-w-[14ch]">Remote Control System.</h2>
          <p class="measure mt-5 text-green-200">
            Il sistema proprietario di monitoraggio e controllo delle cabine MT, con comando
            interruttori incluso. Insieme al CCI — Controllore Centrale d'Impianto — mantiene tutto
            conforme a <strong class="text-paper">CEI 0-16 V5</strong> e alla
            <strong class="text-paper"> Delibera ARERA 564/2025/R/eel</strong>, con lettura contatori
            e teledistacco A72.
          </p>
        </div>
        <ul class="grid gap-x-8 gap-y-4 sm:grid-cols-2" data-reveal style="--reveal-delay:120ms">
          {
            rcsFeatures.map((f) => (
              <li class="flex gap-3 border-t border-green-400/15 pt-4">
                <svg class="mt-0.5 shrink-0 text-green-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                <span class="text-sm leading-relaxed text-green-200/90">{f}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Tiers -->
      <div class="mt-16 lg:mt-20">
        <p class="mb-6 flex items-center gap-3 font-display text-sm font-semibold uppercase tracking-[0.12em] text-green-200/70" data-reveal>
          <span class="h-[2px] w-8 bg-green-400"></span>
          Tre versioni, secondo le esigenze dell'impianto
        </p>
        <div class="grid gap-4 sm:grid-cols-3 lg:gap-6">
          {
            tiers.map((t, i) => (
              <div
                class="relative flex flex-col rounded-[4px] border border-green-400/18 bg-green-900/40 p-7"
                style={`--tier:${t.color}; --reveal-delay:${i * 90}ms`}
                data-reveal
              >
                <span class="absolute inset-x-0 top-0 h-[3px] rounded-t-[4px]" style="background: var(--tier)" aria-hidden="true" />
                <h3 class="font-display text-2xl font-bold" style="color: var(--tier)">{t.nome}</h3>
                <p class="mt-2 text-sm leading-relaxed text-green-200/85">{t.desc}</p>
                <ul class="mt-5 flex flex-col gap-2 border-t border-green-400/15 pt-5">
                  {t.voci.map((v) => (
                    <li class="flex items-center gap-2 text-sm text-green-200/90">
                      <span class="h-1.5 w-1.5 rounded-full" style="background: var(--tier)" aria-hidden="true" />
                      {v}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Workflow -->
  <section class="bg-green-900 text-paper">
    <div class="wrap-wide py-20 lg:py-28">
      <div class="ds-eyebrow" data-reveal>
        <span class="ds-eyebrow-dash ds-eyebrow-dash--signal"></span>
        <span class="ds-eyebrow-label ds-eyebrow-label--signal">Flusso operativo</span>
      </div>
      <h2 class="text-control max-w-[18ch]" data-reveal>Come rispondiamo a un allarme.</h2>
      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {
          flusso.map((s, i) => (
            <li class="relative ds-panel p-7 lg:p-8" data-reveal style={`--reveal-delay:${i * 110}ms`}>
              <span class="tnum font-display text-3xl font-bold text-green-400/80">{s.n}</span>
              <h3 class="mt-3 font-display text-lg font-bold tracking-tight">{s.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-green-200/90">{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand headline="Impianti sempre sorvegliati. Guasti risolti prima." />
</Base>

<style>
  .prose-green :global(p) {
    margin: 0;
  }
  .prose-green :global(p + p) {
    margin-top: 1rem;
  }
</style>
