---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ServizioBody from '../../components/ServizioBody.astro';
import heroImage from '../../assets/img/photos/costruzione-banzi-panoramica.jpg';

const entry = await getEntry('servizi', 'costruzioni');
if (!entry) throw new Error('servizi/costruzioni.md missing');

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: entry.data.titolo,
    description: entry.data.excerpt,
    provider: { '@type': 'Organization', name: 'Amon Energy S.r.l.' },
    areaServed: 'Centro-Sud Italia',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://amonenergy.it/' },
      { '@type': 'ListItem', position: 2, name: 'Servizi', item: 'https://amonenergy.it/servizi/' },
      { '@type': 'ListItem', position: 3, name: entry.data.titolo, item: 'https://amonenergy.it/servizi/costruzioni/' },
    ],
  },
];
---

<Base title={entry.data.titolo} description={entry.data.excerpt} structuredData={structuredData}>
  <ServizioBody
    entry={entry}
    heroImage={heroImage}
    heroImageAlt="Cantiere di una stazione elettrica AT/MT in costruzione: campate di sbarre e isolatori durante il montaggio"
  />
</Base>
