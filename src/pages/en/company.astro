---
// Gemella inglese di src/pages/azienda.astro. Vedi quella pagina per i
// commenti di dettaglio; qui solo le note sulla traduzione.
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CoverageMap from '../../components/CoverageMap.astro';
import StatBar from '../../components/StatBar.astro';
import ClientMarquee from '../../components/ClientMarquee.astro';
import CtaBand from '../../components/CtaBand.astro';
import storiaImg from '../../assets/img/photos/tecnico-fotovoltaico.jpg';
import vanImg from '../../assets/img/photos/van-laboratorio-aperto.jpg';
import heroAzienda from '../../assets/img/photos/azienda-hero-substation.jpg';

const azienda = await getEntry('pagine', 'en/azienda');
if (!azienda || azienda.data.pagina !== 'azienda') throw new Error('pagine/en/azienda.yaml missing or malformed');
const { eyebrow, h1, storia, missione, raggioAzione, strumentazione, marqueeTitolo } = azienda.data;

// Stessi numeri operativi della home inglese, per lo stesso motivo della
// gemella italiana: unica fonte, niente copie che potrebbero disallinearsi.
const home = await getEntry('pagine', 'en/home');
if (!home || home.data.pagina !== 'home') throw new Error('pagine/en/home.yaml missing or malformed');
const { statbar } = home.data;
---

<Base
  title="Company"
  description="Amon Energy: over twenty years of experience in HV/MV and renewable electrical plants across Central-Southern Italy, from a single site in Puglia."
>
  <PageHero
    eyebrow={eyebrow}
    h1={h1}
    image={heroAzienda}
    imageAlt="Equipment of an HV/MV electrical substation backlit, at sunset"
  />

  <section class="wrap-wide grid items-center gap-12 py-20 lg:grid-cols-2 lg:gap-16 lg:py-28">
    <div data-reveal>
      <div class="ds-eyebrow">
        <span class="ds-eyebrow-dash"></span>
        <span class="ds-eyebrow-label">Our story</span>
      </div>
      <p class="measure text-lg leading-relaxed text-ink/90">{storia}</p>
    </div>
    <figure class="overflow-hidden rounded-[var(--radius-card)] border border-navy-100 shadow-[var(--shadow-md)]" data-reveal style="--reveal-delay:120ms">
      <Image
        src={storiaImg}
        alt="Amon Energy technician taking an instrumental measurement on a solar plant"
        class="aspect-[4/5] w-full object-cover"
        widths={[500, 800, 1100]}
        sizes="(min-width: 1024px) 46vw, 100vw"
      />
    </figure>
  </section>

  <section class="bg-navy-950 text-paper">
    <div class="wrap-wide py-20 lg:py-28">
      <div class="ds-eyebrow" data-reveal>
        <span class="ds-eyebrow-dash"></span>
        <span class="ds-eyebrow-label">Our mission</span>
      </div>
      <p class="max-w-[24ch] text-control text-paper" data-reveal style="--reveal-delay:80ms">
        Alongside energy producers, at every stage of a plant's life.
      </p>
      <p class="measure mt-6 text-lg leading-relaxed text-paper/80" data-reveal style="--reveal-delay:160ms">
        {missione}
      </p>
    </div>
  </section>

  <StatBar items={statbar} nota="Amon Energy's operational figures" />

  <section class="wrap-wide grid items-center gap-12 py-20 lg:grid-cols-2 lg:gap-16 lg:py-28">
    <div data-reveal>
      <div class="ds-eyebrow">
        <span class="ds-eyebrow-dash"></span>
        <span class="ds-eyebrow-label">Response time</span>
      </div>
      <p class="measure text-lg leading-relaxed text-ink/90">{raggioAzione}</p>
    </div>
    <div class="relative" data-reveal style="--reveal-delay:120ms">
      <CoverageMap lingua="en" />
    </div>
  </section>

  <section class="bg-navy-100">
    <div class="wrap-wide py-20 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
        <div data-reveal>
          <div class="ds-eyebrow">
            <span class="ds-eyebrow-dash ds-eyebrow-dash--leaf"></span>
            <span class="ds-eyebrow-label ds-eyebrow-label--leaf">Instrumentation</span>
          </div>
          <h2 class="text-headline">Our technical equipment.</h2>
          <p class="measure mt-4 text-ink/70">
            Every device is certified and calibrated: technical specificity is our badge of trust.
          </p>
          <div class="mt-8 flex flex-wrap gap-2.5">
            {
              strumentazione.map((s) => (
                <span class="rounded-full border border-navy-900/12 bg-paper/80 px-4 py-2 font-display text-sm font-medium text-navy-900 shadow-[var(--shadow-sm)] backdrop-blur">
                  {s}
                </span>
              ))
            }
          </div>
        </div>
        <figure class="overflow-hidden rounded-[var(--radius-card)] border border-navy-900/10 shadow-[var(--shadow-md)]" data-reveal style="--reveal-delay:120ms">
          <Image
            src={vanImg}
            alt="Amon Energy's mobile lab with test instrumentation on board, in the field during a call-out"
            class="w-full object-cover"
            widths={[400, 800]}
            sizes="(min-width: 1024px) 46vw, 100vw"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- Roster clienti: stesso id="clienti" della gemella italiana, così un
       eventuale link diretto all'ancora funziona su entrambe le lingue. -->
  <div id="clienti">
    <ClientMarquee titolo={marqueeTitolo} />
  </div>

  <CtaBand headline="Want to know if we can help with your plant?" lingua="en" />
</Base>
