---
// Gemella inglese di src/pages/index.astro: stessi componenti, stesso
// ordine, contenuto dalla collection `en`. Vedi quella pagina per i
// commenti di dettaglio sulle scelte di layout — qui restano solo quelli
// che riguardano la traduzione.
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ControlPillar from '../../components/ControlPillar.astro';
import StatBar from '../../components/StatBar.astro';
import ClientMarquee from '../../components/ClientMarquee.astro';
import CtaBand from '../../components/CtaBand.astro';
import CoverageMap from '../../components/CoverageMap.astro';
import { contatti } from '../../data/contatti.ts';
import { fotoProgetto } from '../../lib/progetti.ts';

const home = await getEntry('pagine', 'en/home');
if (!home || home.data.pagina !== 'home') throw new Error('pagine/en/home.yaml missing or malformed');
const { hero, chiSiamoBreve, controllo, statbar, percheAmon, marqueeTitolo } = home.data;

const servizi = (await getCollection('servizi', (v) => v.id.startsWith('en/'))).sort(
  (a, b) => a.data.ordine - b.data.ordine,
);
const serviziAnchor: Record<string, string> = {
  'laboratorio-mobile': '/en/services/#ingegneria-elettrica',
  'verifiche-strumentali': '/en/services/#ingegneria-elettrica',
  'monitoraggio-e-controllo': '/en/services/#controllo-e-monitoraggio',
  costruzioni: '/en/services/#costruzione-e-gestione',
  'gestione-e-manutenzione': '/en/services/#costruzione-e-gestione',
};
// Primi tre progetti con una foto, come nella home italiana.
const progettiPreview = (await getCollection('progetti'))
  .sort((a, b) => a.data.ordine - b.data.ordine)
  // Traduzioni con fallback all'italiano, stessa regola di ProjectSlider.astro:
  // i campi *En sono opzionali, e queste card della home inglese leggevano
  // finora sempre e solo i campi italiani (titolo, tipologia, immagineAlt).
  .map((p) => {
    const titolo = p.data.titoloEn ?? p.data.titolo;
    const altCopertina = p.data.immagineAltEn ?? p.data.immagineAlt;
    return {
      ...p,
      data: { ...p.data, titolo, tipologia: p.data.tipologiaEn ?? p.data.tipologia },
      copertina: fotoProgetto(p.data, { titolo, altCopertina, lingua: 'en' })[0],
    };
  })
  .filter((p) => p.copertina)
  .slice(0, 3);
---

<Base
  title="HV/MV and renewables in Central-Southern Italy"
  description="Amon Energy: construction, instrumental testing, fault-finding and 24/7 monitoring of wind and solar plants in Central-Southern Italy."
>
  <Hero
    eyebrow={hero.eyebrow}
    h1={hero.h1}
    sub={hero.sub}
    ctaPrimaria={hero.ctaPrimaria}
    ctaPrimariaHref={contatti.telefonoHref}
    ctaSecondaria={hero.ctaSecondaria}
    ctaSecondariaHref="/en/services/"
    lingua="en"
  />

  <section class="wrap-wide py-20 lg:py-28">
    <div class="grid items-start gap-12 lg:grid-cols-[1.4fr_0.6fr] lg:gap-16">
      <div data-reveal>
        <div class="ds-eyebrow">
          <span class="ds-eyebrow-dash"></span>
          <h2 class="ds-eyebrow-label">About us</h2>
        </div>
        <p class="measure text-lead text-ink/90">{chiSiamoBreve.testo}</p>
        <a
          href={chiSiamoBreve.link}
          class="group mt-7 inline-flex min-h-11 items-center gap-2 font-semibold text-navy-900 transition-colors hover:text-navy-700"
        >
          See our services
          <Icon name="fa6-solid:arrow-right" class="text-xs transition-transform duration-300 group-hover:translate-x-1" style="transition-timing-function: var(--ease-signature);" />
        </a>

        <div class="mt-12 grid gap-x-8 gap-y-8 border-t border-navy-100 pt-10 sm:grid-cols-3">
          {
            percheAmon.map((p, i) => (
              <div data-reveal style={`--reveal-delay:${i * 90}ms`}>
                <span class="tnum font-display text-small font-semibold text-green-600">0{i + 1}</span>
                <h3 class="text-title mt-2.5 text-ink">{p.titolo}</h3>
                <p class="text-small mt-2 text-ink/70">{p.testo}</p>
              </div>
            ))
          }
        </div>
      </div>
      <div class="relative lg:sticky lg:top-32" data-reveal style="--reveal-delay:120ms">
        <CoverageMap lingua="en" />
      </div>
    </div>
  </section>

  {
    controllo && (
      <ControlPillar
        eyebrow={controllo.eyebrow}
        titolo={controllo.titolo}
        testo={controllo.testo}
        href="/en/services/#controllo-e-monitoraggio"
        lingua="en"
      />
    )
  }

  <section class="wrap-wide py-20 lg:py-28">
    <div class="ds-eyebrow" data-reveal>
      <span class="ds-eyebrow-dash"></span>
      <span class="ds-eyebrow-label">What we do</span>
    </div>
    <div class="mb-12 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div>
        <h2 class="text-headline max-w-[22ch]">A plant has many stages. We know them all.</h2>
        <p class="measure text-body mt-3 text-ink/70">
          Construction, instrumental testing, fault-finding, monitoring and automation: the same
          team follows the plant through every stage.
        </p>
      </div>
      <a href="/en/services/" class="hidden shrink-0 font-semibold text-navy-900 hover:text-navy-700 sm:inline-flex">
        All services →
      </a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {
        servizi.map((s, i) => (
          <div data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <ServiceCard
              titolo={s.data.titolo}
              excerpt={s.data.excerpt}
              icona={s.data.icona}
              href={serviziAnchor[s.id.slice(3)] ?? '/en/services/'}
              index={i + 1}
              accent="signal"
              elevated
              ctaLabel="Learn more"
            />
          </div>
        ))
      }
    </div>
    <a href="/en/services/" class="mt-8 inline-flex min-h-11 items-center font-semibold text-navy-900 sm:hidden">All services →</a>
  </section>

  <StatBar items={statbar} nota="Amon Energy's operational figures" />

  <section class="wrap-wide py-20 lg:py-28">
    <div class="mb-10 flex items-end justify-between gap-4">
      <div data-reveal>
        <div class="ds-eyebrow">
          <span class="ds-eyebrow-dash"></span>
          <span class="ds-eyebrow-label">Our work</span>
        </div>
        <h2 class="text-headline max-w-[22ch]">Electrical substations we have built.</h2>
      </div>
      <a href="/en/projects/" class="hidden shrink-0 font-semibold text-navy-900 hover:text-navy-700 sm:inline-flex">
        All projects →
      </a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {
        progettiPreview.map((p, i) => (
          <a href="/en/projects/" class="progetto-preview group block" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <div class="relative overflow-hidden rounded-[var(--radius-card)] border border-navy-100 shadow-[var(--shadow-sm)] transition-shadow duration-300 group-hover:shadow-[var(--shadow-lg)]" style="aspect-ratio: 16 / 11;">
              <Image
                src={p.copertina.src}
                alt={p.copertina.alt}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.05]"
                style="transition-timing-function: var(--ease-signature);"
                widths={[400, 800, 1200]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              />
              <span class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-navy-950/50 to-transparent"></span>
              {!/da confermare/i.test(p.data.kv) && <span class="ds-chip-kv absolute left-3 top-3">{p.data.kv}</span>}
            </div>
            <div class="mt-4">
              <h3 class="text-title h-[2lh] line-clamp-2 text-ink">{p.data.titolo}</h3>
              <p class="text-small mt-1 text-ink/70">{p.data.tipologia} · {p.data.provincia} province</p>
            </div>
          </a>
        ))
      }
    </div>
    <a href="/en/projects/" class="mt-8 inline-flex min-h-11 items-center font-semibold text-navy-900 sm:hidden">All projects →</a>
  </section>

  <ClientMarquee titolo={marqueeTitolo} lingua="en" />

  <CtaBand lingua="en" />
</Base>
