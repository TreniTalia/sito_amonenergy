---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactChannels from '../components/ContactChannels.astro';
import ContactMap from '../components/ContactMap.astro';
import { contatti } from '../data/contatti.ts';
import heroContatti from '../assets/img/photos/contatti-hero-pylon-notte.jpg';

const pagina = await getEntry('pagine', 'contatti');
if (!pagina || pagina.data.pagina !== 'contatti') throw new Error('pagine/contatti.yaml missing or malformed');
const { h1, sub, orari } = pagina.data;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://amonenergy.it/' },
    { '@type': 'ListItem', position: 2, name: 'Contatti', item: 'https://amonenergy.it/contatti/' },
  ],
};
---

<Base
  title="Contatti"
  description={`Chiama ${contatti.telefono} o scrivi a ${contatti.email}: nessun modulo da compilare, rispondiamo direttamente.`}
  structuredData={[breadcrumb]}
>
  <PageHero
    eyebrow="Contatti"
    h1={h1}
    sub={sub}
    image={heroContatti}
    imageAlt="Traliccio dell'alta tensione di notte, sotto un cielo stellato"
  />

  <section class="wrap py-20 lg:py-28 grid gap-16 lg:grid-cols-2 lg:gap-20 items-start">
    <ContactChannels orari={orari} />
    <div>
      <ContactMap />
      <p class="mt-6 text-ink/75 font-semibold">{contatti.indirizzo}</p>
    </div>
  </section>
</Base>
