---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ControlPillar from '../components/ControlPillar.astro';
import StatBar from '../components/StatBar.astro';
import ClientMarquee from '../components/ClientMarquee.astro';
import CtaBand from '../components/CtaBand.astro';
import CoverageMap from '../components/CoverageMap.astro';
import { contatti } from '../data/contatti.ts';

const home = await getEntry('pagine', 'home');
if (!home || home.data.pagina !== 'home') throw new Error('pagine/home.yaml missing or malformed');
const { hero, chiSiamoBreve, controllo, statbar, percheAmon, marqueeTitolo } = home.data;

const servizi = (await getCollection('servizi')).sort((a, b) => a.data.ordine - b.data.ordine);
const serviziAnchor: Record<string, string> = {
  'laboratorio-mobile': '/servizi/#ingegneria-elettrica',
  'verifiche-strumentali': '/servizi/#ingegneria-elettrica',
  'monitoraggio-e-controllo': '/servizi/#controllo-e-monitoraggio',
  costruzioni: '/servizi/#costruzione-e-gestione',
  'gestione-e-manutenzione': '/servizi/#costruzione-e-gestione',
};
const progettiPreview = (await getCollection('progetti'))
  .sort((a, b) => a.data.ordine - b.data.ordine)
  .slice(0, 3);
---

<Base
  title="Impianti elettrici AT/MT/BT e rinnovabili nel Centro-Sud Italia"
  description="Amon Energy: costruzione, verifiche strumentali, ricerca guasti e monitoraggio 24/7 di impianti eolici e fotovoltaici in Centro-Sud Italia."
>
  <Hero
    eyebrow={hero.eyebrow}
    h1={hero.h1}
    sub={hero.sub}
    ctaPrimaria={hero.ctaPrimaria}
    ctaPrimariaHref={contatti.telefonoHref}
    ctaSecondaria={hero.ctaSecondaria}
    ctaSecondariaHref="/servizi/"
  />

  <!-- Chi siamo + copertura. La fascia "Perché Amon" (percheAmon) non è più
       una sezione a sé: i tre punti diventano una riga compatta qui, sotto la
       storia — la colonna di testo è più larga della mappa apposta, perché è
       lei il blocco che deve dominare. -->
  <section class="wrap-wide py-20 lg:py-28">
    <div class="grid items-start gap-12 lg:grid-cols-[1.4fr_0.6fr] lg:gap-16">
      <div data-reveal>
        <div class="ds-eyebrow">
          <span class="ds-eyebrow-dash"></span>
          <span class="ds-eyebrow-label">Chi siamo</span>
        </div>
        <p class="measure text-xl leading-relaxed text-ink/90">{chiSiamoBreve.testo}</p>
        <a
          href={chiSiamoBreve.link}
          class="group mt-7 inline-flex items-center gap-2 font-semibold text-navy-900 transition-colors hover:text-navy-700"
        >
          Scopri i servizi
          <Icon name="fa6-solid:arrow-right" class="text-xs transition-transform duration-300 group-hover:translate-x-1" style="transition-timing-function: var(--ease-signature);" />
        </a>

        <div class="mt-12 grid gap-x-8 gap-y-8 border-t border-navy-100 pt-10 sm:grid-cols-3">
          {
            percheAmon.map((p, i) => (
              <div data-reveal style={`--reveal-delay:${i * 90}ms`}>
                <span class="tnum font-display text-sm font-semibold text-green-500">0{i + 1}</span>
                <h3 class="mt-2.5 font-display text-lg font-bold tracking-tight text-ink">{p.titolo}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink/70">{p.testo}</p>
              </div>
            ))
          }
        </div>
      </div>
      <div class="relative lg:sticky lg:top-32" data-reveal style="--reveal-delay:120ms">
        <CoverageMap />
      </div>
    </div>
  </section>

  <!-- Mondo del controllo: RCS + CCI -->
  {
    controllo && (
      <ControlPillar eyebrow={controllo.eyebrow} titolo={controllo.titolo} testo={controllo.testo} />
    )
  }

  <!-- Servizi -->
  <section class="wrap-wide py-20 lg:py-28">
    <div class="ds-eyebrow" data-reveal>
      <span class="ds-eyebrow-dash ds-eyebrow-dash--leaf"></span>
      <span class="ds-eyebrow-label ds-eyebrow-label--leaf">Cosa facciamo</span>
    </div>
    <div class="mb-12 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div>
        <h2 class="text-headline max-w-[18ch]">Un impianto ha tante fasi. Le conosciamo tutte.</h2>
        <p class="measure mt-3 text-ink/70">
          Costruzione, verifiche strumentali, ricerca guasti, monitoraggio e automazione — la stessa
          squadra segue l'impianto in ogni fase.
        </p>
      </div>
      <a href="/servizi/" class="hidden shrink-0 font-semibold text-navy-900 hover:text-navy-700 sm:inline-flex">
        Tutti i servizi →
      </a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {
        servizi.map((s, i) => (
          <div data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <ServiceCard
              titolo={s.data.titolo}
              excerpt={s.data.excerpt}
              icona={s.data.icona}
              href={serviziAnchor[s.id] ?? '/servizi/'}
              index={i + 1}
              accent="signal"
              elevated
            />
          </div>
        ))
      }
    </div>
    <a href="/servizi/" class="mt-8 inline-flex font-semibold text-navy-900 sm:hidden">Tutti i servizi →</a>
  </section>

  <StatBar items={statbar} nota="Numeri dell'operatività Amon Energy" />

  <!-- Realizzazioni -->
  <section class="wrap-wide py-20 lg:py-28">
    <div class="mb-10 flex items-end justify-between gap-4">
      <div data-reveal>
        <div class="ds-eyebrow">
          <span class="ds-eyebrow-dash"></span>
          <span class="ds-eyebrow-label">Realizzazioni</span>
        </div>
        <h2 class="text-headline">Stazioni elettriche che abbiamo costruito.</h2>
      </div>
      <a href="/lavori/" class="hidden shrink-0 font-semibold text-navy-900 hover:text-navy-700 sm:inline-flex">
        Tutti i progetti →
      </a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {
        progettiPreview.map((p, i) => (
          <a href="/lavori/" class="group block" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <div class="relative overflow-hidden rounded-[var(--radius-card)] border border-navy-100 shadow-[var(--shadow-sm)] transition-shadow duration-300 group-hover:shadow-[var(--shadow-lg)]" style="aspect-ratio: 16 / 11;">
              <Image
                src={p.data.immagine}
                alt={p.data.immagineAlt}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.05]"
                style="transition-timing-function: var(--ease-signature);"
                widths={[400, 800, 1200]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              />
              <span class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-navy-950/50 to-transparent"></span>
              <span class="ds-chip-kv absolute left-3 top-3">{p.data.kv}</span>
            </div>
            <div class="mt-4">
              <h3 class="font-display text-lg font-bold tracking-tight text-ink">{p.data.titolo}</h3>
              <p class="mt-1 text-sm text-ink/60">{p.data.tipologia} · prov. {p.data.provincia}</p>
            </div>
          </a>
        ))
      }
    </div>
    <a href="/lavori/" class="mt-8 inline-flex font-semibold text-navy-900 sm:hidden">Tutti i progetti →</a>
  </section>

  <ClientMarquee titolo={marqueeTitolo} />

  <CtaBand />
</Base>
