# Configurazione dello stack. Copia in .env per l'uso locale; in Portainer
# inserisci queste variabili nella sezione "Environment variables" dello stack.

# Porta HTTP pubblicata sull'host. Il reverse proxy che termina il TLS su
# amonenergy.it inoltra qui.
HTTP_PORT=8082

# Origine pubblica del sito, senza slash finale: deve essere l'host da cui il
# sito viene EFFETTIVAMENTE raggiunto, non il dominio finale desiderato.
#   - ambiente di test:  https://test.amonenergy.it
#   - produzione:        https://amonenergy.it
#
# Da questa il servizio cms-auth deriva la redirect_uri ($ALLOWED_ORIGIN/oauth/callback),
# che deve combaciare ESATTAMENTE con la "Authorization callback URL" della OAuth
# App su GitHub — e una OAuth App accetta un solo host, quindi cambiando questo
# valore va cambiata anche lei. È anche l'unico destinatario a cui viene
# consegnato il token OAuth.
ALLOWED_ORIGIN=https://test.amonenergy.it

# GitHub OAuth App: Settings -> Developer settings -> OAuth Apps -> New OAuth App.
# Il secret è visibile una volta sola al momento della generazione.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Tag delle immagini da tirare da GHCR. Lascia `latest` se usi il webhook
# Portainer; metti uno SHA di commit per inchiodare o tornare a una versione
# precedente (i tag per SHA li pubblica lo stesso workflow).
IMAGE_TAG=latest
